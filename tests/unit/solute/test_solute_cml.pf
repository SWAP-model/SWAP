! Unit tests for solute_cml_from_cmsy — Freundlich isotherm solver in solute_mod.
@test
subroutine test_cml_from_cmsy_linear_branch()
   use funit
   use iso_fortran_env, only: real64
   use solute_mod, only: solute_cml_from_cmsy
   real(real64) :: cml_lin, cml_nonlin, cml_exact
   ! frexp=1.0 -> linear branch: cml = cmsy/(theta+bdenskf) = 4.0/(0.3+0.5) = 5.0
   cml_exact = solute_cml_from_cmsy(4.0_real64, 0.3_real64, 0.5_real64, 1.0_real64, 1.0_real64, 0.0_real64)
   @assertEqual(5.0_real64, cml_exact, 1.0e-12_real64)
   ! frexp=1.0009 is just INSIDE the 0.001 threshold -> still linear -> still 5.0
   cml_lin = solute_cml_from_cmsy(4.0_real64, 0.3_real64, 0.5_real64, 1.0009_real64, 1.0_real64, 2.0_real64)
   @assertEqual(5.0_real64, cml_lin, 1.0e-12_real64)
   ! frexp=1.01 is OUTSIDE the threshold -> nonlinear iterate -> result differs from the linear value
   cml_nonlin = solute_cml_from_cmsy(4.0_real64, 0.3_real64, 0.5_real64, 1.01_real64, 1.0_real64, 2.0_real64)
   @assertTrue(abs(cml_nonlin - 5.0_real64) > 1.0e-6_real64)
   @assertTrue(cml_nonlin > 0.0_real64)
end subroutine test_cml_from_cmsy_linear_branch

@test
subroutine test_cml_from_cmsy_nonlinear_satisfies_fixedpoint()
   use funit
   use iso_fortran_env, only: real64
   use solute_mod, only: solute_cml_from_cmsy
   real(real64) :: cml, theta, bdenskf, frexp, cref, cmsy, residual
   theta = 0.25_real64; bdenskf = 1.2_real64; frexp = 0.7_real64
   cref = 1.0_real64;   cmsy = 3.0_real64
   cml = solute_cml_from_cmsy(cmsy, theta, bdenskf, frexp, cref, 1.0_real64)
   ! Converged cml must satisfy cml = cmsy / (theta + bdenskf*(cml/cref)**(frexp-1))
   residual = cml - cmsy/(theta + bdenskf*(cml/cref)**(frexp-1.0_real64))
   @assertEqual(0.0_real64, residual, 1.0e-3_real64)
   @assertTrue(cml > 0.0_real64)
end subroutine test_cml_from_cmsy_nonlinear_satisfies_fixedpoint
