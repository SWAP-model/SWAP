@test
subroutine test_soil_valid_passes()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%swsophy = 0
   s%swhyst  = 0
   s%swinco  = 1
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_soil_swhyst_out_of_enum_fails()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%swhyst = 5
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_swinco_invalid_fails()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%swinco = 0
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_negative_pondmx_fails()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%swinco = 1
   s%pondmx = -0.5d0
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_discretization_swdiscrvert_zero_validates_clean()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   ! All defaults — swdiscrvert=0; validator skips the body.
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_soil_discretization_swdiscrvert_one_minimal_valid()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%discretization%swdiscrvert = 1
   s%discretization%numnodnew   = 3
   allocate(s%discretization%dznew(3))
   s%discretization%dznew = [10.0d0, 10.0d0, 10.0d0]
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_soil_discretization_swdiscrvert_one_dznew_size_mismatch()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%discretization%swdiscrvert = 1
   s%discretization%numnodnew   = 4
   allocate(s%discretization%dznew(3))
   s%discretization%dznew = [10.0d0, 10.0d0, 10.0d0]
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_frost_swfrost_zero_validates_clean()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%frost%swfrost = 0
   ! tfroststa/tfrostend left at defaults; with swfrost=0 they're not bound-checked.
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_soil_frost_swfrost_one_tfrostend_above_tfroststa()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%frost%swfrost   = 1
   s%frost%tfroststa = -1.0d0
   s%frost%tfrostend =  0.0d0   ! end >= start — cross-field violation
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_cofani_out_of_range()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   allocate(s%cofani(2))
   s%cofani = [1.0d0, 1.0d6]   ! 1e6 way above 100 ceiling
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_nrstaring_out_of_range()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%nrstaring = 99   ! must be 0..6
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_initial_fields_roundtrip()
   use funit
   use soil_config_mod
   type(soil_config_t) :: c
   c%initial%swirrigate = 1
   c%initial%ssnow      = 0.5d0
   c%initial%slw        = 0.1d0
   c%initial%pond       = 0.2d0
   c%initial%ldwet      = 7.0d0
   c%initial%dt         = 1.0d-7
   c%initial%atmin7     = [1.0d0, 2.0d0, 3.0d0, 4.0d0, 5.0d0, 6.0d0, 7.0d0]
   c%initial%h_file     = "case.ini.h.csv"
   c%initial%tsoil_file = "case.ini.tsoil.csv"
   c%initial%cml_file   = "case.ini.cml.csv"
   @assertEqual(1,                 c%initial%swirrigate)
   @assertEqual(0.5d0,             c%initial%ssnow,  1.0d-12)
   @assertEqual(7.0d0,             c%initial%atmin7(7), 1.0d-12)
   @assertEqual("case.ini.h.csv",  c%initial%h_file)
end subroutine

@test
subroutine test_soil_initial_dt_too_small_fails()
   use funit
   use soil_config_mod
   use error_mod
   type(soil_config_t)        :: c
   type(error_collection_t)   :: errors
   c%initial%dt = 1.0d-15  ! below 1e-12 lower bound
   call c%initial%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_initial_atmin7_out_of_range_fails()
   use funit
   use soil_config_mod
   use error_mod
   type(soil_config_t)        :: c
   type(error_collection_t)   :: errors
   c%initial%atmin7(3) = 100.0d0   ! above 50.0 upper bound
   call c%initial%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_initial_skipped_when_swinco_not_3()
   use funit
   use soil_config_mod
   use error_mod
   type(soil_config_t)        :: c
   type(error_collection_t)   :: errors
   ! Default swinco is 0 → soil_config_validate should skip the
   ! soil.initial validator entirely. Defaults like dt=0.0 must NOT trip
   ! the range check.
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_soil_initial_validates_when_swinco_3_with_valid_dt()
   use funit
   use soil_config_mod
   use error_mod
   type(soil_config_t)        :: c
   type(error_collection_t)   :: errors
   c%swinco       = 3
   c%initial%dt   = 0.5d0          ! within [1.0e-12, 1.0]
   c%initial%h_file = 'dummy.csv'  ! suppress any future cross-section gating
   call c%validate(errors)
   ! No errors from soil.initial range checks specifically.
   ! (Other validators may emit unrelated errors — we don't assert on those.)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_swap_config_swinco3_missing_h_file_fails()
   use funit
   use swap_config_mod
   use error_mod, only: error_collection_t, ERR_VALIDATION_REQUIRED
   type(swap_config_t)        :: c
   type(error_collection_t)   :: errors
   integer :: i
   logical :: found
   c%soil%swinco = 3
   ! h_file is unallocated by default → required-file error must fire.
   call c%validate(errors)
   @assertTrue(errors%has_errors())
   found = .false.
   do i = 1, errors%count()
      if (errors%items(i)%code == ERR_VALIDATION_REQUIRED) found = .true.
   end do
   @assertTrue(found)
end subroutine

@test
subroutine test_swap_config_swinco3_with_h_file_passes_init_check()
   use funit
   use swap_config_mod
   use error_mod, only: error_collection_t, ERR_VALIDATION_REQUIRED
   type(swap_config_t)        :: c
   type(error_collection_t)   :: errors
   integer :: i
   logical :: found_required
   c%soil%swinco = 3
   c%soil%initial%h_file = 'case.ini.h.csv'
   ! Other validators may emit unrelated errors (e.g. missing crops);
   ! we only assert that NO ERR_VALIDATION_REQUIRED for soil.initial.h_file fires.
   call c%validate(errors)
   found_required = .false.
   do i = 1, errors%count()
      if (errors%items(i)%code == ERR_VALIDATION_REQUIRED .and. &
          index(errors%items(i)%message, 'soil.initial.h_file') > 0) then
         found_required = .true.
      end if
   end do
   @assertFalse(found_required)
end subroutine
