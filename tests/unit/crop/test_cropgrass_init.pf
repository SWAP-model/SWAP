   cfg%swlossgrz    = 0
   cfg%swlossmow    = 0
   cfg%swcf         = 1
   cfg%swinter      = 0
   cfg%swrd         = 2
   cfg%swrdc        = 0
   cfg%nseqgrazmow  = 1
   allocate(cfg%seqgrazmow(1))
   cfg%seqgrazmow(1) = 2
   allocate(cfg%rdctb(4))
   cfg%rdctb = [0.0d0, 1.0d0, 1.0d0, 0.0d0]

   call cropgrass_init_from_config(cfg, 1)

   @assertEqual(0.7d0, alphacrit, 1.0d-12)
end subroutine test_cropgrass_init_swcompensate1_writes_alphacrit

@test
subroutine test_cropgrass_init_swharvest2_populates_dateharvest()
   ! When cfg%swharv=2, the dateharvest global must be populated.
   ! The exact t1900 values depend on yearmeteo (the current year at init
   ! time), which in a unit test is whatever variables module initialized it
   ! to (typically 0). We only assert the sentinel entry is set correctly:
   ! dateharvest(nmow+1) = tend + 1.0 (where tend is also a module global).
   ! We assert dateharvest(1) is finite (> -1e30) as a smoke test.
   use funit
   use cropgrass_init_mod, only: cropgrass_init_from_config
   use cropgrass_config_mod, only: cropgrass_config_t
   use variables, only: dateharvest, tend
   implicit none
   type(cropgrass_config_t) :: cfg
   integer :: nmow_val

   cfg%swharv       = 2
   cfg%nmow         = 3
   nmow_val         = 3
   allocate(cfg%mowing_dates(3))
   cfg%mowing_dates = [127.0d0, 149.0d0, 176.0d0]
   cfg%swoxygen     = 0
   cfg%swdrought    = 1
   cfg%swcompensate = 0
   cfg%swco2        = 0
   cfg%swlossgrz    = 0
   cfg%swlossmow    = 0
   cfg%swcf         = 1
   cfg%swinter      = 0
   cfg%swrd         = 2
   cfg%swrdc        = 0
   cfg%nseqgrazmow  = 1
   allocate(cfg%seqgrazmow(1))
   cfg%seqgrazmow(1) = 2
   allocate(cfg%rdctb(4))
   cfg%rdctb = [0.0d0, 1.0d0, 1.0d0, 0.0d0]

   ! Set tend to a known value so we can check the sentinel.
   tend = 1000.0d0

   call cropgrass_init_from_config(cfg, 1)

   ! Sentinel: dateharvest(nmow+1) = tend + 1.0
   @assertEqual(1001.0d0, dateharvest(nmow_val + 1), 1.0d-6)
   ! Entries 1..nmow must be finite (non-zero since DOY > 0).
   @assertTrue(dateharvest(1) > 0.0d0)
   @assertTrue(dateharvest(2) > 0.0d0)
   @assertTrue(dateharvest(3) > 0.0d0)
   ! Entries must be in ascending order (DOY 127 < 149 < 176 in same year).
   @assertTrue(dateharvest(2) > dateharvest(1))
   @assertTrue(dateharvest(3) > dateharvest(2))
end subroutine test_cropgrass_init_swharvest2_populates_dateharvest
