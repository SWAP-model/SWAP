@test
subroutine test_heat_config_temtoptab_default_unallocated()
   use funit
   use heat_config_mod, only: heat_config_t
   type(heat_config_t) :: cfg
   @assertFalse(allocated(cfg%temtoptab))
end subroutine

@test
subroutine test_heat_config_tembtab_default_unallocated()
   use funit
   use heat_config_mod, only: heat_config_t
   type(heat_config_t) :: cfg
   @assertFalse(allocated(cfg%tembtab))
end subroutine

@test
subroutine test_heat_config_table_2d_allocation()
   use funit
   use iso_fortran_env, only: real64
   use heat_config_mod, only: heat_config_t
   type(heat_config_t) :: cfg

   allocate(cfg%temtoptab(10, 2))
   allocate(cfg%tembtab(10, 2))
   cfg%temtoptab = 0.0_real64
   cfg%tembtab   = 0.0_real64

   @assertTrue(allocated(cfg%temtoptab))
   @assertTrue(allocated(cfg%tembtab))
   @assertEqual(10, size(cfg%temtoptab, 1))
   @assertEqual(2,  size(cfg%temtoptab, 2))
end subroutine
