@test
subroutine test_read_meteo_happy()
   use funit
   use tomlf, only: toml_table, toml_load
   use meteorology_config_mod
   use read_meteorology_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(meteorology_config_t)    :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/meteorology_minimal.toml')
   doc_ptr => doc
   call read_meteorology_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(52.0d0, c%lat, 1.0d-12)
   @assertEqual(10.0d0, c%alt, 1.0d-12)
   @assertEqual(0.25d0, c%angstroma, 1.0d-12)
end subroutine

@test
subroutine test_read_meteo_missing_section_is_silent()
   use funit
   use tomlf, only: toml_table, toml_load
   use meteorology_config_mod
   use read_meteorology_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(meteorology_config_t)    :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/general_minimal.toml')
   doc_ptr => doc
   call read_meteorology_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_read_meteo_defaults_when_et_absent()
   use funit
   use tomlf, only: toml_table, toml_load
   use meteorology_config_mod
   use read_meteorology_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(meteorology_config_t)    :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/simulation_minimal.toml')
   doc_ptr => doc
   call read_meteorology_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(0.0d0, c%lat, 1.0d-12)
end subroutine

@test
subroutine test_read_meteorology_evaporation_full()
   use funit
   use tomlf, only: toml_table, toml_load
   use meteorology_config_mod
   use read_meteorology_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(meteorology_config_t)    :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/meteorology_evaporation_full.toml')
   doc_ptr => doc
   call read_meteorology_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1,      c%evaporation%swcfbs)
   @assertEqual(1.2d0,  c%evaporation%cfbs,     1.0d-12)
   @assertEqual(0.40d0, c%evaporation%cofredbl, 1.0d-12)
   @assertEqual(0.55d0, c%evaporation%cofredbo, 1.0d-12)
end subroutine

@test
subroutine test_read_meteorology_snow_swsnow_zero()
   use funit
   use tomlf, only: toml_table, toml_load
   use meteorology_config_mod
   use read_meteorology_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(meteorology_config_t)    :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/meteorology_snow_swsnow_zero.toml')
   doc_ptr => doc
   call read_meteorology_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(0,     c%snow%swsnow)
   @assertEqual(0.0d0, c%snow%snowcoef, 1.0d-12)
   @assertEqual(0.0d0, c%snow%teprrain, 1.0d-12)
   @assertEqual(0.0d0, c%snow%teprsnow, 1.0d-12)
end subroutine

@test
subroutine test_read_meteorology_rainfile_optional()
   use funit
   use tomlf, only: toml_table, toml_load
   use meteorology_config_mod
   use read_meteorology_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(meteorology_config_t)    :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/meteorology_rainfile.toml')
   doc_ptr => doc
   call read_meteorology_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertTrue(allocated(c%rainfile))
   @assertEqual('wagrain', c%rainfile)
end subroutine
