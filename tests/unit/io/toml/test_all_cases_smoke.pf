! Smoke tests: TOML projects for all 6 swap cases load, validate, and
! finalize without fatal errors. Full field parity for cases 2-6 is
! deferred to the pre-Phase-4 follow-on step.

@test
subroutine test_grassgrowth_loads_clean()
   use funit
   use swap_config_mod
   use load_swap_config_mod
   use error_mod
   type(swap_config_t)      :: c
   type(error_collection_t) :: e
   call load_swap_config('tests/regression/cases/grassgrowth/toml/swap.toml', c, e)
   call c%validate(e)
   call c%finalize(e)
   @assertFalse(e%has_fatals())
end subroutine

