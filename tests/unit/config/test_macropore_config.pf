@test
subroutine test_macropore_default_swmacro_zero_validates_clean()
   use funit
   use error_mod
   use macropore_config_mod
   type(macropore_config_t) :: c
   type(error_collection_t) :: errors
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_macropore_swmacro_one_minimal_valid()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use macropore_config_mod
   type(macropore_config_t) :: c
   type(error_collection_t) :: errors
   c%swmacro  = 1
   c%z_ah     = -26.0_real64
   c%z_ic     = -100.0_real64
   c%z_st     = -220.0_real64
   c%vlmpstss = 0.04_real64
   c%ppicss   = 0.5_real64
   c%numsbdm  = 4
   c%powm     = 1.0_real64
   c%rzah     = 0.0_real64
   c%spoint   = 1.0_real64
   c%swpowm   = 0
   c%dipomi   = 10.0_real64
   c%dipoma   = 50.0_real64
   allocate(c%swsoilshr(1));   c%swsoilshr   = 1
   allocate(c%swshrinp(1));    c%swshrinp    = 2
   allocate(c%thetcrmp(1));    c%thetcrmp    = 0.385_real64
   allocate(c%geomfac(1));     c%geomfac     = 3.0_real64
   allocate(c%shrpar(1, 5));   c%shrpar      = 0.0_real64
   allocate(c%swsorp(1));      c%swsorp      = 1
   allocate(c%sorpfacparl(1)); c%sorpfacparl = 0.33_real64
   allocate(c%sorpmax(1));     c%sorpmax     = 0.3_real64
   allocate(c%sorpalfa(1));    c%sorpalfa    = 0.5_real64
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_macropore_swmacro_invalid_enum()
   use funit
   use error_mod
   use macropore_config_mod
   type(macropore_config_t) :: c
   type(error_collection_t) :: errors
   c%swmacro = 9
   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

