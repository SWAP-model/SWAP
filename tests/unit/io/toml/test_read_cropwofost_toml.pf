@test
subroutine test_read_cropwofost_empty_table()
   use funit
   use tomlf, only: toml_table, toml_load
   use cropwofost_config_mod
   use read_cropwofost_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(cropwofost_config_t)             :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/cropwofost_empty_dtsmtb.toml')
   doc_ptr => doc
   call read_cropwofost_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertTrue(allocated(c%phenology%dtsmtb))
   @assertEqual(0, size(c%phenology%dtsmtb, 1))
end subroutine

@test
subroutine test_read_cropwofost_oversized_table_passes_reader()
   use funit
   use tomlf, only: toml_table, toml_load
   use cropwofost_config_mod
   use read_cropwofost_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(cropwofost_config_t)             :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/cropwofost_oversized_dtsmtb.toml')
   doc_ptr => doc
   call read_cropwofost_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertTrue(allocated(c%phenology%dtsmtb))
   @assertEqual(20, size(c%phenology%dtsmtb, 1))

   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_read_cropwofost_gashtb_six_columns()
   use funit
   use tomlf, only: toml_table, toml_load
   use cropwofost_config_mod
   use read_cropwofost_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(cropwofost_config_t)             :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/cropwofost_gashtb.toml')
   doc_ptr => doc
   call read_cropwofost_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertTrue(allocated(c%interception%gashtb))
   @assertEqual(2, size(c%interception%gashtb, 1))
   @assertEqual(6, size(c%interception%gashtb, 2))
   @assertEqual(0.5d0, c%interception%gashtb(1, 4), 1.0d-12)
end subroutine
