@test
subroutine test_wofost_management_valid_passes()
   use funit
   use error_mod
   use cropwofost_config_mod
   type(wofost_management_t) :: s
   type(error_collection_t)  :: errors
   s%fraharlosorm_lv     = 0.2d0
   s%fraharlosorm_st     = 0.1d0
   s%fraharlosorm_so     = 0.01d0
   s%fradeceasedlvtosoil = 0.3d0
   s%swpotrelmf          = 2
   s%relmf               = 0.9d0
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_wofost_management_swpotrelmf_invalid_fails()
   use funit
   use error_mod
   use cropwofost_config_mod
   type(wofost_management_t) :: s
   type(error_collection_t)  :: errors
   s%swpotrelmf = 0   ! must be 1 or 2
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_cropwofost_top_level_defaults_pass()
   use funit
   use error_mod
   use cropwofost_config_mod
   type(cropwofost_config_t) :: c
   type(error_collection_t)  :: errors
   ! Top-level: defaults set valid switches (all off), so no errors.
   c%harvest%swharv      = 0
   c%crop_factor%swcf    = 2
   c%crop_factor%albedo  = 0.19d0
   c%root%swrd           = 2
   c%root%rdi            = 10.0d0
   c%root%rri            = 1.2d0
   c%root%rdc            = 50.0d0
   c%root%swdmi2rd       = 1
   c%oxygen_stress%swoxygen   = 1
   c%oxygen_stress%swwrtnonox = 1
   c%oxygen_stress%aeratecrit = 0.5d0
   c%oxygen_stress%hlim1      = -10.0d0
   c%oxygen_stress%hlim2u     = -25.0d0
   c%oxygen_stress%hlim2l     = -25.0d0
   c%drought_stress%swdrought = 1
   c%drought_stress%hlim3h    = -300.0d0
   c%drought_stress%hlim3l    = -500.0d0
   c%drought_stress%hlim4     = -10000.0d0
   c%drought_stress%adcrh     = 0.5d0
   c%drought_stress%adcrl     = 0.1d0
   c%management%swpotrelmf    = 2
   c%management%relmf         = 0.9d0
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_cropwofost_top_level_rolls_up_errors()
   use funit
   use error_mod
   use cropwofost_config_mod
   type(cropwofost_config_t) :: c
   type(error_collection_t)  :: errors
   c%management%swpotrelmf  = 7   ! invalid
   c%harvest%dvsend         = 99.0d0  ! invalid
   call c%validate(errors)
   @assertTrue(errors%has_errors())
   @assertGreaterThanOrEqual(errors%count(), 2)
end subroutine
