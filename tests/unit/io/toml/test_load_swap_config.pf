@test
subroutine test_load_swap_config_loads_rotation_crp_files()
   ! End-to-end rotation loading: load_swap_config must not only parse the
   ! [[crop.rotation]] metadata but also load each referenced .crp file into
   ! the matching slot and set its rotation_loaded flag. Exercised on the
   ! runnable_model fixture (one type-1 maize rotation) so this is independent
   ! of the regression cases; per-case value parity is covered by the
   ! byte-identical regression suite, not here.
   use funit
   use error_mod, only: error_collection_t
   use swap_config_mod, only: swap_config_t
   use load_swap_config_mod, only: load_swap_config
   type(swap_config_t)      :: c
   type(error_collection_t) :: errors
   call load_swap_config('tests/unit/fixtures/runnable_model/swap.toml', c, errors)
   @assertFalse(errors%has_fatals())
   ! One rotation entry, loaded, typed as fixed-crop (type 1).
   @assertEqual(1, size(c%crop%rotation_loaded))
   @assertTrue(c%crop%rotation_loaded(1))
   @assertEqual(1, c%crop%rotation_type(1))
   ! The .crp file's content actually landed in the fixed-crop slot.
   @assertEqual(1,   c%crop%rotation_fixed(1)%idev)
   @assertEqual(168, c%crop%rotation_fixed(1)%lcc)
   @assertTrue(allocated(c%crop%rotation_fixed(1)%gctb))
end subroutine

@test
subroutine test_load_swap_config_dispatches_output_csv()
   ! Phase 4f Bucket B slot 8: confirm load_swap_config calls
   ! read_output_csv_toml and populates config%output_csv.
   use funit
   use swap_config_mod
   use load_swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/unit/io/toml/fixtures/swap_with_output_csv.toml', &
                         config, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, config%output_csv%enabled)
   @assertEqual(0, config%output_csv%enabled_tz)
   @assertTrue(allocated(config%output_csv%inlist))
   @assertEqual('gwl,pond', config%output_csv%inlist)
   @assertTrue(allocated(config%output_csv%inlist_tz))
   @assertEqual('wc,h,conc', config%output_csv%inlist_tz)
end subroutine
