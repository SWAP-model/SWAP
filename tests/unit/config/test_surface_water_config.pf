@test
subroutine test_swsrf_one_validates_clean()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_two_swsec_one_validates_clean()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf  = 2
   s%swsec  = 1
   s%wlact  = -50.0d0
   s%osswlm = 1.0d0
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_two_swsec_two_minimal_valid()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf  = 2
   s%swsec  = 2
   s%wlact  = -77.0d0
   s%osswlm = 2.5d0
   s%nmper  = 2
   allocate(s%impend(2));  s%impend = [35430.0d0, 35444.0d0]
   allocate(s%swman(2));   s%swman  = [1, 1]
   allocate(s%wscap(2));   s%wscap  = [0.0d0, 0.0d0]
   allocate(s%wldip(2));   s%wldip  = [0.0d0, 0.0d0]
   allocate(s%intwl(2));   s%intwl  = [1, 1]
   s%swqhr  = 1
   s%sofcu  = 100.0d0
   allocate(s%hbweir(2));  s%hbweir = [-96.0d0, -45.0d0]
   allocate(s%alphaw(2));  s%alphaw = [1.7d0, 1.7d0]
   allocate(s%betaw(2));   s%betaw  = [1.5d0, 1.5d0]
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_invalid_enum()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf = 9
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_two_nmper_out_of_range()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf  = 2
   s%swsec  = 2
   s%wlact  = -10.0d0
   s%osswlm = 1.0d0
   s%nmper  = 0
   s%swqhr  = 1
   s%sofcu  = 100.0d0
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_two_swsec_two_missing_impend()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf  = 2
   s%swsec  = 2
   s%wlact  = -10.0d0
   s%osswlm = 1.0d0
   s%nmper  = 2
   ! impend deliberately not allocated
   allocate(s%swman(2));   s%swman  = [1, 1]
   allocate(s%wscap(2));   s%wscap  = [0.0d0, 0.0d0]
   allocate(s%wldip(2));   s%wldip  = [0.0d0, 0.0d0]
   allocate(s%intwl(2));   s%intwl  = [1, 1]
   s%swqhr  = 1
   s%sofcu  = 100.0d0
   allocate(s%hbweir(2));  s%hbweir = [-96.0d0, -45.0d0]
   allocate(s%alphaw(2));  s%alphaw = [1.7d0, 1.7d0]
   allocate(s%betaw(2));   s%betaw  = [1.5d0, 1.5d0]
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_two_swsec_two_array_size_mismatch()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf  = 2
   s%swsec  = 2
   s%wlact  = -10.0d0
   s%osswlm = 1.0d0
   s%nmper  = 2
   allocate(s%impend(2));  s%impend = [35430.0d0, 35444.0d0]
   allocate(s%swman(3));   s%swman  = [1, 1, 1]   ! size mismatch
   allocate(s%wscap(2));   s%wscap  = [0.0d0, 0.0d0]
   allocate(s%wldip(2));   s%wldip  = [0.0d0, 0.0d0]
   allocate(s%intwl(2));   s%intwl  = [1, 1]
   s%swqhr  = 1
   s%sofcu  = 100.0d0
   allocate(s%hbweir(2));  s%hbweir = [-96.0d0, -45.0d0]
   allocate(s%alphaw(2));  s%alphaw = [1.7d0, 1.7d0]
   allocate(s%betaw(2));   s%betaw  = [1.5d0, 1.5d0]
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_two_swsec_two_swman_invalid()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf  = 2
   s%swsec  = 2
   s%wlact  = -10.0d0
   s%osswlm = 1.0d0
   s%nmper  = 2
   allocate(s%impend(2));  s%impend = [35430.0d0, 35444.0d0]
   allocate(s%swman(2));   s%swman  = [1, 9]      ! 9 not in {1,2}
   allocate(s%wscap(2));   s%wscap  = [0.0d0, 0.0d0]
   allocate(s%wldip(2));   s%wldip  = [0.0d0, 0.0d0]
   allocate(s%intwl(2));   s%intwl  = [1, 1]
   s%swqhr  = 1
   s%sofcu  = 100.0d0
   allocate(s%hbweir(2));  s%hbweir = [-96.0d0, -45.0d0]
   allocate(s%alphaw(2));  s%alphaw = [1.7d0, 1.7d0]
   allocate(s%betaw(2));   s%betaw  = [1.5d0, 1.5d0]
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_two_swqhr_one_missing_hbweir()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf  = 2
   s%swsec  = 2
   s%wlact  = -10.0d0
   s%osswlm = 1.0d0
   s%nmper  = 2
   allocate(s%impend(2));  s%impend = [35430.0d0, 35444.0d0]
   allocate(s%swman(2));   s%swman  = [1, 1]
   allocate(s%wscap(2));   s%wscap  = [0.0d0, 0.0d0]
   allocate(s%wldip(2));   s%wldip  = [0.0d0, 0.0d0]
   allocate(s%intwl(2));   s%intwl  = [1, 1]
   s%swqhr  = 1
   s%sofcu  = 100.0d0
   ! hbweir deliberately not allocated
   allocate(s%alphaw(2));  s%alphaw = [1.7d0, 1.7d0]
   allocate(s%betaw(2));   s%betaw  = [1.5d0, 1.5d0]
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_one_skips_swsec_validation()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf = 1
   s%nmper = 999999    ! would be out-of-range under swsrf=2
   s%swsec = 99        ! would fail enum under swsrf=2
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine
