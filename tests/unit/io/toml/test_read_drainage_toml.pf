@test
subroutine test_read_drainage_happy()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(drainage_config_t)       :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/drainage_minimal.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, c%swdra)
   @assertEqual(1, c%dramet)
   @assertEqual(1, c%nrlevs)
   @assertEqual(-200.0d0, c%basegw, 1.0d-12)
end subroutine

@test
subroutine test_read_drainage_level_array()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(drainage_config_t)       :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/drainage_minimal.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, c, errors)

   @assertTrue(allocated(c%zbotdr))
   @assertEqual(1, size(c%zbotdr))
   @assertEqual(-80.0d0, c%zbotdr(1), 1.0d-12)
   @assertEqual(100.0d0, c%drares(1), 1.0d-12)
end subroutine

@test
subroutine test_read_drainage_missing_section_is_silent()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(drainage_config_t)       :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/general_minimal.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_read_drainage_follows_file_reference()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(drainage_config_t)               :: d
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/drainage_via_file.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, d, errors, base_path='tests/unit/io/toml/fixtures/')

   @assertFalse(errors%has_errors())
   @assertEqual(1, d%swdra)
   @assertEqual(1, d%dramet)
   @assertEqual(-200.0d0, d%basegw, 1.0d-12)
end subroutine

@test
subroutine test_read_dra_surface_runoff_full()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(drainage_config_t)       :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/drainage_surface_runoff_full.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(2, c%surface_runoff%swnrsrf)
   @assertEqual(1, c%surface_runoff%swtopnrsrf)
   @assertEqual(1, c%surface_runoff%swdivdinf)
   @assertEqual(1, c%surface_runoff%swtopdislay)
   @assertEqual(2, c%surface_runoff%numlevrapdra)
   @assertEqual(0.5d0,   c%surface_runoff%facdpthinf,   1.0d-12)
   @assertEqual(0.5d0,   c%surface_runoff%cofintfl,     1.0d-12)
   @assertEqual(1.0d0,   c%surface_runoff%expintfl,     1.0d-12)
   @assertEqual(4.8d0,   c%surface_runoff%geofac,       1.0d-12)
   @assertEqual(1.0d0,   c%surface_runoff%gwlconv,      1.0d-12)
   @assertEqual(0.25d0,  c%surface_runoff%ftopdislay,   1.0d-12)
   @assertEqual(30.0d0,  c%surface_runoff%rsurfdeep,    1.0d-12)
   @assertEqual(10.0d0,  c%surface_runoff%rsurfshallow, 1.0d-12)
   @assertEqual(1.5d0,   c%surface_runoff%rapdrareaexp, 1.0d-12)
   @assertEqual(100.0d0, c%surface_runoff%rapdraresref, 1.0d-12)
end subroutine

@test
subroutine test_read_dra_surface_runoff_missing_silent()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(drainage_config_t)       :: c
   type(error_collection_t)      :: errors

   ! drainage_minimal.toml has no [drainage.surface_runoff] block.
   call toml_load(doc, 'tests/unit/io/toml/fixtures/drainage_minimal.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   ! Defaults preserved.
   @assertEqual(0, c%surface_runoff%swnrsrf)
   @assertEqual(0, c%surface_runoff%swtopnrsrf)
   @assertEqual(0, c%surface_runoff%swdivdinf)
   @assertEqual(0, c%surface_runoff%swtopdislay)
   @assertEqual(0.0d0, c%surface_runoff%rsurfdeep,  1.0d-12)
   @assertEqual(0.0d0, c%surface_runoff%geofac,     1.0d-12)
end subroutine

@test
subroutine test_read_dra_surface_runoff_swnrsrf_zero_only()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(drainage_config_t)       :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/drainage_surface_runoff_off.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(0, c%surface_runoff%swnrsrf)
   @assertEqual(0.0d0, c%surface_runoff%rsurfdeep,    1.0d-12)
   @assertEqual(0.0d0, c%surface_runoff%rsurfshallow, 1.0d-12)
end subroutine

@test
subroutine test_drainage_levels_parses_extended_fields()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(drainage_config_t)       :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/drainage_levels_extended.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(2, size(c%gwlinf))
   @assertEqual(-1000.0d0, c%gwlinf(1), 1.0d-12)
   @assertEqual(-1000.0d0, c%gwlinf(2), 1.0d-12)
   @assertEqual(461.0d0,   c%rdrain(1), 1.0d-12)
   @assertEqual(296.0d0,   c%rdrain(2), 1.0d-12)
   @assertEqual(1000.0d0,  c%rinfi(1),  1.0d-12)
   @assertEqual(500.0d0,   c%rinfi(2),  1.0d-12)
   @assertEqual(1.0d0,     c%rentry(1), 1.0d-12)
   @assertEqual(5.0d0,     c%rexit(1),  1.0d-12)
   @assertEqual(100.0d0,   c%widthr(1), 1.0d-12)
   @assertEqual(50.0d0,    c%widthr(2), 1.0d-12)
   @assertEqual(0.66d0,    c%taludr(1), 1.0d-12)
   @assertEqual(1.00d0,    c%taludr(2), 1.0d-12)
end subroutine

@test
subroutine test_read_drainage_drfil_roundtrip()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(drainage_config_t)       :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/drainage_drfil.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertTrue(allocated(c%drfil))
   @assertEqual('myswap', c%drfil)
end subroutine

@test
subroutine test_read_drainage_drfil_default()
   use funit
   use tomlf, only: toml_table, toml_load
   use drainage_config_mod
   use read_drainage_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(drainage_config_t)       :: c
   type(error_collection_t)      :: errors

   ! drainage_minimal.toml has no drfil key -> default 'swap' applies
   call toml_load(doc, 'tests/unit/io/toml/fixtures/drainage_minimal.toml')
   doc_ptr => doc
   call read_drainage_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertTrue(allocated(c%drfil))
   @assertEqual('swap', c%drfil)
end subroutine
