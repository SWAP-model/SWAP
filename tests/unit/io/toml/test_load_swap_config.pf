@test
subroutine test_load_nonexistent_file_errors()
   use funit
   use swap_config_mod
   use load_swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('/this/path/does/not/exist.toml', config, errors)

   @assertTrue(errors%has_fatals())
end subroutine

@test
subroutine test_load_malformed_toml_errors()
   use funit
   use swap_config_mod
   use load_swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/unit/io/toml/fixtures/malformed.toml', config, errors)

   @assertTrue(errors%has_fatals())
   @assertEqual(ERR_PARSE_MALFORMED_TOML, errors%items(1)%code)
end subroutine

@test
subroutine test_load_swap_config_wires_optional_sections()
   ! Consolidated dispatch check (was 5 separate Phase-4d/4f "dispatches_X"
   ! tests). Confirms the top-level loader invokes each optional section reader
   ! and stores the result into the matching config slot. The per-field parsing
   ! is covered in depth by the dedicated test_read_*_toml suites, which call the
   ! readers directly; this only proves load_swap_config wires them in for
   ! sections that the runnable_model lifecycle fixture does not itself exercise.
   use funit
   use swap_config_mod
   use load_swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/unit/io/toml/fixtures/swap_with_bottom_boundary.toml', config, errors)
   @assertFalse(errors%has_errors())
   @assertEqual(4, config%bottom_boundary%swbotb)

   call errors%clear()
   call load_swap_config('tests/unit/io/toml/fixtures/swap_with_heat.toml', config, errors)
   @assertFalse(errors%has_errors())
   @assertEqual(1, config%heat%swhea)

   call errors%clear()
   call load_swap_config('tests/unit/io/toml/fixtures/swap_with_irrigation.toml', config, errors)
   @assertFalse(errors%has_errors())
   @assertEqual(1, config%irrigation%swirfix)

   call errors%clear()
   call load_swap_config('tests/unit/io/toml/fixtures/swap_with_solute.toml', config, errors)
   @assertFalse(errors%has_errors())
   @assertEqual(1, config%solute%swsolu)

   call errors%clear()
   call load_swap_config('tests/unit/io/toml/fixtures/swap_with_output_csv.toml', config, errors)
   @assertFalse(errors%has_errors())
   @assertEqual(1, config%output_csv%enabled)
   @assertEqual(0, config%output_csv%enabled_tz)
   @assertTrue(allocated(config%output_csv%inlist))
   @assertEqual('gwl,pond', config%output_csv%inlist)
   @assertTrue(allocated(config%output_csv%inlist_tz))
   @assertEqual('wc,h,conc', config%output_csv%inlist_tz)
end subroutine

@test
subroutine test_load_swap_config_loads_rotation_crp_files()
   ! End-to-end rotation loading: load_swap_config must not only parse the
   ! [[crop.rotation]] metadata but also load each referenced .crp file into
   ! the matching slot and set its rotation_loaded flag. Exercised on the
   ! runnable_model fixture (one type-1 maize rotation) so this is independent
   ! of the regression cases; per-case value parity is covered by the
   ! byte-identical regression suite, not here.
   use funit
   use error_mod, only: error_collection_t
   use swap_config_mod, only: swap_config_t
   use load_swap_config_mod, only: load_swap_config
   type(swap_config_t)      :: c
   type(error_collection_t) :: errors
   call load_swap_config('tests/unit/fixtures/runnable_model/swap.toml', c, errors)
   @assertFalse(errors%has_fatals())
   ! One rotation entry, loaded, typed as fixed-crop (type 1).
   @assertEqual(1, size(c%crop%rotation_loaded))
   @assertTrue(c%crop%rotation_loaded(1))
   @assertEqual(1, c%crop%rotation_type(1))
   ! The .crp file's content actually landed in the fixed-crop slot.
   @assertEqual(1,   c%crop%rotation_fixed(1)%idev)
   @assertEqual(168, c%crop%rotation_fixed(1)%lcc)
   @assertTrue(allocated(c%crop%rotation_fixed(1)%gctb))
end subroutine

