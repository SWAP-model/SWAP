@test
subroutine test_sched_dcslim_min_exceeds_max_fails()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use irrigation_config_mod
   type(irrigation_schedule_t) :: s
   type(error_collection_t)    :: errors
   s%schedule       = 1
   s%startirr_day   = 1
   s%startirr_month = 1
   s%endirr_day     = 1
   s%endirr_month   = 1
   s%tcs            = 1
   s%dcs            = 1
   s%dcslim         = 1
   s%irgdepmin      = 80.0_real64
   s%irgdepmax      = 10.0_real64
   allocate(s%trel_table(2, 2))
   s%trel_table = 0.5_real64
   allocate(s%di_table(2, 2))
   s%di_table = 0.0_real64
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_sched_tcs6_with_tcsfix1_fails()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use irrigation_config_mod
   type(irrigation_schedule_t) :: s
   type(error_collection_t)    :: errors
   s%schedule       = 1
   s%startirr_day   = 1
   s%startirr_month = 1
   s%endirr_day     = 1
   s%endirr_month   = 1
   s%tcs            = 6
   s%dcs            = 1
   s%tcsfix         = 1
   s%irgdayfix      = 7
   allocate(s%di_table(2, 2))
   s%di_table = 0.0_real64
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_irrigation_swssdi_one_accepted()
   ! ADR 0020 SS-B: swssdi=1 is a legitimate value (SSDI activated).
   ! Validation accepts it; the call-site gate (flSSDI) controls
   ! whether SSDI_irrigation actually runs at runtime.
   use funit
   use error_mod, only: error_collection_t
   use irrigation_config_mod, only: irrigation_config_t
   type(irrigation_config_t) :: c
   type(error_collection_t)  :: errors

   c%swssdi = 1
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine
