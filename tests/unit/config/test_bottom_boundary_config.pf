@test
subroutine test_bb_swbotb3_happy_path()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use bottom_boundary_config_mod
   type(bottom_boundary_config_t) :: c
   type(error_collection_t) :: errors
   c%swbotb  = 3
   c%shape   = 1.0_real64
   c%hdrain  = -100.0_real64
   c%rimlay  = 500.0_real64
   c%aqave   = -200.0_real64
   c%aqamp   = 50.0_real64
   c%aqper   = 365.0_real64
   c%aqtmax  = 180.0_real64
   c%sw3     = 1
   c%sw4     = 0
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

