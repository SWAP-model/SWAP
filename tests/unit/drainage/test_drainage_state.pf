! Lifecycle tests for drainage_state_t.
!
! The state type zero-initialises via component defaults. These tests
! verify that drainage_state_init (a) produces a fully-zero state even
! when fields were pre-populated, and (b) that reset_cumulative and
! reset_intermediate touch only their own groups.

@test
subroutine test_drainage_state_init_zeroes_populated_state()
   use funit
   use drainage_state_mod
   type(drainage_state_t) :: state

   state%nrlevs = 2
   state%qdrtot = 0.5d0
   state%pathdrain = '/tmp/drain'

   call drainage_state_init(state, 0, 0)

   @assertEqual(0, state%nrlevs)
   @assertEqual(0.0d0, state%qdrtot, 1.0d-12)
   @assertEqual("", trim(state%pathdrain))
end subroutine

@test
subroutine test_drainage_state_finalize_is_idempotent()
   use funit
   use drainage_state_mod
   type(drainage_state_t) :: state

   call drainage_state_init(state, 0, 0)
   call drainage_state_finalize(state)
   call drainage_state_finalize(state)

   @assertEqual(0, state%nrlevs)
end subroutine

@test
subroutine test_drainage_reset_cumulative_scoped()
   use funit
   use drainage_state_mod
   type(drainage_state_t) :: state

   call drainage_state_init(state, 0, 0)
   state%cqdra = 1.0d0          ! cumulative group
   state%iqdra = 2.0d0          ! intermediate group
   state%qdrtot = 3.0d0         ! neither

   call drainage_state_reset_cumulative(state)

   @assertEqual(0.0d0, state%cqdra, 1.0d-12)
   @assertEqual(2.0d0, state%iqdra, 1.0d-12)
   @assertEqual(3.0d0, state%qdrtot, 1.0d-12)
end subroutine

@test
subroutine test_drainage_reset_intermediate_scoped()
   use funit
   use drainage_state_mod
   type(drainage_state_t) :: state

   call drainage_state_init(state, 0, 0)
   state%cqdra = 1.0d0          ! cumulative group
   state%iqdra = 2.0d0          ! intermediate group
   state%qdrtot = 3.0d0         ! neither

   call drainage_state_reset_intermediate(state)

   @assertEqual(1.0d0, state%cqdra, 1.0d-12)
   @assertEqual(0.0d0, state%iqdra, 1.0d-12)
   @assertEqual(3.0d0, state%qdrtot, 1.0d-12)
end subroutine
