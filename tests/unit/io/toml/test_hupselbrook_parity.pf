! Phase 4a hupselbrook parity test — Option B (known-values).
!
! Asserts that the full TOML pipeline (load -> validate -> finalize ->
! adapter) produces a swap_state_t whose field values match hand-extracted
! references from the legacy .swp/.dra inputs.
!
! Expected values (hand-extracted from
!   tests/swap-cases/1.hupselbrook/swap_linux.swp.template
!   tests/swap-cases/1.hupselbrook/swap.dra
! dated 2026-04-24):
!
!   [general]
!     PROJECT  = "hupsel"
!     SWSCRE   = 0
!
!   [simulation]
!     TSTART   = 2002-01-01 -> 37255.0 days1900
!     TEND     = 2004-12-31 -> 38350.0 days1900
!     NPRINTDAY = 1
!     SWMONTH   = 1
!     PERIOD    = 1
!
!   [meteorology]
!     METFIL    = "283.met"
!     LAT       = 52.0
!     ALT       = 10.0
!     ALTW      = 10.0   (hupselbrook uses 10 m wind height, not the 2.0 default)
!     ANGSTROMA = 0.25
!     ANGSTROMB = 0.50
!     SWETR     = 0
!     SWDIVIDE  = 1
!
!   [drainage]
!     DRAMET   = 2    (Hooghoudt/Ernst formula)
!     SWDIVD   = 1
!     SWDISLAY = 0
!     NRLEVS   = 0    (dramet=2 has no level table; TOML sets nrlevs=0)
!
!   [soil]
!     SWSOPHY = 0
!     SWHYST  = 0
!     SWINCO  = 2
!     SWMACRO = 0
!     GWLI    = -75.0
!     PONDMX  = 0.2
!
!   [crop]
!     SWCROP = 1

@test
subroutine test_hupselbrook_general_parity()
   use funit
   use swap_config_mod
   use swap_state_mod
   use load_swap_config_mod
   use config_to_state_mod
   use error_mod

   type(swap_config_t)      :: config
   type(swap_state_t)       :: state
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   call swap_state_init(state, 1, 1)
   call config_to_state(config, state)

   @assertEqual("hupsel", trim(state%time%project))
   @assertEqual(0, state%time%swscre)
end subroutine

@test
subroutine test_hupselbrook_simulation_parity()
   use funit
   use swap_config_mod
   use swap_state_mod
   use load_swap_config_mod
   use config_to_state_mod
   use error_mod

   type(swap_config_t)      :: config
   type(swap_state_t)       :: state
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   call swap_state_init(state, 1, 1)
   call config_to_state(config, state)

   @assertEqual(37255.0d0, state%time%tstart, 1.0d-9)
   @assertEqual(38350.0d0, state%time%tend,   1.0d-9)
   @assertEqual(1, state%time%nprintday)
   @assertEqual(1, state%time%swmonth)
   @assertEqual(1, state%time%period)
end subroutine

@test
subroutine test_hupselbrook_meteorology_parity()
   use funit
   use swap_config_mod
   use swap_state_mod
   use load_swap_config_mod
   use config_to_state_mod
   use error_mod

   type(swap_config_t)      :: config
   type(swap_state_t)       :: state
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   call swap_state_init(state, 1, 1)
   call config_to_state(config, state)

   @assertEqual(52.0d0,  state%atm%lat,       1.0d-9)
   @assertEqual(10.0d0,  state%atm%alt,       1.0d-9)
   @assertEqual(10.0d0,  state%atm%altw,      1.0d-9)
   @assertEqual(0.25d0,  state%atm%angstroma, 1.0d-9)
   @assertEqual(0.50d0,  state%atm%angstromb, 1.0d-9)
   @assertEqual(0, state%atm%swetr)
   @assertEqual(1, state%atm%swdivide)
end subroutine

@test
subroutine test_hupselbrook_drainage_parity()
   use funit
   use swap_config_mod
   use swap_state_mod
   use load_swap_config_mod
   use config_to_state_mod
   use error_mod

   type(swap_config_t)      :: config
   type(swap_state_t)       :: state
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   call swap_state_init(state, 1, 1)
   call config_to_state(config, state)

   @assertEqual(2, state%drain%dramet)
   @assertEqual(1, state%drain%swdivd)
   @assertEqual(0, state%drain%swdislay)
   @assertEqual(0, state%drain%nrlevs)
end subroutine
