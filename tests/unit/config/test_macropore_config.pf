@test
subroutine test_macropore_shrpar_wrong_cols()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use macropore_config_mod
   type(macropore_config_t) :: c
   type(error_collection_t) :: errors
   c%swmacro  = 1
   c%z_ah     = -26.0_real64
   c%z_ic     = -100.0_real64
   c%z_st     = -220.0_real64
   c%vlmpstss = 0.04_real64
   c%ppicss   = 0.5_real64
   c%numsbdm  = 4
   c%powm     = 1.0_real64
   c%spoint   = 1.0_real64
   c%dipomi   = 10.0_real64
   c%dipoma   = 50.0_real64
   allocate(c%shrpar(2, 3))
   c%shrpar = 0.0_real64
   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_macropore_per_layer_array_size_zero()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use macropore_config_mod
   type(macropore_config_t) :: c
   type(error_collection_t) :: errors
   c%swmacro  = 1
   c%z_ah     = -26.0_real64
   c%z_ic     = -100.0_real64
   c%z_st     = -220.0_real64
   c%vlmpstss = 0.04_real64
   c%ppicss   = 0.5_real64
   c%numsbdm  = 4
   c%powm     = 1.0_real64
   c%spoint   = 1.0_real64
   c%dipomi   = 10.0_real64
   c%dipoma   = 50.0_real64
   allocate(c%swsoilshr(0))
   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_macropore_swmacro_zero_skips_scalar_validation()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use macropore_config_mod
   type(macropore_config_t) :: c
   type(error_collection_t) :: errors
   c%swmacro = 0
   c%z_ah    = 999.0_real64    ! would fail under swmacro=1
   c%numsbdm = 999              ! would fail under swmacro=1
   c%swpowm  = 9                ! would fail under swmacro=1
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine
