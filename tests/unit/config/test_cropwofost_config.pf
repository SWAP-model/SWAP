@test
subroutine test_wofost_phenology_dtsmtb_non_monotone_fails()
   use funit
   use error_mod
   use cropwofost_config_mod
   type(wofost_phenology_t) :: s
   type(error_collection_t) :: errors
   allocate(s%dtsmtb(3, 2))
   s%dtsmtb(1, :) = [0.0d0,  0.0d0]
   s%dtsmtb(2, :) = [0.0d0,  0.0d0]   ! duplicate x — fails monotonicity
   s%dtsmtb(3, :) = [13.0d0, 11.0d0]
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

