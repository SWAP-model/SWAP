@test
subroutine test_read_output_csv_happy()
   use funit
   use tomlf, only: toml_table, toml_load
   use output_csv_config_mod
   use read_output_csv_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(output_csv_config_t)     :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/output_csv_full.toml')
   doc_ptr => doc
   call read_output_csv_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, c%enabled)
   @assertEqual(0, c%enabled_tz)
   @assertTrue(allocated(c%inlist))
   @assertEqual('gwl,pond', c%inlist)
   @assertTrue(allocated(c%inlist_tz))
   @assertEqual('wc,h,conc', c%inlist_tz)
end subroutine

@test
subroutine test_read_output_csv_missing_section_is_silent()
   use funit
   use tomlf, only: toml_table, toml_load
   use output_csv_config_mod
   use read_output_csv_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(output_csv_config_t)     :: c
   type(error_collection_t)      :: errors

   ! general_minimal.toml has no [output] section -> silent, defaults apply
   call toml_load(doc, 'tests/unit/io/toml/fixtures/general_minimal.toml')
   doc_ptr => doc
   call read_output_csv_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, c%enabled)
   @assertEqual(0, c%enabled_tz)
end subroutine

@test
subroutine test_read_output_csv_defaults_when_csv_absent()
   use funit
   use tomlf, only: toml_table, toml_load
   use output_csv_config_mod
   use read_output_csv_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(output_csv_config_t)     :: c
   type(error_collection_t)      :: errors

   ! general_minimal.toml has no [output.csv] -> all defaults apply
   call toml_load(doc, 'tests/unit/io/toml/fixtures/general_minimal.toml')
   doc_ptr => doc
   call read_output_csv_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, c%enabled)
   @assertEqual(0, c%enabled_tz)
end subroutine

@test
subroutine test_read_output_csv_results_in_memory()
   use funit
   use tomlf,                    only: toml_table, toml_loads
   use output_csv_config_mod,    only: output_csv_config_t
   use read_output_csv_toml_mod, only: read_output_csv_toml
   use error_mod,                only: error_collection_t

   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(output_csv_config_t)             :: cfg
   type(error_collection_t)              :: errors
   character(len=*), parameter :: nl = new_line('a')
   character(len=*), parameter :: text = &
      '[output.csv]' // nl // 'enabled = 1' // nl // 'results_in_memory = 1' // nl

   call toml_loads(doc, text)
   doc_ptr => doc
   call read_output_csv_toml(doc_ptr, cfg, errors)

@assertFalse(errors%has_fatals())
@assertEqual(1, cfg%results_in_memory)
end subroutine test_read_output_csv_results_in_memory
