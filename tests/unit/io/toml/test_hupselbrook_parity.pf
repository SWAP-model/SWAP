@test
subroutine test_hupselbrook_parity_meteorology()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! Note: TOML pipeline only accepts CSV (ADR 0014). Compare basename only.
   @assertEqual('283', trim(config%meteo%metfile(1:index(config%meteo%metfile,'.')-1)))
   @assertEqual(52.0_real64,  config%meteo%lat,       1.0d-9)
   @assertEqual(10.0_real64,  config%meteo%alt,       1.0d-9)
   @assertEqual(10.0_real64,  config%meteo%altw,      1.0d-9)
   @assertEqual(0,            config%meteo%swetr)
   @assertEqual(1,            config%meteo%swdivide)
   @assertEqual(0,            config%meteo%swrain)
   @assertEqual(0.25_real64,  config%meteo%angstroma, 1.0d-9)
   @assertEqual(0.50_real64,  config%meteo%angstromb, 1.0d-9)
end subroutine

@test
