! Tests for error_mod%append.

@test
subroutine test_append_adds_one_item()
   use funit
   use error_mod
   type(error_collection_t) :: errors

   call errors%append(ERR_PARSE_MISSING_REQUIRED, &
                      "field 'foo' is required", "drainage.foo")

   @assertTrue(allocated(errors%items))
   @assertEqual(1, size(errors%items))
   @assertEqual(ERR_PARSE_MISSING_REQUIRED, errors%items(1)%code)
   @assertEqual("field 'foo' is required", errors%items(1)%message)
   @assertEqual("drainage.foo", errors%items(1)%context)
   @assertTrue(errors%items(1)%is_fatal)
end subroutine

@test
subroutine test_append_preserves_order()
   use funit
   use error_mod
   type(error_collection_t) :: errors

   call errors%append(ERR_PARSE_MISSING_REQUIRED, "first",  "a")
   call errors%append(ERR_VALIDATION_OUT_OF_RANGE, "second", "b")
   call errors%append(ERR_PARSE_TYPE_MISMATCH,     "third",  "c")

   @assertEqual(3, size(errors%items))
   @assertEqual("first",  errors%items(1)%message)
   @assertEqual("second", errors%items(2)%message)
   @assertEqual("third",  errors%items(3)%message)
end subroutine

@test
subroutine test_append_respects_is_fatal_argument()
   use funit
   use error_mod
   type(error_collection_t) :: errors

   call errors%append(ERR_FINALIZE_DERIVATION, "soft warning", "x", is_fatal=.false.)

   @assertFalse(errors%items(1)%is_fatal)
end subroutine

@test
subroutine test_append_defaults_to_fatal()
   use funit
   use error_mod
   type(error_collection_t) :: errors

   call errors%append(ERR_PARSE_MALFORMED_TOML, "bad token", "line 3")

   @assertTrue(errors%items(1)%is_fatal)
end subroutine

@test
subroutine test_has_errors_empty_is_false()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_has_errors_after_append_is_true()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   call errors%append(ERR_PARSE_TYPE_MISMATCH, "m", "c")
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_has_fatals_only_counts_fatal_items()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   call errors%append(ERR_FINALIZE_DERIVATION, "soft", "x", is_fatal=.false.)
   @assertTrue(errors%has_errors())
   @assertFalse(errors%has_fatals())
   call errors%append(ERR_PARSE_MISSING_REQUIRED, "hard", "y")
   @assertTrue(errors%has_fatals())
end subroutine

@test
subroutine test_count_matches_appends()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   @assertEqual(0, errors%count())
   call errors%append(ERR_PARSE_TYPE_MISMATCH, "a", "c")
   @assertEqual(1, errors%count())
   call errors%append(ERR_PARSE_TYPE_MISMATCH, "b", "c")
   @assertEqual(2, errors%count())
end subroutine

@test
subroutine test_clear_resets()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   call errors%append(ERR_PARSE_TYPE_MISMATCH, "a", "c")
   call errors%clear()
   @assertFalse(errors%has_errors())
   @assertEqual(0, errors%count())
end subroutine

@test
subroutine test_summary_empty()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   @assertEqual("No errors.", errors%summary())
end subroutine

@test
subroutine test_summary_includes_code_context_message()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   character(len=:), allocatable :: text

   call errors%append(ERR_PARSE_MISSING_REQUIRED, "need foo", "drainage.foo")
   text = errors%summary()

   @assertTrue(index(text, "202") > 0)
   @assertTrue(index(text, "FATAL") > 0)
   @assertTrue(index(text, "drainage.foo") > 0)
   @assertTrue(index(text, "need foo") > 0)
end subroutine

@test
subroutine test_summary_marks_nonfatal_as_warn()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   character(len=:), allocatable :: text

   call errors%append(ERR_FINALIZE_DERIVATION, "derivation warning", "x", is_fatal=.false.)
   text = errors%summary()

   @assertTrue(index(text, "WARN") > 0)
   @assertFalse(index(text, "FATAL") > 0)
end subroutine

@test
subroutine test_abort_if_fatal_returns_when_no_fatals()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   call errors%append(ERR_FINALIZE_DERIVATION, "ok", "x", is_fatal=.false.)
   call errors%abort_if_fatal()
   @assertTrue(.true.)
end subroutine

@test
subroutine test_global_errors_accumulates_appends()
   use funit
   use error_mod
   ! global_errors is a module singleton; clear before exercising it
   ! so leftover state from prior tests doesn't leak in.
   call global_errors%clear()

   call global_errors%append(ERR_LEGACY_FATAL, "first", "phys.A", is_fatal=.false.)
   call global_errors%append(ERR_LEGACY_FATAL, "second", "phys.B", is_fatal=.false.)

   @assertEqual(2, global_errors%count())
   @assertEqual("first",  global_errors%items(1)%message)
   @assertEqual("second", global_errors%items(2)%message)
   call global_errors%clear()
end subroutine

@test
subroutine test_global_errors_clear_resets()
   use funit
   use error_mod
   call global_errors%clear()
   call global_errors%append(ERR_LEGACY_FATAL, "x", "ctx", is_fatal=.false.)
   @assertEqual(1, global_errors%count())
   call global_errors%clear()
   @assertEqual(0, global_errors%count())
end subroutine

@test
subroutine test_warn_deprecated_key_appends_nonfatal()
   use funit
   use error_mod
   type(error_collection_t) :: errors

   call warn_deprecated_key('read_general_toml', 'swafo', errors)

   @assertEqual(1, errors%count())
   @assertEqual(ERR_DEPRECATED_KEY, errors%items(1)%code)
   @assertEqual('read_general_toml', errors%items(1)%context)
   @assertFalse(errors%items(1)%is_fatal)
   @assertTrue(index(errors%items(1)%message, 'swafo') > 0)
   @assertTrue(index(errors%items(1)%message, 'ADR 0009') > 0)
end subroutine

@test
subroutine test_warn_deprecated_key_does_not_abort()
   use funit
   use error_mod
   type(error_collection_t) :: errors
   ! Multiple deprecations + abort_if_fatal must NOT terminate, since
   ! deprecations are non-fatal.
   call warn_deprecated_key('a', 'swafo', errors)
   call warn_deprecated_key('a', 'swaun', errors)
   call warn_deprecated_key('a', 'swvap', errors)
   call errors%abort_if_fatal()
   @assertEqual(3, errors%count())
   @assertFalse(errors%has_fatals())
end subroutine

@test
subroutine test_fatalerr_channel_routes_to_global_errors()
   use funit
   use error_mod
   ! We can't directly invoke fatalerr_collected because it terminates the
   ! process. Instead, prove the channel works by appending non-fatally
   ! through the same singleton and checking the same routing & shape.
   call global_errors%clear()
   call global_errors%append(ERR_LEGACY_FATAL, "boom", "phys.bad", is_fatal=.false.)
   @assertEqual(1, global_errors%count())
   @assertEqual(ERR_LEGACY_FATAL, global_errors%items(1)%code)
   @assertEqual("phys.bad", global_errors%items(1)%context)
   @assertEqual("boom",     global_errors%items(1)%message)
   call global_errors%clear()
end subroutine
