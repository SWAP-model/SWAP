! Reference-value tests for PartitionPrecipitation. See
! src/atmosphere/precipitation.f90 for the partitioning equations.
!
! Post-refactor signature: PartitionPrecipitation(state, config)
! All inputs are pulled from state%atmosphere/state%timecontrol/config%meteo;
! all outputs land in state%atmosphere.

@test
subroutine test_partition_all_rain_when_tav_gt_threshold()
   use funit
   use precipitation_mod
   use swap_state_mod,  only: swap_state_t
   use swap_config_mod, only: swap_config_t
   type(swap_state_t)  :: state
   type(swap_config_t) :: config

   ! Per-day rain array: 10 mm today
   state%atmosphere%arai           = 0.0d0
   state%atmosphere%arai(1)        = 10.0d0
   state%atmosphere%daynrfirst     = 1
   state%timecontrol%daymeteo      = 1
   state%atmosphere%ssnow          = 0.0d0
   state%atmosphere%Tav            = 5.0d0
   state%atmosphere%teprrain       = 2.0d0
   state%atmosphere%teprsnow       = -2.0d0
   config%meteo%swmetdetail        = 0
   config%meteo%snow%swsnow        = 1
   config%meteo%nmetdetail         = 1

   call PartitionPrecipitation(state, config)

   ! mm -> cm conversion
   @assertEqual(1.0d0, state%atmosphere%grai,        1.0d-12)
   ! all rain -> gsnow = 0
   @assertEqual(0.0d0, state%atmosphere%gsnow,       1.0d-12)
   ! no preexisting snowpack -> snrai = 0
   @assertEqual(0.0d0, state%atmosphere%snrai,       1.0d-12)
   ! all precip reaches surface
   @assertEqual(1.0d0, state%atmosphere%fprecnosnow, 1.0d-12)
end subroutine

@test
subroutine test_partition_all_snow_when_tav_lt_threshold()
   use funit
   use precipitation_mod
   use swap_state_mod,  only: swap_state_t
   use swap_config_mod, only: swap_config_t
   type(swap_state_t)  :: state
   type(swap_config_t) :: config

   state%atmosphere%arai           = 0.0d0
   state%atmosphere%arai(1)        = 10.0d0
   state%atmosphere%daynrfirst     = 1
   state%timecontrol%daymeteo      = 1
   state%atmosphere%ssnow          = 0.0d0
   state%atmosphere%Tav            = -5.0d0
   state%atmosphere%teprrain       = 2.0d0
   state%atmosphere%teprsnow       = -2.0d0
   config%meteo%swmetdetail        = 0
   config%meteo%snow%swsnow        = 1
   config%meteo%nmetdetail         = 1

   call PartitionPrecipitation(state, config)

   @assertEqual(1.0d0, state%atmosphere%grai,        1.0d-12)
   ! all snow
   @assertEqual(1.0d0, state%atmosphere%gsnow,       1.0d-12)
   ! no preexisting pack
   @assertEqual(0.0d0, state%atmosphere%snrai,       1.0d-12)
   ! nothing reaches ground
   @assertEqual(0.0d0, state%atmosphere%fprecnosnow, 1.0d-12)
end subroutine

@test
subroutine test_partition_linear_interpolation_midpoint()
   use funit
   use precipitation_mod
   use swap_state_mod,  only: swap_state_t
   use swap_config_mod, only: swap_config_t
   type(swap_state_t)  :: state
   type(swap_config_t) :: config

   state%atmosphere%arai           = 0.0d0
   state%atmosphere%arai(1)        = 10.0d0
   state%atmosphere%daynrfirst     = 1
   state%timecontrol%daymeteo      = 1
   state%atmosphere%ssnow          = 0.0d0
   ! Thresholds span 0..4; tav at midpoint (2.0) -> 0.5 snow fraction
   state%atmosphere%Tav            = 2.0d0
   state%atmosphere%teprrain       = 4.0d0
   state%atmosphere%teprsnow       = 0.0d0
   config%meteo%swmetdetail        = 0
   config%meteo%snow%swsnow        = 1
   config%meteo%nmetdetail         = 1

   call PartitionPrecipitation(state, config)

   @assertEqual(1.0d0, state%atmosphere%grai,  1.0d-12)
   @assertEqual(0.5d0, state%atmosphere%gsnow, 1.0d-12)
end subroutine

@test
subroutine test_partition_snow_disabled_passthrough()
   use funit
   use precipitation_mod
   use swap_state_mod,  only: swap_state_t
   use swap_config_mod, only: swap_config_t
   type(swap_state_t)  :: state
   type(swap_config_t) :: config

   state%atmosphere%arai           = 0.0d0
   state%atmosphere%arai(1)        = 10.0d0
   state%atmosphere%daynrfirst     = 1
   state%timecontrol%daymeteo      = 1
   state%atmosphere%ssnow          = 0.0d0
   state%atmosphere%Tav            = -5.0d0   ! cold, but snow disabled
   state%atmosphere%teprrain       = 2.0d0
   state%atmosphere%teprsnow       = -2.0d0
   config%meteo%swmetdetail        = 0
   config%meteo%snow%swsnow        = 0        ! snow off
   config%meteo%nmetdetail         = 1

   call PartitionPrecipitation(state, config)

   @assertEqual(1.0d0, state%atmosphere%grai,        1.0d-12)
   @assertEqual(0.0d0, state%atmosphere%gsnow,       1.0d-12)
   @assertEqual(0.0d0, state%atmosphere%snrai,       1.0d-12)
   @assertEqual(1.0d0, state%atmosphere%fprecnosnow, 1.0d-12)
end subroutine
