@test
subroutine test_cropfixed_init_writes_scalars()
   use funit
   use cropfixed_init_mod, only: cropfixed_init_from_config
   use cropfixed_config_mod, only: cropfixed_config_t
   use swap_state_mod, only: swap_state_t
   ! variables-only-list emptied — all globals retired
   type(cropfixed_config_t) :: cfg
   type(swap_state_t) :: state  ! [SS-GR-ATM A5.1] dual-write target
   integer :: lcc_out
   ! Case 6 grass.crp values
   cfg%idev = 1
   cfg%lcc  = 366
   cfg%kdif = 0.75d0
   cfg%kdir = 0.75d0
   cfg%swgc = 1
   cfg%swcf = 1
   cfg%swrd = 1
   cfg%swoxygen = 0
   cfg%swdrought = 1
   cfg%swsalinity = 0
   cfg%swcompensate = 0
   cfg%swinter = 1
   cfg%cofab = 0.25d0
   cfg%hlim3h = -200.0d0
   cfg%hlim3l = -800.0d0
   cfg%hlim4  = -8000.0d0
   cfg%adcrh  = 0.5d0
   cfg%adcrl  = 0.1d0
   ! rdctb required by tail-init even though we don't assert on cumdens here.
   allocate(cfg%rdctb(4))
   cfg%rdctb = [0.0d0, 1.0d0, 1.0d0, 1.0d0]

   call cropfixed_init_from_config(cfg, 1, lcc_out, state)  ! [SS-GR-ATM A5.1] state added

   @assertEqual(1,    state%crop%common%idev)
   @assertEqual(366,  lcc_out)
   @assertEqual(0.75d0, state%crop%kdif, 1.0d-12)
   @assertEqual(0.75d0, state%crop%kdir, 1.0d-12)
   @assertEqual(1,    state%crop%common%swgc)
   @assertEqual(1,    state%crop%swcf)
   @assertEqual(1,    state%crop%common%swrd)
   @assertEqual(0,    state%crop%common%swoxygen)
   @assertEqual(1,    state%crop%common%swdrought)
   @assertEqual(0,    state%crop%common%swsalinity)
   @assertEqual(0,    state%crop%common%swcompensate)
   @assertEqual(1,    state%crop%common%swinter)
   @assertEqual(-200.0d0,  state%crop%common%hlim3h, 1.0d-12)
   @assertEqual(-800.0d0,  state%crop%common%hlim3l, 1.0d-12)
   @assertEqual(-8000.0d0, state%crop%common%hlim4,  1.0d-12)
   @assertEqual(0.5d0,     state%crop%common%adcrh,  1.0d-12)
   @assertEqual(0.1d0,     state%crop%common%adcrl,  1.0d-12)
   @assertEqual(0.25d0,    state%crop%cofab,  1.0d-12)

   ! ETref defaults are reset for swcf=1 path
   @assertEqual(0.23d0, state%crop%common%albedo, 1.0d-12)
   @assertEqual(70.0d0, state%crop%common%rsc,    1.0d-12)
   @assertEqual(0.0d0,  state%crop%common%rsw,    1.0d-12)
end subroutine

@test
subroutine test_cropfixed_init_cumdens_constant_density()
   use funit
   use cropfixed_init_mod, only: cropfixed_init_from_config
   use cropfixed_config_mod, only: cropfixed_config_t
   use swap_state_mod, only: swap_state_t
   ! cumdens retired — read via state%crop%common%cumdens
   type(cropfixed_config_t) :: cfg
   type(swap_state_t) :: state  ! [SS-GR-ATM A5.1] dual-write target
   integer :: lcc_out
   ! Same case-6 fixture: rdctb = [0.0, 1.0, 1.0, 1.0] is a constant
   ! density of 1.0 everywhere. After integration and normalization,
   ! cumdens should be linear from 0 at the surface to 1 at the
   ! deepest depth. Check a few representative rows.
   cfg%idev = 1
   cfg%lcc = 366
   cfg%swrd = 1
   cfg%swdrought = 1
   allocate(cfg%rdctb(4))
   cfg%rdctb = [0.0d0, 1.0d0, 1.0d0, 1.0d0]
   call cropfixed_init_from_config(cfg, 1, lcc_out, state)  ! [SS-GR-ATM A5.1] state added
   ! cumdens(1) = 0.0 (depth at surface)
   @assertEqual(0.0d0,  state%crop%common%cumdens(1),   1.0d-12)
   ! cumdens(2) = 0.0 (storage at surface, set explicitly)
   @assertEqual(0.0d0,  state%crop%common%cumdens(2),   1.0d-12)
   ! cumdens(202) = 1.0 (normalized total)
   @assertEqual(1.0d0,  state%crop%common%cumdens(202), 1.0d-12)
   ! Mid-point (i=102, depth=0.5) should be ~0.5 by symmetry of constant density.
   @assertEqual(0.5d0,  state%crop%common%cumdens(102), 1.0d-2)
end subroutine
