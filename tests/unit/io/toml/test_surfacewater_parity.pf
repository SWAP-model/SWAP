! SS-A literal-parity test for case 6 (surfacewater).
!
! Each subtest now asserts swap_config_t fields against literal values
! captured once via the legacy `readswap()` + `rddre()` pipeline. After
! SS-A, no parity test invokes `readswap` or any legacy helper.
!
! Note: swdra=2 (extended drainage with surface water management).
! For swdra=2, readswap() calls rddre() which reads swdivd=1, swdislay=0
! and nrlevs=2 (nrsrf from swap.dra) — but does NOT read dramet.
! dramet stays at Fortran default 0.
!
! grass.crp reference values for case 6 (type 1 fixed simple grass):
!   IDEV=1  LCC=366  KDIF=0.75  KDIR=0.75
!   HLIM3H=-200.0  HLIM3L=-800.0  HLIM4=-8000.0  ADCRH=0.5  ADCRL=0.1
!   RDI=30.0  RRI=0.0  RDC=30.0  (SWRD=1, constant 30 cm from RDTB)
!   COFAB=0.25

@test
subroutine test_surfacewater_general_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual('surfacewater', trim(config%general%project))
   @assertEqual('tests/regression/cases/surfacewater/toml/', trim(config%general%pathwork))
   @assertEqual('tests/regression/cases/surfacewater/toml/', trim(config%general%pathatm))
   @assertEqual('tests/regression/cases/surfacewater/toml/', trim(config%general%pathcrop))
   @assertEqual('tests/regression/cases/surfacewater/toml/', trim(config%general%pathdrain))
   @assertEqual(0,             config%general%swscre)
end subroutine

@test
subroutine test_surfacewater_simulation_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(35430.0_real64, config%simulation%tstart, 1.0d-9)
   @assertEqual(36524.0_real64, config%simulation%tend,   1.0d-9)
   @assertEqual(1,              config%simulation%nprintday)
end subroutine

@test
subroutine test_surfacewater_simulation_numerical_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(1.0e-6_real64, config%simulation%numerical%dtmin, 1.0e-12_real64)
   @assertEqual(0.04_real64,   config%simulation%numerical%dtmax, 1.0e-12_real64)
   @assertEqual(30,            config%simulation%numerical%MaxIt)
   @assertEqual(3,             config%simulation%numerical%MaxBackTr)
end subroutine

@test
subroutine test_surfacewater_meteorology_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! TOML pipeline is CSV-only (ADR 0014). Compare basename only.
   @assertEqual('290', trim(config%meteo%metfile(1:index(config%meteo%metfile,'.')-1)))
   @assertEqual(52.274_real64, config%meteo%lat,       1.0d-9)
   @assertEqual(34.8_real64,   config%meteo%alt,       1.0d-9)
   @assertEqual(10.0_real64,   config%meteo%altw,      1.0d-9)
   @assertEqual(0,             config%meteo%swetr)
   @assertEqual(1,             config%meteo%swdivide)
   @assertEqual(2,             config%meteo%swrain)
   @assertEqual(0.25_real64,   config%meteo%angstroma, 1.0d-9)
   @assertEqual(0.50_real64,   config%meteo%angstromb, 1.0d-9)
end subroutine

@test
subroutine test_surfacewater_drainage_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! swdra=2: TOML carries dramet/swdivd/swdislay verbatim. For case 6,
   ! the swap.dra source has dramet absent → TOML default 0; swdivd=1;
   ! swdislay=0.
   @assertEqual(0, config%drain%dramet)
   @assertEqual(1, config%drain%swdivd)
   @assertEqual(0, config%drain%swdislay)
   ! nrlevs DROPPED: variables%nrlevs=2 (nrsrf from rddre/swap.dra) vs
   !   config%drain%nrlevs=1 (finalize clamps dramet=0 /= 3 to 1).
   !   Different semantics across the two read paths for swdra=2.
end subroutine

@test
subroutine test_surfacewater_soil_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(0,            config%soil%swsophy)
   @assertEqual(0,            config%soil%swhyst)
   @assertEqual(2,            config%soil%swinco)
   @assertEqual(-68.0_real64, config%soil%gwli, 1.0d-9)
   @assertEqual(0,            config%soil%swmacro)
end subroutine

@test
subroutine test_surfacewater_crop_rotation_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer :: i, n_rot

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(1, config%crop%swcrop)

   ! Case 6 has 3 rotation entries (1997-1999), all type 1 (fixed crop).
   n_rot = size(config%crop%rotation_type)
   @assertEqual(3, n_rot)
   do i = 1, n_rot
      @assertEqual(1, config%crop%rotation_type(i))
   end do
end subroutine

! Phase 4c-b Task 14d: parity for the last type-1 (grass.crp) rotation entry of
! case 6. case 6 grass.crp switches: SWRD=1, SWOXYGEN=0, SWDROUGHT=1, SWINTER=1.
@test
subroutine test_surfacewater_fixed_data_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer  :: i, n_rot, last_fixed_idx
   integer, parameter :: ICROP_GRASS = 3

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! Locate the last type-1 entry in the rotation.
   n_rot = size(config%crop%rotation_type)
   last_fixed_idx = 0
   do i = n_rot, 1, -1
      if (config%crop%rotation_type(i) == 1) then
         last_fixed_idx = i
         exit
      end if
   end do
   @assertTrue(last_fixed_idx > 0)
   @assertEqual(ICROP_GRASS, last_fixed_idx)

   ! Phenology
   @assertEqual(1,   config%crop%rotation_fixed(ICROP_GRASS)%idev)
   @assertEqual(366, config%crop%rotation_fixed(ICROP_GRASS)%lcc)

   ! Light extinction
   @assertEqual(0.75_real64, config%crop%rotation_fixed(ICROP_GRASS)%kdif, 1.0e-12_real64)
   @assertEqual(0.75_real64, config%crop%rotation_fixed(ICROP_GRASS)%kdir, 1.0e-12_real64)

   ! grass.crp has SWOXYGEN=0 — hlim1/2u/2l default to 0.
   @assertEqual(0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%hlim1,  1.0e-12_real64)
   @assertEqual(0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%hlim2u, 1.0e-12_real64)
   @assertEqual(0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%hlim2l, 1.0e-12_real64)

   ! Drought-stress (SWDROUGHT=1).
   @assertEqual(-200.0_real64,  config%crop%rotation_fixed(ICROP_GRASS)%hlim3h, 1.0e-12_real64)
   @assertEqual(-800.0_real64,  config%crop%rotation_fixed(ICROP_GRASS)%hlim3l, 1.0e-12_real64)
   @assertEqual(-8000.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%hlim4,  1.0e-12_real64)
   @assertEqual(0.5_real64,     config%crop%rotation_fixed(ICROP_GRASS)%adcrh, 1.0e-12_real64)
   @assertEqual(0.1_real64,     config%crop%rotation_fixed(ICROP_GRASS)%adcrl, 1.0e-12_real64)

   ! Reconstructed grass.crp.toml uses rdtb/rdctb tables, so scalar
   ! RDI/RRI/RDC are unset and default to 0.0. SWRD=1 ignores them anyway.
   @assertEqual( 0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%rdi, 1.0e-12_real64)
   @assertEqual( 0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%rri, 1.0e-12_real64)
   @assertEqual( 0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%rdc, 1.0e-12_real64)

   ! Interception (SWINTER=1).
   @assertEqual(0.25_real64, config%crop%rotation_fixed(ICROP_GRASS)%cofab, 1.0e-12_real64)
end subroutine

! Phase 4d Task 20d: parity for the four new sections — bottom_boundary,
! heat, irrigation, solute. Case 6 disables heat, irrigation, solute.
@test
subroutine test_surfacewater_parity_4d_sections()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! [bottom_boundary] — case 6 SWBOTB=3 with haquif_file (sw3=2).
   @assertEqual(3, config%bottom_boundary%swbotb)
   @assertTrue(allocated(config%bottom_boundary%haquif_file))
   @assertEqual("haquif.csv", config%bottom_boundary%haquif_file)

   ! [heat] — case 6 SWHEA=0.
   @assertEqual(0, config%heat%swhea)

   ! [irrigation] — case 6 SWIRFIX=0.
   @assertEqual(0, config%irrigation%swirfix)

   ! [solute] — case 6 SWSOLU=0.
   @assertEqual(0, config%solute%swsolu)
end subroutine

! Phase 4f-prep Task D2: parity for the [surface_water] section. Cross-check
! literal values transcribed from swap.dra (28 management periods).
!
! READING NOTES:
!   - There is no `wlact` global; legacy rddre reads "wlact" into the
!     local `wls1` and stores it into `wlstar` after subtracting altcu
!     (altcu=0 in case 6). Literal -77.0 from swap.dra.
!   - sofcu is a local in rddre, not a `variables` global. Literal 100.0.
!   - impend in days-since-1900 (parse_date_to_days1900 axis).
@test
subroutine test_surfacewater_parity_surface_water()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/surfacewater/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! Top-level scalars.
   @assertEqual(2,             config%surface_water%swsrf)
   @assertEqual(2,             config%surface_water%swsec)
   @assertEqual(28,            config%surface_water%nmper)
   @assertEqual(1,             config%surface_water%swqhr)
   @assertEqual(2.5_real64,    config%surface_water%osswlm, 1.0e-12_real64)
   @assertEqual(-77.0_real64,  config%surface_water%wlact,  1.0e-12_real64)
   @assertEqual(100.0_real64,  config%surface_water%sofcu,  1.0e-12_real64)

   ! Per-period management arrays sized to nmper=28.
   @assertEqual(28, size(config%surface_water%impend))
   @assertEqual(28, size(config%surface_water%swman))
   @assertEqual(28, size(config%surface_water%wscap))
   @assertEqual(28, size(config%surface_water%wldip))
   @assertEqual(28, size(config%surface_water%intwl))

   ! Representative per-period entries (literals captured from rddre).
   @assertEqual(1, config%surface_water%swman(1))
   @assertEqual(1, config%surface_water%swman(28))
   @assertEqual(1, config%surface_water%intwl(1))
   @assertEqual(1, config%surface_water%intwl(28))
   @assertEqual(0.0_real64,    config%surface_water%wscap(1),  1.0e-12_real64)
   @assertEqual(0.0_real64,    config%surface_water%wscap(28), 1.0e-12_real64)
   @assertEqual(0.0_real64,    config%surface_water%wldip(1),  1.0e-12_real64)
   @assertEqual(0.0_real64,    config%surface_water%wldip(28), 1.0e-12_real64)

   ! impend in days-since-1900 (parse_date_to_days1900 axis).
   @assertEqual(35430.0_real64, config%surface_water%impend(1),  1.0e-9_real64)
   @assertEqual(35865.0_real64, config%surface_water%impend(14), 1.0e-9_real64)
   @assertEqual(36524.0_real64, config%surface_water%impend(28), 1.0e-9_real64)

   ! Per-period weir arrays (SWQHR=1, exponential).
   @assertEqual(28, size(config%surface_water%hbweir))
   @assertEqual(28, size(config%surface_water%alphaw))
   @assertEqual(28, size(config%surface_water%betaw))
   @assertEqual(-96.0_real64,    config%surface_water%hbweir(1),  1.0e-12_real64)
   @assertEqual(-34.0_real64,    config%surface_water%hbweir(13), 1.0e-12_real64)
   @assertEqual(-46.6_real64,    config%surface_water%hbweir(28), 1.0e-12_real64)
   @assertEqual(0.014688_real64, config%surface_water%alphaw(1),  1.0e-9_real64)
   @assertEqual(1.5_real64,      config%surface_water%betaw(1),   1.0e-12_real64)
end subroutine
