! Tests for the 14 physics fields promoted into solute_config_t in
! Phase 0 of the solute state-migration arc. Each scalar gets:
! default-value test + valid-range test + out-of-range rejection.
! Per-layer arrays get: default-unallocated test + size validation.
! See ADR 0032 / 2026-05-10 design spec.

@test
subroutine test_solute_config_cref_default_zero()
   use funit
   use iso_fortran_env, only: real64
   use solute_config_mod, only: solute_config_t
   type(solute_config_t) :: cfg
   @assertEqual(0.0_real64, cfg%cref, 1.0e-12_real64)
end subroutine

@test
subroutine test_solute_config_swbr_default_zero()
   use funit
   use solute_config_mod, only: solute_config_t
   type(solute_config_t) :: cfg
   @assertEqual(0, cfg%swbr)
end subroutine

