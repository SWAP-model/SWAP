@test
subroutine test_surfacewater_init_zeroes_state()
   use funit
   use iso_fortran_env, only: real64
   use surfacewater_init_mod, only: surfacewater_init
   use swap_state_mod, only: swap_state_t
   ! SS-SWST Phase 2 Task 11: wls global removed from use variables (now state-only).
   use variables, only: nrlevs, numnod, swdtyp, zbotdr, widthr, &
                         taludr, l, wls1_init, wlp, swsrf, swsec, swqhr, &
                         nmper, swman
   type(swap_state_t) :: state
   integer :: i
   ! Minimal happy-path setup mimicking case 6's first level.
   ! swman is a fixed-size global; set element 1 directly.
   ! l is set in CENTIMETRES: the m->cm conversion now happens at
   ! TOML-read time (spec D6); surfacewater_init no longer converts l.
   swsrf  = 2
   swsec  = 2
   swqhr  = 1
   nrlevs = 1
   numnod = 1
   nmper  = 1
   wls1_init = -77.0d0
   swman(1)  = 1
   swdtyp(1) = 0
   zbotdr(1) = -115.0d0
   widthr(1) = 100.0d0
   taludr(1) = 0.66d0
   l(1)      = 39000.0d0   ! 390 m * 100 = 39000 cm
   call surfacewater_init(state)

   ! wlp global kept (not a SW-owned var; bocodre reads it for primary system level).
   ! wls global dropped (SS-SWST Phase 2 Task 11): now written only to state%surfacewater%wls.
   @assertEqual(0.0_real64,   wlp, 1.0d-12)

   ! numadj and wlsbak global writes dropped (Task 6); assert only via typed state.
   ! Assert via the typed state.
   @assertEqual(0, state%surfacewater%numadj)
   do i = 1, 4
      @assertEqual(0.0_real64, state%surfacewater%wlsbak(i), 1.0d-12)
   end do
   @assertEqual(-77.0_real64, state%surfacewater%wls,    1.0d-12)
   @assertEqual(-77.0_real64, state%surfacewater%wlstar, 1.0d-12)
end subroutine

@test
subroutine test_surfacewater_init_sttab_top_rows()
   use funit
   use iso_fortran_env, only: real64
   use surfacewater_init_mod, only: surfacewater_init
   use swap_state_mod, only: swap_state_t
   use variables, only: nrlevs, numnod, swdtyp, zbotdr, widthr, taludr, l, &
                         wls1_init, swsrf, swsec, swqhr, nmper, swman
   type(swap_state_t) :: state
   ! l set in cm (spec D6: conversion happens at TOML-read time).
   swsrf  = 2
   swsec  = 2
   swqhr  = 1
   nrlevs = 1
   numnod = 1
   nmper  = 1
   wls1_init = -77.0d0
   swman(1)  = 1
   swdtyp(1) = 0
   zbotdr(1) = -115.0d0
   widthr(1) = 100.0d0
   taludr(1) = 0.66d0
   l(1)      = 39000.0d0   ! 390 m * 100 = 39000 cm
   call surfacewater_init(state)

   ! Assert via typed state (global sttab write dropped: ADR 0030 Phase 2 Task 2).
   ! Row 1 = +100cm; row 2 = 0cm.
   @assertEqual(100.0_real64, state%surfacewater%sttab(1, 1), 1.0d-12)
   @assertEqual(  0.0_real64, state%surfacewater%sttab(2, 1), 1.0d-12)
   ! Rows 3..22 divide [0, zbotdr(1)] = [0, -115] into 20 compartments.
   ! Row 3 = -5.75; row 22 = -115.
   @assertEqual(-5.75_real64,  state%surfacewater%sttab( 3, 1), 1.0d-12)
   @assertEqual(-115.0_real64, state%surfacewater%sttab(22, 1), 1.0d-12)
end subroutine

@test
subroutine test_surfacewater_init_sttab_storage_row3()
   use funit
   use iso_fortran_env, only: real64
   use surfacewater_init_mod, only: surfacewater_init
   use swap_state_mod, only: swap_state_t
   use variables, only: nrlevs, numnod, swdtyp, zbotdr, widthr, taludr, l, &
                         wls1_init, swsrf, swsec, swqhr, nmper, swman
   type(swap_state_t) :: state
   ! Same fixture as test_surfacewater_init_sttab_top_rows.
   swsrf  = 2
   swsec  = 2
   swqhr  = 1
   nrlevs = 1
   numnod = 1
   nmper  = 1
   wls1_init = -77.0d0
   swman(1)  = 1
   swdtyp(1) = 0   ! open channel
   zbotdr(1) = -115.0d0
   widthr(1) = 100.0d0
   taludr(1) = 0.66d0
   ! l is set in cm (spec D6: conversion happens at TOML-read time,
   ! surfacewater_init no longer converts). 390 m * 100 = 39000 cm.
   l(1)      = 39000.0d0
   call surfacewater_init(state)

   ! Assert via typed state (global sttab write dropped: ADR 0030 Phase 2 Task 2).
   ! sttab(3,1) = zbotdr(1) * 1/20 = -5.75 cm.
   ! Trapezium branch (depth=-5.75 > zbotdr=-115, depth <= 0):
   !   wdepth = -5.75 - (-115.0) = 109.25 cm
   !   wvolum = 109.25 * (100.0 + 109.25 / 0.66) = 109.25 * 265.530303 = 29009.186 cm^2
   !   sttab(3,2) = 29009.186 / 39000.0 = 0.74382527...
   @assertEqual(0.7438_real64, state%surfacewater%sttab(3, 2), 1.0d-3)
end subroutine
