! Tests for toml_field_helpers_mod.

@test
subroutine test_get_required_int_happy()
   use funit
   use tomlf, only: toml_table, toml_load, get_value
   use toml_field_helpers_mod
   use error_mod
   type(toml_table), allocatable :: doc
   type(toml_table), pointer     :: sec
   type(error_collection_t)      :: errors
   integer :: out

   call toml_load(doc, 'tests/unit/io/toml/fixtures/happy.toml')
   call get_value(doc, 'section', sec, requested=.false.)
   call get_required_int(sec, 'my_int', out, 'section.my_int', errors)

   @assertEqual(42, out)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_get_required_int_type_mismatch()
   use funit
   use tomlf, only: toml_table, toml_load, get_value
   use toml_field_helpers_mod
   use error_mod
   type(toml_table), allocatable :: doc
   type(toml_table), pointer     :: sec
   type(error_collection_t)      :: errors
   integer :: out

   call toml_load(doc, 'tests/unit/io/toml/fixtures/wrong_types.toml')
   call get_value(doc, 'section', sec, requested=.false.)
   call get_required_int(sec, 'my_int', out, 'section.my_int', errors)

   @assertTrue(errors%has_errors())
   @assertEqual(ERR_PARSE_TYPE_MISMATCH, errors%items(1)%code)
end subroutine

