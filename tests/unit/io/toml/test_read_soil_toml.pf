@test
subroutine test_read_soil_happy()
   use funit
   use tomlf, only: toml_table, toml_load
   use soil_config_mod
   use read_soil_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(soil_config_t)           :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/soil_minimal.toml')
   doc_ptr => doc
   call read_soil_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(0, c%swsophy)
   @assertEqual(1, c%swinco)
   @assertEqual(30.0d0, c%rsoil, 1.0d-12)
end subroutine

@test
subroutine test_read_soil_initial_conditions()
   use funit
   use tomlf, only: toml_table, toml_load
   use soil_config_mod
   use read_soil_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(soil_config_t)           :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/soil_minimal.toml')
   doc_ptr => doc
   call read_soil_toml(doc_ptr, c, errors)

   @assertEqual(-75.0d0, c%gwli,    1.0d-12)
   @assertEqual(0.2d0,   c%pondmx,  1.0d-12)
end subroutine

@test
subroutine test_read_soil_missing_section_is_silent()
   use funit
   use tomlf, only: toml_table, toml_load
   use soil_config_mod
   use read_soil_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(soil_config_t)           :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/general_minimal.toml')
   doc_ptr => doc
   call read_soil_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_read_soil_discretization_full()
   use funit
   use tomlf, only: toml_table, toml_load
   use soil_config_mod
   use read_soil_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(soil_config_t)           :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/soil_discretization_full.toml')
   doc_ptr => doc
   call read_soil_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, c%discretization%swdiscrvert)
   @assertEqual(3, c%discretization%numnodnew)
   @assertTrue(allocated(c%discretization%dznew))
   @assertEqual(3, size(c%discretization%dznew))
   @assertEqual(5.0d0,  c%discretization%dznew(1), 1.0d-12)
   @assertEqual(7.5d0,  c%discretization%dznew(2), 1.0d-12)
   @assertEqual(10.0d0, c%discretization%dznew(3), 1.0d-12)
end subroutine

@test
subroutine test_read_soil_frost_full()
   use funit
   use tomlf, only: toml_table, toml_load
   use soil_config_mod
   use read_soil_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(soil_config_t)           :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/soil_frost_full.toml')
   doc_ptr => doc
   call read_soil_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1,      c%frost%swfrost)
   @assertEqual(-1.0d0, c%frost%tfroststa, 1.0d-12)
   @assertEqual(-3.0d0, c%frost%tfrostend, 1.0d-12)
   @assertEqual(1,      c%frost%swsublim)
end subroutine

@test
subroutine test_read_soil_cofani_array()
   use funit
   use tomlf, only: toml_table, toml_load
   use soil_config_mod
   use read_soil_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer     :: doc_ptr
   type(soil_config_t)           :: c
   type(error_collection_t)      :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/soil_cofani_array.toml')
   doc_ptr => doc
   call read_soil_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertTrue(allocated(c%cofani))
   @assertEqual(4, size(c%cofani))
   @assertEqual(1.0d0, c%cofani(1), 1.0d-12)
   @assertEqual(1.5d0, c%cofani(2), 1.0d-12)
   @assertEqual(2.0d0, c%cofani(3), 1.0d-12)
   @assertEqual(0.5d0, c%cofani(4), 1.0d-12)
   @assertEqual(3,     c%nrstaring)
end subroutine
