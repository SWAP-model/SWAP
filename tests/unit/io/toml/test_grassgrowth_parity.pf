@test
subroutine test_grassgrowth_crop_rotation_parity()
   use funit
   use variables, only: swCrop
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer :: i, n_rot

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap()
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/2.grassgrowth/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   @assertEqual(swCrop, config%crop%swcrop)

   ! Case 2 has 5 rotation entries, all type 3 (WOFOST grass).
   n_rot = size(config%crop%rotation_type)
   @assertEqual(5, n_rot)
   do i = 1, n_rot
      @assertEqual(3, config%crop%rotation_type(i))
   end do
end subroutine

! Phase 4c-b Task 14b: parity for the last type-3 (grassd) rotation entry of
! case 2.grassgrowth. Drive readgrass directly via the legacy_crop_helper
! bridge and cross-check `variables` globals against config%crop%rotation_grass.
!
! Case 2 grassd.crp has SWRD=2, so readgrass reads rdi/rri/rdc as scalars
! (readswap.f90 lines ~3870 in the readgrass swrd=2 branch).
@test
subroutine test_grassgrowth_grass_data_parity()
   use funit
   use variables, only: &
      hlim1, hlim2u, hlim2l, hlim3h, hlim3l, hlim4, rdi, rri, rdc
   use legacy_crop_helper_mod, only: read_legacy_grass
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer  :: i, n_rot, last_grass_idx
   integer, parameter :: ICROP_GRASSD = 5

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap()
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/2.grassgrowth/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! Locate the last type-3 entry in the rotation.
   n_rot = size(config%crop%rotation_type)
   last_grass_idx = 0
   do i = n_rot, 1, -1
      if (config%crop%rotation_type(i) == 3) then
         last_grass_idx = i
         exit
      end if
   end do
   @assertTrue(last_grass_idx > 0)

   ! Sanity check: all 5 rotation entries are type 3; last is index 5.
   @assertEqual(ICROP_GRASSD, last_grass_idx)

   ! Drive the legacy readgrass from inside the case directory.
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call read_legacy_grass(ICROP_GRASSD, 'grassd')
   call chdir_to(trim(orig_cwd))

   ! Feddes water-stress parameters (swoxygen=1 → hlim1/2u/2l populated).
   @assertEqual(hlim1,  config%crop%rotation_grass(ICROP_GRASSD)%hlim1,  1.0e-12_real64)
   @assertEqual(hlim2u, config%crop%rotation_grass(ICROP_GRASSD)%hlim2u, 1.0e-12_real64)
   @assertEqual(hlim2l, config%crop%rotation_grass(ICROP_GRASSD)%hlim2l, 1.0e-12_real64)
   @assertEqual(hlim3h, config%crop%rotation_grass(ICROP_GRASSD)%hlim3h, 1.0e-12_real64)
   @assertEqual(hlim3l, config%crop%rotation_grass(ICROP_GRASSD)%hlim3l, 1.0e-12_real64)
   @assertEqual(hlim4,  config%crop%rotation_grass(ICROP_GRASSD)%hlim4,  1.0e-12_real64)

   ! Root growth (swrd=2 → rdi/rri/rdc populated).
   @assertEqual(rdi, config%crop%rotation_grass(ICROP_GRASSD)%rdi, 1.0e-12_real64)
   @assertEqual(rri, config%crop%rotation_grass(ICROP_GRASSD)%rri, 1.0e-12_real64)
   @assertEqual(rdc, config%crop%rotation_grass(ICROP_GRASSD)%rdc, 1.0e-12_real64)
end subroutine
