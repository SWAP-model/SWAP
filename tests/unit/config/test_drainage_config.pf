@test
subroutine test_drainage_altcu_nonzero_rejected()
   use funit
   use drainage_config_mod, only: drainage_config_t
   use error_mod, only: error_collection_t, ERR_VALIDATION_CROSS_FIELD
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   integer :: i
   logical :: found
   d%swdra = 2
   d%altcu = 5.0d0   ! non-zero: should be rejected
   call d%validate(errors)
   found = .false.
   do i = 1, errors%count()
      if (errors%items(i)%code == ERR_VALIDATION_CROSS_FIELD .and. &
          index(errors%items(i)%message, 'altcu') > 0) found = .true.
   end do
   @assertTrue(found)
end subroutine

@test
subroutine test_drainage_finalize_preserves_nrlevs_when_swdra2()
   use funit
   use drainage_config_mod, only: drainage_config_t
   use error_mod, only: error_collection_t
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   ! SWDRA=2, dramet=0 — extended drainage where rddre would
   ! override nrlevs from NRSRF. Don't clobber nrlevs to 1.
   d%swdra  = 2
   d%dramet = 0
   d%nrlevs = 2
   call d%finalize(errors)
   @assertEqual(2, d%nrlevs)
end subroutine

@test
subroutine test_drainage_finalize_clobbers_nrlevs_when_dramet1()
   use funit
   use drainage_config_mod, only: drainage_config_t
   use error_mod, only: error_collection_t
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   ! Existing legacy convention: dramet 1 or 2 clobber nrlevs to 1.
   d%swdra  = 1
   d%dramet = 1
   d%nrlevs = 4
   call d%finalize(errors)
   @assertEqual(1, d%nrlevs)
end subroutine

@test
subroutine test_drainage_swdra2_with_dramet3_rejected()
   use funit
   use drainage_config_mod, only: drainage_config_t
   use error_mod, only: error_collection_t, ERR_VALIDATION_CROSS_FIELD
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   integer :: i
   logical :: found
   d%swdra  = 2
   d%dramet = 3
   call d%validate(errors)
   found = .false.
   do i = 1, errors%count()
      if (errors%items(i)%code == ERR_VALIDATION_CROSS_FIELD .and. &
          index(errors%items(i)%message, 'swdra=2') > 0) found = .true.
   end do
   @assertTrue(found)
end subroutine

@test
subroutine test_drainage_drfil_field_roundtrips()
   use funit
   use drainage_config_mod, only: drainage_config_t
   type(drainage_config_t) :: d
   d%drfil = "myswap"
   @assertTrue(allocated(d%drfil))
   @assertEqual("myswap", d%drfil)
end subroutine

@test
subroutine test_drainage_swliminf_default_zero_validates_clean()
   use funit
   use error_mod
   use drainage_config_mod, only: drainage_config_t
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%swdra  = 1
   d%dramet = 3
   d%nrlevs = 1
   ! swliminf default is 0 — valid enum value
   call d%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_drainage_swliminf_one_with_dramet3_validates_clean()
   use funit
   use error_mod
   use drainage_config_mod, only: drainage_config_t
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%swdra    = 1
   d%dramet   = 3
   d%nrlevs   = 1
   d%swliminf = 1
   call d%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_drainage_swliminf_one_without_dramet3_fails()
   use funit
   use error_mod
   use drainage_config_mod, only: drainage_config_t
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   integer :: i
   logical :: found
   d%swdra    = 1
   d%dramet   = 1
   d%nrlevs   = 1
   d%swliminf = 1   ! dramet /= 3 — cross-section error expected
   call d%validate(errors)
   found = .false.
   do i = 1, errors%count()
      if (errors%items(i)%code == ERR_VALIDATION_CROSS_FIELD .and. &
          index(errors%items(i)%message, 'swliminf') > 0) found = .true.
   end do
   @assertTrue(found)
end subroutine

@test
subroutine test_drainage_swliminf_invalid_enum_fails()
   use funit
   use error_mod
   use drainage_config_mod, only: drainage_config_t
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%swliminf = 9   ! out of [0, 1]
   call d%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine
