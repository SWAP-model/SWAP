@test
subroutine test_meteo_valid_passes()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%alt = 10.0d0
   call m%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_meteo_lat_out_of_range_fails()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 100.0d0
   call m%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_meteo_swrain_invalid_fails()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%swrain = 9
   call m%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_meteorology_evaporation_swcfbs_zero_validates_clean()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%evaporation%swcfbs = 0
   m%evaporation%cfbs   = 99.0d0   ! ignored when swcfbs=0
   call m%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_meteorology_evaporation_swcfbs_one_cfbs_out_of_range()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%evaporation%swcfbs = 1
   m%evaporation%cfbs   = 5.0d0   ! out of [0.5, 1.5]
   call m%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_meteorology_evaporation_cofredbl_out_of_range()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%evaporation%cofredbl = 2.0d0
   call m%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_meteorology_snow_swsnow_zero_validates_clean()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%snow%swsnow = 0
   m%snow%snowcoef = 999.0d0   ! ignored when swsnow=0
   call m%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_meteorology_snow_swsnow_one_minimal_valid()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%snow%swsnow   = 1
   m%snow%snowcoef = 0.5d0
   m%snow%teprrain = 2.0d0
   m%snow%teprsnow = 0.0d0
   call m%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_meteorology_snow_swsnow_one_teprsnow_above_teprrain()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%snow%swsnow   = 1
   m%snow%snowcoef = 0.5d0
   m%snow%teprrain = 0.0d0
   m%snow%teprsnow = 2.0d0   ! must be <= teprrain
   call m%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_meteo_detail_file_field_roundtrips()
   use funit
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   m%detail_file = "mysite.det.csv"
   @assertEqual("mysite.det.csv", m%detail_file)
end subroutine

@test
subroutine test_meteorology_evaporation_rsigni_default_validates_clean()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   ! rsigni default is 0.5 — within [0, 10]
   call m%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_meteorology_evaporation_rsigni_out_of_range_fails()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%evaporation%rsigni = 20.0d0   ! out of [0, 10]
   call m%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_meteorology_evaporation_cfevappond_default_validates_clean()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   ! cfevappond default is 1.25 — within [0, 10]
   call m%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_meteorology_evaporation_cfevappond_out_of_range_fails()
   use funit
   use error_mod
   use meteorology_config_mod
   type(meteorology_config_t) :: m
   type(error_collection_t)   :: errors
   m%lat = 52.0d0
   m%evaporation%cfevappond = 50.0d0   ! out of [0, 10]
   call m%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine
