   use error_mod
   use iso_fortran_env, only: real64
   use irrigation_config_mod
   type(irrigation_schedule_t) :: s
   type(error_collection_t)    :: errors
   s%schedule = 1
   s%tcs      = 1
   s%dcs      = 1
   s%startirr_day   = 1
   s%startirr_month = 1
