module test_state_lifecycles_suite
    use funit
    use time_state_mod, only: time_state_t, time_state_init, time_state_finalize
    use atmosphere_state_mod, only: atmosphere_config_t, atmosphere_state_t, &
                                    atmosphere_config_init, atmosphere_config_finalize, &
                                    atmosphere_state_init, atmosphere_state_finalize
    use boundary_state_mod, only: boundary_config_t, boundary_state_t, &
                                  boundary_config_init, boundary_config_finalize, &
                                  boundary_state_init, boundary_state_finalize
    use drainage_state_mod, only: drainage_config_t, drainage_state_t, &
                                  drainage_config_init, drainage_config_finalize, &
                                  drainage_state_init, drainage_state_finalize
    use surfacewater_state_mod, only: surfacewater_state_t, surfacewater_state_init, surfacewater_state_finalize
    use heat_state_mod, only: heat_config_t, heat_state_t, &
                              heat_config_init, heat_config_finalize, &
                              heat_state_init, heat_state_finalize
    use solute_state_mod, only: solute_config_t, solute_state_t, &
                                solute_config_init, solute_config_finalize, &
                                solute_state_init, solute_state_finalize
    use soil_state_mod, only: soil_config_t, soil_state_t, &
                              soil_config_init, soil_config_finalize, &
                              soil_state_init, soil_state_finalize
    use macropore_state_mod, only: macropore_config_t, macropore_state_t, &
                                   macropore_config_init, macropore_config_finalize, &
                                   macropore_state_init, macropore_state_finalize
    use irrigation_state_mod, only: irrigation_state_t, irrigation_state_init, irrigation_state_finalize
    use tillage_state_mod, only: tillage_config_t, tillage_state_t, &
                                 tillage_config_init, tillage_config_finalize, &
                                 tillage_state_init, tillage_state_finalize
    use oxygenstress_state_mod, only: oxygenstress_state_t, oxygenstress_state_init, oxygenstress_state_finalize
    use rootextraction_state_mod, only: rootextraction_state_t, rootextraction_state_init, rootextraction_state_finalize
    use crop_state_mod, only: crop_state_t, crop_state_init, crop_state_finalize
    use management_soil_state_mod, only: wofost_soil_config_t, wofost_soil_state_t, &
                                         wofost_soil_config_init, wofost_soil_config_finalize, &
                                         wofost_soil_state_init, wofost_soil_state_finalize
    use wofost_state_mod, only: wofost_state_t, wofost_state_init, wofost_state_finalize
    use swap_state_mod, only: swap_state_t, swap_state_init, swap_state_finalize
    use swap_config_mod, only: swap_config_t, swap_config_init, swap_config_finalize
    implicit none

    public :: StateLifecyclesTest

@TestCase
    type, extends(TestCase) :: StateLifecyclesTest
    end type StateLifecyclesTest

contains

@Test
    subroutine test_time_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(time_state_t) :: state

        call time_state_init(state)
        state%dt = 1.0d0
        call time_state_finalize(state)

        @assertEqual(0.0d0, state%dt)
    end subroutine test_time_state_lifecycle

@Test
    subroutine test_atmosphere_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(atmosphere_config_t) :: config
        type(atmosphere_state_t) :: state

        call atmosphere_config_init(config)
        config%sicact = 2.0d0
        call atmosphere_state_init(state, config)

        @assertEqual(2.0d0, state%sicact)

        call atmosphere_state_finalize(state)
        call atmosphere_config_finalize(config)

        @assertEqual(0.0d0, state%sicact)
    end subroutine test_atmosphere_state_lifecycle

@Test
    subroutine test_boundary_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(boundary_config_t) :: config
        type(boundary_state_t) :: state

        call boundary_config_init(config, nday=2, nbbc=4, npondmx=4)
        call boundary_state_init(state, config)

        @assertTrue(allocated(config%gwltab))

        call boundary_state_finalize(state)
        call boundary_config_finalize(config)

        @assertFalse(allocated(config%gwltab))
    end subroutine test_boundary_state_lifecycle

@Test
    subroutine test_drainage_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(drainage_config_t) :: config
        type(drainage_state_t) :: state

        call drainage_config_init(config, nrlevs=2, maowl=2)
        config%drainl = -50.0d0
        call drainage_state_init(state, config, numnod=3)

        @assertTrue(allocated(state%qdra))
        @assertEqual(-50.0d0, state%drainl(1))

        call drainage_state_finalize(state)
        call drainage_config_finalize(config)

        @assertFalse(allocated(state%qdra))
    end subroutine test_drainage_state_lifecycle

@Test
    subroutine test_surfacewater_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(surfacewater_state_t) :: state

        call surfacewater_state_init(state, nmper=2, mamte=2, maowl=2, nrlevs=1)

        @assertTrue(allocated(state%owltab))

        call surfacewater_state_finalize(state)

        @assertFalse(allocated(state%owltab))
    end subroutine test_surfacewater_state_lifecycle

@Test
    subroutine test_heat_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(heat_config_t) :: config
        type(heat_state_t) :: state

        call heat_config_init(config, mabbc=1, nheat=2)
        config%tsoil = 5.0d0
        call heat_state_init(state, config, numnod=2)

        @assertTrue(allocated(state%tsoil))
        @assertEqual(5.0d0, state%tsoil(1))

        call heat_state_finalize(state)
        call heat_config_finalize(config)

        @assertFalse(allocated(state%tsoil))
    end subroutine test_heat_state_lifecycle

@Test
    subroutine test_solute_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(solute_config_t) :: config
        type(solute_state_t) :: state

        call solute_config_init(config, numlay=1, ncseep=2, numnod=2)
        config%cml = 1.0d0
        call solute_state_init(state, config, numnod=2, numlay=1, nrlevs=1)

        @assertTrue(allocated(state%cml))
        @assertEqual(1.0d0, state%cml(1))

        call solute_state_finalize(state)
        call solute_config_finalize(config)

        @assertFalse(allocated(state%cml))
    end subroutine test_solute_state_lifecycle

@Test
    subroutine test_soil_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(soil_config_t) :: config
        type(soil_state_t) :: state

        call soil_config_init(config, numnod=2, numlay=1, nsublay=1)
        config%h = -10.0d0
        call soil_state_init(state, config)

        @assertTrue(allocated(state%h))
        @assertEqual(-10.0d0, state%h(1))

        call soil_state_finalize(state)
        call soil_config_finalize(config)

        @assertFalse(allocated(state%h))
    end subroutine test_soil_state_lifecycle

@Test
    subroutine test_macropore_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(macropore_config_t) :: config
        type(macropore_state_t) :: state

        call macropore_config_init(config)
        config%water_storage_mb_ic = 1.0d0
        call macropore_state_init(state, config, numnod=2, maxdom=2, maxdra=1)

        @assertTrue(allocated(state%DiPoCp))
        @assertEqual(1.0d0, state%WaSrDm1)

        call macropore_state_finalize(state)
        call macropore_config_finalize(config)

        @assertFalse(allocated(state%DiPoCp))
    end subroutine test_macropore_state_lifecycle

@Test
    subroutine test_irrigation_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(irrigation_state_t) :: state

        call irrigation_state_init(state, maxirrig=3)

        @assertTrue(allocated(state%ssdi_date))

        call irrigation_state_finalize(state)

        @assertFalse(allocated(state%ssdi_date))
    end subroutine test_irrigation_state_lifecycle

@Test
    subroutine test_tillage_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(tillage_config_t) :: config
        type(tillage_state_t) :: state

        call tillage_config_init(config, numlay=2, maxtill=2, maxtypes=2)
        call tillage_state_init(state, config)

        @assertTrue(allocated(state%Rho_tillage))

        call tillage_state_finalize(state)
        call tillage_config_finalize(config)

        @assertFalse(allocated(state%Rho_tillage))
    end subroutine test_tillage_state_lifecycle

@Test
    subroutine test_oxygenstress_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(oxygenstress_state_t) :: state

        call oxygenstress_state_init(state, n_nod=2)

        @assertTrue(allocated(state%d_soil_term1))

        state%initialized = .true.
        call oxygenstress_state_finalize(state)

        @assertFalse(allocated(state%d_soil_term1))
        @assertFalse(state%initialized)
    end subroutine test_oxygenstress_state_lifecycle

@Test
    subroutine test_rootextraction_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(rootextraction_state_t) :: state

        call rootextraction_state_init(state)
        state%reltr = 1.0d0
        call rootextraction_state_finalize(state)

        @assertEqual(0.0d0, state%reltr)
    end subroutine test_rootextraction_state_lifecycle

@Test
    subroutine test_crop_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(crop_state_t) :: state

        call crop_state_init(state, ncrop=2)

        @assertTrue(allocated(state%cropstart))
        @assertEqual(1.0d0, state%fco2amax)

        call crop_state_finalize(state)

        @assertFalse(allocated(state%cropstart))
    end subroutine test_crop_state_lifecycle

@Test
    subroutine test_management_soil_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(wofost_soil_config_t) :: config
        type(wofost_soil_state_t) :: state

        call wofost_soil_config_init(config)
        call wofost_soil_state_init(state, config)

        @assertEqual(0.0d0, state%idwrt)

        call wofost_soil_state_finalize(state)
        call wofost_soil_config_finalize(config)

        @assertEqual(0.0d0, state%idwrt)
    end subroutine test_management_soil_state_lifecycle

@Test
    subroutine test_wofost_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(wofost_state_t) :: state

        call wofost_state_init(state, maxfn_param=2, maxmat_param=2, maxamn_param=2)

        @assertTrue(allocated(state%RateconFOM_ref))
        @assertEqual(2, size(state%RateconFOM_ref))

        call wofost_state_finalize(state)

        @assertFalse(allocated(state%RateconFOM_ref))
    end subroutine test_wofost_state_lifecycle

@Test
    subroutine test_swap_state_lifecycle(this)
        class(StateLifecyclesTest), intent(inout) :: this
        type(swap_state_t) :: state
        type(swap_config_t) :: cfg

        call swap_config_init(cfg, numnod=2, numlay=1, nrlevs=1, ncrop=1)
        call swap_state_init(state, cfg)

        @assertTrue(state%initialized)
        @assertTrue(allocated(state%soil%h))

        call swap_state_finalize(state)
        call swap_config_finalize(cfg)

        @assertFalse(state%initialized)
        @assertFalse(allocated(state%soil%h))
    end subroutine test_swap_state_lifecycle

end module test_state_lifecycles_suite