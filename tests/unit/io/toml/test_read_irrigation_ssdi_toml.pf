@test
subroutine test_read_mode0_full_block()
   use funit
   use tomlf, only: toml_table, toml_load, get_value
   use irrigation_config_mod, only: irrigation_ssdi_t
   use read_irrigation_ssdi_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr, irr_ptr
   type(irrigation_ssdi_t)               :: ssdi
   type(error_collection_t)              :: errors
   integer                               :: stat

   call toml_load(doc, 'tests/unit/io/toml/fixtures/ssdi_mode0.toml')
   doc_ptr => doc

   irr_ptr => null()
   call get_value(doc_ptr, 'irrigation', irr_ptr, requested=.false., stat=stat)
   @assertTrue(associated(irr_ptr))

   call read_irrigation_ssdi_toml(irr_ptr, ssdi, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(0, ssdi%schedule)
   @assertEqual(-30.0d0, ssdi%ssdi_z(1), 1.0d-12)
   @assertEqual(-50.0d0, ssdi%ssdi_z(2), 1.0d-12)
   @assertTrue(allocated(ssdi%fixed%events_file))
   @assertEqual('ssdi_events.csv', trim(ssdi%fixed%events_file))
end subroutine test_read_mode0_full_block


@test
subroutine test_read_mode1_full_block()
   use funit
   use tomlf, only: toml_table, toml_load, get_value
   use irrigation_config_mod, only: irrigation_ssdi_t
   use read_irrigation_ssdi_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr, irr_ptr
   type(irrigation_ssdi_t)               :: ssdi
   type(error_collection_t)              :: errors
   integer                               :: stat

   call toml_load(doc, 'tests/unit/io/toml/fixtures/ssdi_mode1.toml')
   doc_ptr => doc

   irr_ptr => null()
   call get_value(doc_ptr, 'irrigation', irr_ptr, requested=.false., stat=stat)
   @assertTrue(associated(irr_ptr))

   call read_irrigation_ssdi_toml(irr_ptr, ssdi, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, ssdi%schedule)
   @assertEqual(-30.0d0, ssdi%ssdi_z(1), 1.0d-12)
   @assertEqual(-50.0d0, ssdi%ssdi_z(2), 1.0d-12)
   ! events_file not allocated — [irrigation.ssdi.fixed] block absent
   @assertFalse(allocated(ssdi%fixed%events_file))
   ! scheduled block
   @assertEqual(1, ssdi%scheduled%sched_type)
   @assertEqual(0.7d0,  ssdi%scheduled%threshold,      1.0d-12)
   @assertEqual(10.0d0, ssdi%scheduled%ssdi_amount,    1.0d-12)
   @assertEqual(5.0d0,  ssdi%scheduled%ssdi_appl_rate, 1.0d-12)
   @assertEqual(0, ssdi%scheduled%sw_interval)
   ! days_interval default = 1
   @assertEqual(1, ssdi%scheduled%days_interval)
end subroutine test_read_mode1_full_block


@test
subroutine test_read_ssdi_missing_block_keeps_defaults()
   use funit
   use tomlf, only: toml_table, toml_load, get_value
   use irrigation_config_mod, only: irrigation_ssdi_t
   use read_irrigation_ssdi_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr, irr_ptr
   type(irrigation_ssdi_t)               :: ssdi
   type(error_collection_t)              :: errors
   integer                               :: stat

   call toml_load(doc, 'tests/unit/io/toml/fixtures/ssdi_missing.toml')
   doc_ptr => doc

   irr_ptr => null()
   call get_value(doc_ptr, 'irrigation', irr_ptr, requested=.false., stat=stat)
   @assertTrue(associated(irr_ptr))

   call read_irrigation_ssdi_toml(irr_ptr, ssdi, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(0, ssdi%schedule)
   @assertFalse(allocated(ssdi%fixed%events_file))
   @assertEqual(0, ssdi%scheduled%sched_type)
end subroutine test_read_ssdi_missing_block_keeps_defaults
