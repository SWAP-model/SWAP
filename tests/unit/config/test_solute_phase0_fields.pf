! Allocation-shape tests for the allocatable arrays in solute_config_t
! (per-layer kf/decpot/fdepth and the 2D cseeptab). The per-scalar
! default-zero and default-unallocated tests that once lived here were removed
! 2026-07-05: they only asserted compiler default-initialisation, not SWAP
! behaviour. Field parsing/range validation is covered by
! test_read_solute_toml.pf and test_solute_config.pf.

@test
subroutine test_solute_config_per_layer_array_allocation()
   use funit
   use iso_fortran_env, only: real64
   use solute_config_mod, only: solute_config_t
   type(solute_config_t) :: cfg
   integer, parameter :: NLAYERS = 5

   allocate(cfg%kf(NLAYERS));     cfg%kf     = 0.0_real64
   allocate(cfg%decpot(NLAYERS)); cfg%decpot = 0.0_real64
   allocate(cfg%fdepth(NLAYERS)); cfg%fdepth = 0.0_real64

   @assertTrue(allocated(cfg%kf))
   @assertEqual(NLAYERS, size(cfg%kf))
   @assertEqual(NLAYERS, size(cfg%decpot))
   @assertEqual(NLAYERS, size(cfg%fdepth))
end subroutine

@test
subroutine test_solute_config_cseeptab_2d_allocation()
   use funit
   use iso_fortran_env, only: real64
   use solute_config_mod, only: solute_config_t
   type(solute_config_t) :: cfg

   allocate(cfg%cseeptab(10, 2));  cfg%cseeptab = 0.0_real64

   @assertTrue(allocated(cfg%cseeptab))
   @assertEqual(10, size(cfg%cseeptab, 1))
   @assertEqual(2,  size(cfg%cseeptab, 2))
end subroutine
