   call load_both_for_hupselbrook(config, errors)

   @assertEqual(swsophy, config%soil%swsophy)
   @assertEqual(swhyst,  config%soil%swhyst)
   @assertEqual(swinco,  config%soil%swinco)
   @assertEqual(gwli,    config%soil%gwli,    1.0d-9)
end subroutine

