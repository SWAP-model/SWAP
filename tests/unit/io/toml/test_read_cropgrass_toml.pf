@test
subroutine test_read_cropgrass_mowing_full()
   use funit
   use tomlf, only: toml_table, toml_load
   use cropgrass_config_mod
   use read_cropgrass_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(cropgrass_config_t)              :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/cropgrass_mowing_full.toml')
   doc_ptr => doc
   call read_cropgrass_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(2,    c%swharv)
   @assertEqual(4,    c%nmow)
   @assertEqual(0,    c%swdmmow)
   @assertEqual(200,  c%maxdaymow)
   @assertEqual(4500.0d0, c%dmharvest,      1.0d-12)
   @assertEqual(280.0d0,  c%daylastharvest, 1.0d-12)
   @assertEqual(800.0d0,  c%dmlastharvest,  1.0d-12)

   @assertTrue(allocated(c%mowing_dates))
   @assertEqual(4, size(c%mowing_dates))
   @assertEqual(120.0d0, c%mowing_dates(1), 1.0d-12)
   @assertEqual(255.0d0, c%mowing_dates(4), 1.0d-12)

   @assertTrue(allocated(c%mowing_heights))
   @assertEqual(4, size(c%mowing_heights))
   @assertEqual(0.05d0, c%mowing_heights(1), 1.0d-12)
end subroutine

@test
subroutine test_read_cropgrass_grazing_full()
   use funit
   use tomlf, only: toml_table, toml_load
   use cropgrass_config_mod
   use read_cropgrass_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(cropgrass_config_t)              :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/cropgrass_grazing_full.toml')
   doc_ptr => doc
   call read_cropgrass_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1,   c%swgraz)
   @assertEqual(100, c%nstart_graz)
   @assertEqual(270, c%nstop_graz)
   @assertEqual(7,   c%maxdaygrz)
   @assertEqual(0,   c%swdmgrz)
   @assertEqual(1500.0d0, c%dmgrazing, 1.0d-12)
   @assertEqual(800.0d0,  c%tagprest,  1.0d-12)

   @assertTrue(allocated(c%lsdb))
   @assertEqual(3, size(c%lsdb))
   @assertEqual(2.0d0, c%lsdb(2), 1.0d-12)
end subroutine

@test
subroutine test_read_cropgrass_mowing_and_grazing()
   use funit
   use tomlf, only: toml_table, toml_load
   use cropgrass_config_mod
   use read_cropgrass_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(cropgrass_config_t)              :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/cropgrass_mowing_grazing.toml')
   doc_ptr => doc
   call read_cropgrass_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())

   ! Mowing side.
   @assertEqual(2,   c%swharv)
   @assertEqual(3,   c%nmow)
   @assertTrue(allocated(c%mowing_dates))
   @assertEqual(3, size(c%mowing_dates))
   @assertEqual(180.0d0, c%mowing_dates(2), 1.0d-12)
   @assertTrue(allocated(c%mowing_heights))
   @assertEqual(0.06d0, c%mowing_heights(3), 1.0d-12)

   ! Grazing side.
   @assertEqual(1,   c%swgraz)
   @assertEqual(110, c%nstart_graz)
   @assertEqual(260, c%nstop_graz)
   @assertEqual(1,   c%swdmgrz)
   @assertEqual(1400.0d0, c%dmgrazing, 1.0d-12)
   @assertTrue(allocated(c%lsdb))
   @assertEqual(3, size(c%lsdb))
   @assertEqual(1.8d0, c%lsdb(2), 1.0d-12)
end subroutine

@test
subroutine test_read_cropgrass_new_fields_absent_silent()
   ! Reuse cropgrass_minimal.toml: it has [mowing] and [grazing] but
   ! none of the Phase 4d additions. Reader must leave new fields at
   ! defaults (scalars zero, allocatable arrays unallocated) without
   ! raising errors.
   use funit
   use tomlf, only: toml_table, toml_load
   use cropgrass_config_mod
   use read_cropgrass_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(cropgrass_config_t)              :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/cropgrass_minimal.toml')
   doc_ptr => doc
   call read_cropgrass_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())

   @assertEqual(0, c%swdmmow)
   @assertEqual(0, c%maxdaymow)
   @assertEqual(0.0d0, c%dmharvest,      1.0d-12)
   @assertEqual(0.0d0, c%daylastharvest, 1.0d-12)
   @assertEqual(0.0d0, c%dmlastharvest,  1.0d-12)
   @assertFalse(allocated(c%mowing_dates))
   @assertFalse(allocated(c%mowing_heights))

   @assertEqual(0, c%maxdaygrz)
   @assertEqual(0, c%swdmgrz)
   @assertEqual(0.0d0, c%dmgrazing, 1.0d-12)
   @assertEqual(0.0d0, c%tagprest,  1.0d-12)
   @assertFalse(allocated(c%lsdb))
end subroutine
