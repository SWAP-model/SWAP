end subroutine

@test
subroutine test_surfacewater_crop_rotation_parity()
   use funit
   use variables, only: swCrop
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer :: i, n_rot

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/6.surfacewater')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call readswap()
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/6.surfacewater/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   @assertEqual(swCrop, config%crop%swcrop)

   ! Case 6 has 3 rotation entries (1997-1999), all type 1 (fixed crop).
   n_rot = size(config%crop%rotation_type)
   @assertEqual(3, n_rot)
   do i = 1, n_rot
      @assertEqual(1, config%crop%rotation_type(i))
   end do
end subroutine

! Phase 4c-a Task 18: parity for the last type-1 (grass.crp) rotation entry.
! readswap() populates only the top-level crop rotation metadata; per-crop
! field globals (hlim*, rdi, rri, rdc) are set by the per-crop reader during
! simulation, not by readswap().  Therefore we compare the loaded grass.crp.toml
! config against the known literal values from grass.crp rather than against
! variables module globals.
!
! case 6 grass.crp reference values (type 1 fixed simple grass):
!   IDEV=1  LCC=366  KDIF=0.75  KDIR=0.75
!   HLIM1=0.0  HLIM2U=0.0  HLIM2L=0.0  (SWOXYGEN=0: oxygen-stress hlim not active)
!   HLIM3H=-200.0  HLIM3L=-800.0  HLIM4=-8000.0  ADCRH=0.5  ADCRL=0.1
!   RDI=30.0  RRI=0.0  RDC=30.0  (SWRD=1, constant 30 cm from RDTB)
!   COFAB=0.25
@test
subroutine test_surfacewater_fixed_data_hardcoded_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer  :: i, n_rot, last_fixed_idx
   integer  :: c_idev, c_lcc
   real(8)  :: c_kdif, c_kdir
   real(8)  :: c_hlim1, c_hlim2u, c_hlim2l, c_hlim3h, c_hlim3l, c_hlim4
   real(8)  :: c_adcrh, c_adcrl
   real(8)  :: c_rdi, c_rri, c_rdc
   real(8)  :: c_cofab

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/6.surfacewater')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call readswap()
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/6.surfacewater/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! Locate the last type-1 entry in the rotation.
   n_rot = size(config%crop%rotation_type)
   last_fixed_idx = 0
   do i = n_rot, 1, -1
      if (config%crop%rotation_type(i) == 1) then
         last_fixed_idx = i
         exit
      end if
   end do
   @assertTrue(last_fixed_idx > 0)

   ! Sanity check: all 3 rotation entries are type 1; last is index 3.
   @assertEqual(3, last_fixed_idx)

   ! Copy struct components into plain locals.
   c_idev   = config%crop%rotation_fixed(last_fixed_idx)%idev
   c_lcc    = config%crop%rotation_fixed(last_fixed_idx)%lcc
   c_kdif   = config%crop%rotation_fixed(last_fixed_idx)%kdif
   c_kdir   = config%crop%rotation_fixed(last_fixed_idx)%kdir
   c_hlim1  = config%crop%rotation_fixed(last_fixed_idx)%hlim1
   c_hlim2u = config%crop%rotation_fixed(last_fixed_idx)%hlim2u
   c_hlim2l = config%crop%rotation_fixed(last_fixed_idx)%hlim2l
   c_hlim3h = config%crop%rotation_fixed(last_fixed_idx)%hlim3h
   c_hlim3l = config%crop%rotation_fixed(last_fixed_idx)%hlim3l
   c_hlim4  = config%crop%rotation_fixed(last_fixed_idx)%hlim4
   c_adcrh  = config%crop%rotation_fixed(last_fixed_idx)%adcrh
   c_adcrl  = config%crop%rotation_fixed(last_fixed_idx)%adcrl
   c_rdi    = config%crop%rotation_fixed(last_fixed_idx)%rdi
   c_rri    = config%crop%rotation_fixed(last_fixed_idx)%rri
   c_rdc    = config%crop%rotation_fixed(last_fixed_idx)%rdc
   c_cofab  = config%crop%rotation_fixed(last_fixed_idx)%cofab

   ! Phenology (literal values from grass.crp).
   @assertEqual(1,   c_idev)
   @assertEqual(366, c_lcc)

   ! Light extinction (literal values from grass.crp).
   @assertEqual(0.75d0, c_kdif, 1.0d-9)
   @assertEqual(0.75d0, c_kdir, 1.0d-9)

   ! Feddes water-stress parameters (literal values from grass.crp).
   ! SWOXYGEN=0: hlim1/hlim2u/hlim2l are not active; TOML defaults to 0.
   @assertEqual(    0.0d0, c_hlim1,  1.0d-9)
   @assertEqual(    0.0d0, c_hlim2u, 1.0d-9)
   @assertEqual(    0.0d0, c_hlim2l, 1.0d-9)
   @assertEqual( -200.0d0, c_hlim3h, 1.0d-9)
   @assertEqual( -800.0d0, c_hlim3l, 1.0d-9)
   @assertEqual(-8000.0d0, c_hlim4,  1.0d-9)
   @assertEqual(    0.5d0, c_adcrh,  1.0d-9)
   @assertEqual(    0.1d0, c_adcrl,  1.0d-9)

   ! Root growth parameters (literal values from grass.crp).
   ! SWRD=1: root depth from RDTB table (constant 30 cm); rri=0.0 (no daily increase).
   @assertEqual(  30.0d0, c_rdi, 1.0d-9)
   @assertEqual(   0.0d0, c_rri, 1.0d-9)
   @assertEqual(  30.0d0, c_rdc, 1.0d-9)

   ! Interception (literal values from grass.crp: COFAB=0.25).
   @assertEqual(0.25d0, c_cofab, 1.0d-9)
end subroutine
