! SS-A literal-parity test for case 1 (hupselbrook).
!
! Each subtest now asserts swap_config_t fields against literal values
! captured once via the legacy `readswap()` pipeline. After SS-A, no
! parity test invokes `readswap` or any legacy helper.
!
! Scope: existing-schema fields only — see ADR 0014.
!
! Test names and intent are preserved from the pre-conversion suite.

@test
subroutine test_hupselbrook_parity_general()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual('hupsel', trim(config%general%project))
   @assertEqual('./',     trim(config%general%pathwork))
   @assertEqual('./',     trim(config%general%pathatm))
   @assertEqual('./',     trim(config%general%pathcrop))
   @assertEqual('./',     trim(config%general%pathdrain))
   @assertEqual(0,        config%general%swscre)
end subroutine

@test
subroutine test_hupselbrook_parity_simulation()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(37256.0_real64, config%simulation%tstart, 1.0d-9)
   @assertEqual(38351.0_real64, config%simulation%tend,   1.0d-9)
   @assertEqual(1,              config%simulation%nprintday)
end subroutine

