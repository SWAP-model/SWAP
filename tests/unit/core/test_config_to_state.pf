@test
subroutine test_adapter_populates_project()
   use funit
   use swap_config_mod
   use swap_state_mod
   use config_to_state_mod
   type(swap_config_t) :: config
   type(swap_state_t)  :: state

   config%general%project = "hupsel"
   call swap_state_init(state, 1, 1)
   call config_to_state(config, state)

   @assertEqual("hupsel", trim(state%time%project))
end subroutine

@test
subroutine test_adapter_populates_dates()
   use funit
   use swap_config_mod
   use swap_state_mod
   use config_to_state_mod
   type(swap_config_t) :: config
   type(swap_state_t)  :: state

   config%simulation%tstart = 37255.0d0
   config%simulation%tend   = 38350.0d0
   call swap_state_init(state, 1, 1)
   call config_to_state(config, state)

   @assertEqual(37255.0d0, state%time%tstart, 1.0d-12)
   @assertEqual(38350.0d0, state%time%tend,   1.0d-12)
end subroutine

@test
subroutine test_adapter_populates_meteo()
   use funit
   use swap_config_mod
   use swap_state_mod
   use config_to_state_mod
   type(swap_config_t) :: config
   type(swap_state_t)  :: state

   config%meteo%lat       = 52.0d0
   config%meteo%alt       = 10.0d0
   config%meteo%altw      = 2.0d0
   config%meteo%angstroma = 0.25d0
   call swap_state_init(state, 1, 1)
   call config_to_state(config, state)

   @assertEqual(52.0d0,  state%atm%lat,       1.0d-12)
   @assertEqual(10.0d0,  state%atm%alt,       1.0d-12)
   @assertEqual(2.0d0,   state%atm%altw,      1.0d-12)
   @assertEqual(0.25d0,  state%atm%angstroma, 1.0d-12)
end subroutine

@test
subroutine test_adapter_populates_drainage()
   use funit
   use swap_config_mod
   use swap_state_mod
   use config_to_state_mod
   type(swap_config_t) :: config
   type(swap_state_t)  :: state

   config%drain%dramet = 2
   config%drain%swdivd = 1
   config%drain%nrlevs = 1
   call swap_state_init(state, 1, 1)
   call config_to_state(config, state)

   @assertEqual(2, state%drain%dramet)
   @assertEqual(1, state%drain%swdivd)
   @assertEqual(1, state%drain%nrlevs)
end subroutine
