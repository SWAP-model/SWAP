! SS-A literal-parity test for case 5 (salinitystress).
!
! Each subtest now asserts swap_config_t fields against literal values
! captured once via the legacy `readswap()` pipeline. After SS-A, no
! parity test invokes `readswap` or any legacy helper.
!
! Case 5 highlights: 4 potatod (type-2 WOFOST) rotation entries 2012-2015,
! dramet=3 (multi-level drainage), and SWSALINITY=1 (Maas-Hoffman) active in
! the .crp - this is the regression case for the salinity-stress branch.
!
! Note: the per-rotation init-parity test (test_salinitystress_wofost_init_parity)
! was deleted in SS-A: coverage of cropwofost_init globals (swsalinity,
! saltmax, saltslope, cumdens, etc.) is preserved by
! tests/unit/crop/test_cropwofost_init.pf.

@test
subroutine test_salinitystress_parity_general()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/salinitystress/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual('saltfarmtexel', trim(config%general%project))
   @assertEqual('tests/regression/cases/salinitystress/toml/', trim(config%general%pathwork))
   @assertEqual('tests/regression/cases/salinitystress/toml/', trim(config%general%pathatm))
   @assertEqual('tests/regression/cases/salinitystress/toml/', trim(config%general%pathcrop))
   @assertEqual('tests/regression/cases/salinitystress/toml/', trim(config%general%pathdrain))
   @assertEqual(0,               config%general%swscre)
end subroutine

@test
subroutine test_salinitystress_parity_simulation()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/salinitystress/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(40908.0_real64, config%simulation%tstart, 1.0d-9)
   @assertEqual(42368.0_real64, config%simulation%tend,   1.0d-9)
   @assertEqual(1,              config%simulation%nprintday)
end subroutine

@test
subroutine test_salinitystress_parity_simulation_numerical()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/salinitystress/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(1.0e-6_real64, config%simulation%numerical%dtmin, 1.0e-12_real64)
   @assertEqual(0.04_real64,   config%simulation%numerical%dtmax, 1.0e-12_real64)
   @assertEqual(30,            config%simulation%numerical%MaxIt)
   @assertEqual(3,             config%simulation%numerical%MaxBackTr)
end subroutine

@test
subroutine test_salinitystress_parity_meteorology()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/salinitystress/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! TOML pipeline is CSV-only (ADR 0014). Compare basename only.
   @assertEqual('235', trim(config%meteo%metfile(1:index(config%meteo%metfile,'.')-1)))
   @assertEqual(52.928_real64, config%meteo%lat,       1.0d-9)
   @assertEqual(1.2_real64,    config%meteo%alt,       1.0d-9)
   @assertEqual(10.0_real64,   config%meteo%altw,      1.0d-9)
   @assertEqual(0,             config%meteo%swetr)
   @assertEqual(1,             config%meteo%swdivide)
   @assertEqual(2,             config%meteo%swrain)
   @assertEqual(0.25_real64,   config%meteo%angstroma, 1.0d-9)
   @assertEqual(0.50_real64,   config%meteo%angstromb, 1.0d-9)
end subroutine

@test
subroutine test_salinitystress_parity_drainage()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/salinitystress/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(3, config%drain%dramet)
   @assertEqual(1, config%drain%swdivd)
   @assertEqual(0, config%drain%swdislay)
   ! dramet=3, finalize does NOT clamp nrlevs; value from file (2) preserved.
   @assertEqual(2, config%drain%nrlevs)
end subroutine

@test
subroutine test_salinitystress_parity_soil()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/salinitystress/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(0,            config%soil%swsophy)
   @assertEqual(0,            config%soil%swhyst)
   ! Phase 4d: SWINCO=3 with [soil.initial] CSV companions.
   @assertEqual(3,            config%soil%swinco)
   ! TOML literal carries gwli even when swinco=3 (legacy reads from INIFIL).
   @assertEqual(-90.0_real64, config%soil%gwli,   1.0d-9)
   @assertEqual(0,            config%soil%swmacro)
   @assertEqual(0.2_real64,   config%soil%pondmx, 1.0d-9)
end subroutine

@test
subroutine test_salinitystress_parity_crop_meta()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer :: i, n_rot

   call load_swap_config('tests/regression/cases/salinitystress/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(1, config%crop%swcrop)

   ! Case 5 has 4 rotation entries (2012-2015), all type 2 (WOFOST potato).
   n_rot = size(config%crop%rotation_type)
   @assertEqual(4, n_rot)
   do i = 1, n_rot
      @assertEqual(2, config%crop%rotation_type(i))
   end do
end subroutine

! Phase 4c-b Task 12: full WOFOST parity for the first (icrop=1) potatod
! rotation entry of salinitystress. Case 5 headline: SWSALINITY=1 activates
! the Maas-Hoffman branch with SALTMAX=0.732, SALTSLOPE=0.0868.
!
! SS-A note: large-array assertions (dtsmtb 30, slatb 30, amaxtb, frtb,
! fltb, fstb, fotb) were dropped per Decision 2 — coverage relocated to/
! already in tests/unit/io/toml/test_read_cropwofost_toml.pf which exercises
! the TOML reader directly on these tables.
@test
subroutine test_salinitystress_parity_potatod_wofost()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64

   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer, parameter       :: ICROP_POTATOD = 1

   call load_swap_config('tests/regression/cases/salinitystress/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! germination (swgerm=0)
   @assertEqual(0, config%crop%rotation_wofost(ICROP_POTATOD)%germination%swgerm)

   ! harvest (case 5: dvsend=3.0)
   @assertEqual(3.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%harvest%dvsend, 1.0e-12_real64)
   @assertEqual(0,          config%crop%rotation_wofost(ICROP_POTATOD)%harvest%swharv)

   ! crop_factor (swcf=2)
   @assertEqual(2,             config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%swcf)
   @assertEqual(0.19_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%albedo, 1.0e-12_real64)
   @assertEqual(207.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%rsc,    1.0e-12_real64)
   @assertEqual(0.0_real64,    config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%rsw,    1.0e-12_real64)

   ! phenology
   @assertEqual(0,              config%crop%rotation_wofost(ICROP_POTATOD)%phenology%idsl)
   @assertEqual(150.0_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%phenology%tsumea, 1.0e-12_real64)
   @assertEqual(1550.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%phenology%tsumam, 1.0e-12_real64)

   ! initial
   @assertEqual(75.0_real64,    config%crop%rotation_wofost(ICROP_POTATOD)%initial%tdwi,   1.0e-12_real64)
   @assertEqual(0.0589_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%initial%laiem,  1.0e-12_real64)
   @assertEqual(0.012_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%initial%rgrlai, 1.0e-12_real64)

   ! green_area
   @assertEqual(0.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%green_area%spa,   1.0e-12_real64)
   @assertEqual(0.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%green_area%ssa,   1.0e-12_real64)
   @assertEqual(37.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%green_area%span,  1.0e-12_real64)
   @assertEqual(2.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%green_area%tbase, 1.0e-12_real64)

   ! assimilation
   @assertEqual(1.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%kdif, 1.0e-12_real64)
   @assertEqual(0.75_real64, config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%kdir, 1.0e-12_real64)
   @assertEqual(0.45_real64, config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%eff,  1.0e-12_real64)

   ! conversion / respiration / death
   @assertEqual(0.72_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvl, 1.0e-12_real64)
   @assertEqual(0.85_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvo, 1.0e-12_real64)
   @assertEqual(0.72_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvr, 1.0e-12_real64)
   @assertEqual(0.69_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvs, 1.0e-12_real64)
   @assertEqual(2.0_real64,    config%crop%rotation_wofost(ICROP_POTATOD)%respiration%q10, 1.0e-12_real64)
   @assertEqual(0.03_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rml, 1.0e-12_real64)
   @assertEqual(0.0045_real64, config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rmo, 1.0e-12_real64)
   @assertEqual(0.01_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rmr, 1.0e-12_real64)
   @assertEqual(0.015_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rms, 1.0e-12_real64)
   @assertEqual(0.03_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%death%perdl, 1.0e-12_real64)

   ! root (swrd=2)
   @assertEqual(2,           config%crop%rotation_wofost(ICROP_POTATOD)%root%swrd)
   @assertEqual(10.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%root%rdi,    1.0e-12_real64)
   @assertEqual(1.2_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%root%rri,    1.0e-12_real64)
   @assertEqual(50.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%root%rdc,    1.0e-12_real64)
   @assertEqual(1,           config%crop%rotation_wofost(ICROP_POTATOD)%root%swdmi2rd)

   ! oxygen_stress (swoxygen=1)
   @assertEqual(1,             config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%swoxygen)
   @assertEqual(1,             config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%swwrtnonox)
   @assertEqual(0.5_real64,    config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%aeratecrit, 1.0e-12_real64)
   @assertEqual(-10.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%hlim1,      1.0e-12_real64)
   @assertEqual(-25.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%hlim2u,     1.0e-12_real64)
   @assertEqual(-25.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%hlim2l,     1.0e-12_real64)

   ! drought_stress
   @assertEqual(1,               config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%swdrought)
   @assertEqual(-300.0_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%hlim3h, 1.0e-12_real64)
   @assertEqual(-500.0_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%hlim3l, 1.0e-12_real64)
   @assertEqual(-10000.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%hlim4,  1.0e-12_real64)
   @assertEqual(0.5_real64,      config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%adcrh,  1.0e-12_real64)
   @assertEqual(0.1_real64,      config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%adcrl,  1.0e-12_real64)

   ! salinity (CASE 5 HEADLINE: swsalinity=1 -> Maas-Hoffman branch active)
   @assertEqual(1,             config%crop%rotation_wofost(ICROP_POTATOD)%salinity%swsalinity)
   @assertEqual(0.732_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%salinity%saltmax,   1.0e-12_real64)
   @assertEqual(0.0868_real64, config%crop%rotation_wofost(ICROP_POTATOD)%salinity%saltslope, 1.0e-12_real64)

   ! compensate / interception
   @assertEqual(0,             config%crop%rotation_wofost(ICROP_POTATOD)%compensate%swcompensate)
   @assertEqual(1,             config%crop%rotation_wofost(ICROP_POTATOD)%interception%swinter)
   @assertEqual(0.25_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%interception%cofab, 1.0e-12_real64)

   ! co2 (case 5: swco2=0)
   @assertEqual(0, config%crop%rotation_wofost(ICROP_POTATOD)%co2%swco2)
end subroutine

! Phase 4d Task 20e: parity for the four new sections — bottom_boundary,
! heat, irrigation, solute — added to the case 5 swap.toml in Task 17.
! Case 5 headline: SWBOTB=3 (sinus aquifer scalars), SWSOLU=1 with
! Maas-Hoffman, SWHEA=1, SWIRFIX=1 with external file.
@test
subroutine test_salinitystress_parity_4d_sections()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/regression/cases/salinitystress/toml/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! [bottom_boundary] — case 5 SWBOTB=3 with the SW3=1 sinus branch.
   @assertEqual(3,             config%bottom_boundary%swbotb)
   @assertEqual(0.79_real64,   config%bottom_boundary%shape,  1.0e-12_real64)
   @assertEqual(-110.0_real64, config%bottom_boundary%hdrain, 1.0e-12_real64)
   @assertEqual(50.0_real64,   config%bottom_boundary%rimlay, 1.0e-12_real64)
   @assertEqual(-120.0_real64, config%bottom_boundary%aqave,  1.0e-12_real64)
   @assertEqual(20.0_real64,   config%bottom_boundary%aqamp,  1.0e-12_real64)
   @assertEqual(365.0_real64,  config%bottom_boundary%aqper,  1.0e-12_real64)
   @assertEqual(120.0_real64,  config%bottom_boundary%aqtmax, 1.0e-12_real64)

   ! [heat] — case 5 SWHEA=1 with numerical method (SWCALT=2).
   @assertEqual(1, config%heat%swhea)
   @assertEqual(2, config%heat%swcalt)
   @assertEqual(1, config%heat%swtopbhea)
   @assertEqual(1, config%heat%swbotbhea)
   @assertTrue(allocated(config%heat%psand))
   @assertTrue(allocated(config%heat%tsoil_init))

   ! [irrigation] — case 5 SWIRFIX=1, irgfil="swap" (external swap.irg).
   @assertEqual(1, config%irrigation%swirfix)
   @assertTrue(allocated(config%irrigation%irgfil))

   ! [solute] — case 5 SWSOLU=1 with Maas-Hoffman salinity stress.
   @assertEqual(1,             config%solute%swsolu)
   @assertEqual(1,             config%solute%swbotbc)
   @assertEqual(1.051_real64,  config%solute%cdrain, 1.0e-12_real64)
   @assertEqual(15.574_real64, config%solute%cseep,  1.0e-12_real64)
   @assertEqual(0.5_real64,    config%solute%tscf,   1.0e-12_real64)
   ! Reconstructed case 5 TOML uses a scalar ldis = 5.0 (not a per-layer array).
   @assertEqual(5.0_real64,    config%solute%ldis, 1.0e-12_real64)
end subroutine
