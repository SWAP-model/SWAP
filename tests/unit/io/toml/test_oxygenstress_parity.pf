! SS-A literal-parity test for case 4 (oxygenstress).
!
! Each subtest now asserts swap_config_t fields against literal values
! captured once via the legacy `readswap()` pipeline. After SS-A, no
! parity test invokes `readswap` or any legacy helper.
!
! grassd.crp reference values for case 4 (same as case 2 grassgrowth):
!   HLIM1=0.0  HLIM2U=1.0  HLIM2L=-1.0  HLIM3H=-200.0  HLIM3L=-800.0
!   HLIM4=-8000.0  RDI=10.0  RRI=1.0  RDC=40.0
!
! Case 4 uses swoxygen=2 (Bartholomeus). Legacy readgrass only reads
! hlim3h/hlim3l/hlim4 in this branch; the Feddes-only fields hlim1/hlim2u/
! hlim2l stay at 0 (legacy never reads them) but the TOML pipeline reads
! them verbatim. Only assert the fields legacy populated for case 4.
!
! Note: the per-rotation init-parity test (test_oxygenstress_grass_init_parity)
! was deleted in SS-A: coverage of cropgrass_init globals (kdif, srl,
! alphacrit, cumdens) is preserved by tests/unit/crop/test_cropgrass_init.pf.

@test
subroutine test_oxygenstress_general_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual('zegveld', trim(config%general%project))
   @assertEqual('tests/swap-cases/toml/4.oxygenstress/', trim(config%general%pathwork))
   @assertEqual('tests/swap-cases/toml/4.oxygenstress/', trim(config%general%pathatm))
   @assertEqual('tests/swap-cases/toml/4.oxygenstress/', trim(config%general%pathcrop))
   @assertEqual('tests/swap-cases/toml/4.oxygenstress/', trim(config%general%pathdrain))
   @assertEqual(0,         config%general%swscre)
end subroutine

@test
subroutine test_oxygenstress_simulation_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(33969.0_real64, config%simulation%tstart, 1.0d-9)
   @assertEqual(37620.0_real64, config%simulation%tend,   1.0d-9)
   @assertEqual(1,              config%simulation%nprintday)
end subroutine

@test
subroutine test_oxygenstress_simulation_numerical_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(1.0e-6_real64, config%simulation%numerical%dtmin, 1.0e-12_real64)
   @assertEqual(0.04_real64,   config%simulation%numerical%dtmax, 1.0e-12_real64)
   @assertEqual(30,            config%simulation%numerical%MaxIt)
   @assertEqual(3,             config%simulation%numerical%MaxBackTr)
end subroutine

@test
subroutine test_oxygenstress_meteorology_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! TOML pipeline is CSV-only (ADR 0014). Compare basename only.
   @assertEqual('260', trim(config%meteo%metfile(1:index(config%meteo%metfile,'.')-1)))
   @assertEqual(52.1_real64,  config%meteo%lat,       1.0d-9)
   @assertEqual(1.9_real64,   config%meteo%alt,       1.0d-9)
   @assertEqual(10.0_real64,  config%meteo%altw,      1.0d-9)
   @assertEqual(0,            config%meteo%swetr)
   @assertEqual(1,            config%meteo%swdivide)
   @assertEqual(2,            config%meteo%swrain)
   @assertEqual(0.25_real64,  config%meteo%angstroma, 1.0d-9)
   @assertEqual(0.50_real64,  config%meteo%angstromb, 1.0d-9)
end subroutine

@test
subroutine test_oxygenstress_drainage_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(3, config%drain%dramet)
   @assertEqual(1, config%drain%swdivd)
   @assertEqual(0, config%drain%swdislay)
   ! dramet=3, finalize does NOT clamp nrlevs to 1; value from file (2) is preserved.
   @assertEqual(2, config%drain%nrlevs)
end subroutine

@test
