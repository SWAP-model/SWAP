@test
subroutine test_grassgrowth_crop_rotation_parity()
   use funit
   use variables, only: swCrop
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer :: i, n_rot

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/2.grassgrowth/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   @assertEqual(swCrop, config%crop%swcrop)

   ! Case 2 has 5 rotation entries, all type 3 (WOFOST grass).
   n_rot = size(config%crop%rotation_type)
   @assertEqual(5, n_rot)
   do i = 1, n_rot
      @assertEqual(3, config%crop%rotation_type(i))
   end do
end subroutine

! Phase 4c-b Task 14b: parity for the last type-3 (grassd) rotation entry of
! case 2.grassgrowth. Drive readgrass directly via the legacy_crop_helper
! bridge and cross-check `variables` globals against config%crop%rotation_grass.
!
! Case 2 grassd.crp has SWRD=2, so readgrass reads rdi/rri/rdc as scalars
! (readswap.f90 lines ~3870 in the readgrass swrd=2 branch).
@test
subroutine test_grassgrowth_grass_data_parity()
   use funit
   use variables, only: &
      hlim1, hlim2u, hlim2l, hlim3h, hlim3l, hlim4, rdi, rri, rdc
   use legacy_crop_helper_mod, only: read_legacy_grass
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer  :: i, n_rot, last_grass_idx
   integer, parameter :: ICROP_GRASSD = 5

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/2.grassgrowth/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! Locate the last type-3 entry in the rotation.
   n_rot = size(config%crop%rotation_type)
   last_grass_idx = 0
   do i = n_rot, 1, -1
      if (config%crop%rotation_type(i) == 3) then
         last_grass_idx = i
         exit
      end if
   end do
   @assertTrue(last_grass_idx > 0)

   ! Sanity check: all 5 rotation entries are type 3; last is index 5.
   @assertEqual(ICROP_GRASSD, last_grass_idx)

   ! Drive the legacy readgrass from inside the case directory.
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call read_legacy_grass(ICROP_GRASSD, 'grassd')
   call chdir_to(trim(orig_cwd))

   ! Feddes water-stress parameters (swoxygen=1 → hlim1/2u/2l populated).
   @assertEqual(hlim1,  config%crop%rotation_grass(ICROP_GRASSD)%hlim1,  1.0e-12_real64)
   @assertEqual(hlim2u, config%crop%rotation_grass(ICROP_GRASSD)%hlim2u, 1.0e-12_real64)
   @assertEqual(hlim2l, config%crop%rotation_grass(ICROP_GRASSD)%hlim2l, 1.0e-12_real64)
   @assertEqual(hlim3h, config%crop%rotation_grass(ICROP_GRASSD)%hlim3h, 1.0e-12_real64)
   @assertEqual(hlim3l, config%crop%rotation_grass(ICROP_GRASSD)%hlim3l, 1.0e-12_real64)
   @assertEqual(hlim4,  config%crop%rotation_grass(ICROP_GRASSD)%hlim4,  1.0e-12_real64)

   ! Root growth (swrd=2 → rdi/rri/rdc populated).
   @assertEqual(rdi, config%crop%rotation_grass(ICROP_GRASSD)%rdi, 1.0e-12_real64)
   @assertEqual(rri, config%crop%rotation_grass(ICROP_GRASSD)%rri, 1.0e-12_real64)
   @assertEqual(rdc, config%crop%rotation_grass(ICROP_GRASSD)%rdc, 1.0e-12_real64)
end subroutine

! Phase 4d Task 20b: parity for the four new sections — bottom_boundary,
! heat, irrigation, solute — added to the case 2 swap.toml in Task 17.
@test
subroutine test_grassgrowth_parity_4d_sections()
   use funit
   use variables, only: swbotb, swhea, swcalt, swtopbhea, swbotbhea, &
                        swirfix, swsolu
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/2.grassgrowth/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! [bottom_boundary] — case 2 SWBOTB=1 (gwl_file branch).
   @assertEqual(swbotb, config%bottom_boundary%swbotb)
   @assertTrue(allocated(config%bottom_boundary%gwl_file))
   @assertEqual("grassgrowth.gwl.csv", config%bottom_boundary%gwl_file)

   ! [heat] — case 2 SWHEA=1 with numerical method (SWCALT=2).
   @assertEqual(swhea,     config%heat%swhea)
   @assertEqual(swcalt,    config%heat%swcalt)
   @assertEqual(swtopbhea, config%heat%swtopbhea)
   @assertEqual(swbotbhea, config%heat%swbotbhea)
   ! READING NOTE: per-layer arrays psand/pclay/porg deferred to a future
   ! flatten-style helper (variables side is fixed-size `(maho)`).
   @assertTrue(allocated(config%heat%psand))
   @assertTrue(allocated(config%heat%tsoil_init))

   ! [irrigation] — case 2 SWIRFIX=0 (no irrigation).
   @assertEqual(swirfix, config%irrigation%swirfix)

   ! [solute] — case 2 SWSOLU=0 (no solute transport).
   @assertEqual(swsolu, config%solute%swsolu)
end subroutine

! Phase 4d Task 20b: grass mowing + grazing parity for case 2 grassd.crp.
! Drives the legacy readgrass via the read_legacy_grass_with_mowing wrapper
! so the OUT-arg fields (swharvest, dmharvest, ..., dmgrazing, tagprest) can
! be cross-checked against config%crop%rotation_grass(ICROP_GRASSD).
@test
subroutine test_grassgrowth_parity_grass_mowing_grazing()
   use funit
   use legacy_crop_helper_mod, only: read_legacy_grass_with_mowing
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer, parameter :: ICROP_GRASSD = 5
   integer :: swharvest, swdmmow, swdmgrz
   integer :: daylastharvest, maxdaymow, maxdaygrz
   real(8) :: dmharvest, dmlastharvest, dmgrazing, tagprest

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/2.grassgrowth/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! Drive the legacy readgrass from inside the case directory.
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call read_legacy_grass_with_mowing(ICROP_GRASSD, 'grassd',                &
                                      swharvest, dmharvest,                  &
                                      daylastharvest, dmlastharvest,         &
                                      swdmmow, maxdaymow,                    &
                                      swdmgrz, maxdaygrz,                    &
                                      dmgrazing, tagprest)
   call chdir_to(trim(orig_cwd))

   ! Mowing scalars (case 2 SWHARVEST=2, fixed-date branch).
   @assertEqual(swharvest, config%crop%rotation_grass(ICROP_GRASSD)%swharv)
   ! READING NOTE: case 2 SWHARVEST=2 (fixed-date mowing). Legacy readgrass
   ! only reads `swdmmow`/`dmharvest`/`daylastharvest`/`dmlastharvest`/
   ! `maxdaymow` inside the swharvest=1 branch (readswap.f90 lines 3995-4002),
   ! so for case 2 these globals stay at 0 even though the TOML carries
   ! the values verbatim. Skipped here; covered by the case 4 grass test
   ! (SWHARVEST=1 path).

   ! READING NOTE: case 2 SEQGRAZMOW = all-2 (mowing-only sequence) so the
   ! legacy `swGrz` flag is .false. and the entire grazing block in
   ! readgrass (readswap.f90 lines 3910-3982) is skipped — every grazing
   ! global stays at 0 even though the TOML carries swgraz=1, dmgrazing,
   ! tagprest, etc. verbatim. Cross-checks for swdmgrz / maxdaygrz /
   ! dmgrazing / tagprest / nstart_graz / nstop_graz deferred to case 4
   ! (SEQGRAZMOW mixes 1+2 there, exercising the grazing block).
end subroutine

! Phase 3 Task 9: init-parity for case 2 grassd.crp.
! cropgrass_init_from_config must reproduce the same variables-module globals
! as legacy readgrass. Case 2: swoxygen=1, swcompensate=0, swdrought=1 →
! only cumdens branch is active; dateharvest must match 30 fixed mowing dates.
@test
subroutine test_grassgrowth_grass_init_parity()
   use funit
   use variables, only: &
      cumdens, kdif, dateharvest,                                             &
      swoxygen, swdrought, swcompensate,                                      &
      hlim1, hlim2u, hlim2l, hlim3h, hlim3l, hlim4,                         &
      rdi, rri, rdc
   use legacy_crop_helper_mod, only: read_legacy_grass
   use cropgrass_init_mod,     only: cropgrass_init_from_config
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer,  parameter :: ICROP_GRASSD = 5
   real(8) :: legacy_cumdens(202)
   real(8) :: legacy_kdif
   real(8) :: legacy_dateharvest(999)

   ! 1. Load TOML config (populates rotation_grass).
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/2.grassgrowth/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! 2. Call legacy readgrass to populate variables globals.
   ! NOTE: readgrass populates dateharvest from the crp file calendar-date
   ! strings.  The init module reproduces this from the TOML mowing_dates
   ! (DOY floats) anchored to tstart (set by readswap above).
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/2.grassgrowth')
   call read_legacy_grass(ICROP_GRASSD, 'grassd')
   call chdir_to(trim(orig_cwd))

   ! 3. Save key legacy globals.
   legacy_cumdens    = cumdens
   legacy_kdif       = kdif
   legacy_dateharvest = dateharvest

   ! 4. Reset those globals.
   cumdens    = 0.0d0
   kdif       = 0.0d0
   dateharvest = 0.0d0

   ! 5. Call init from config.
   call cropgrass_init_from_config(config%crop%rotation_grass(ICROP_GRASSD), ICROP_GRASSD)

   ! 6. Assert globals match legacy values.
   ! kdif always written.
   @assertEqual(legacy_kdif, kdif, 1.0d-12)
   @assertEqual(0.60d0, kdif, 1.0d-12)
   ! swdrought=1 → cumdens built by init math.
   @assertEqual(legacy_cumdens, cumdens, 1.0d-10)
   ! swharvest=2 → dateharvest populated from mowing_dates.
   ! Assert the first 3 entries match (Task 7 t1900 conversion critical fix).
   @assertEqual(legacy_dateharvest(1), dateharvest(1), 1.0d-10)
   @assertEqual(legacy_dateharvest(2), dateharvest(2), 1.0d-10)
   @assertEqual(legacy_dateharvest(3), dateharvest(3), 1.0d-10)
   ! Feddes parameters (swoxygen=1 → hlim1/2u/2l populated; no srl/alphacrit).
   @assertEqual(hlim1,  config%crop%rotation_grass(ICROP_GRASSD)%hlim1,  1.0d-12)
   @assertEqual(hlim2u, config%crop%rotation_grass(ICROP_GRASSD)%hlim2u, 1.0d-12)
   @assertEqual(hlim2l, config%crop%rotation_grass(ICROP_GRASSD)%hlim2l, 1.0d-12)
   @assertEqual(hlim3h, config%crop%rotation_grass(ICROP_GRASSD)%hlim3h, 1.0d-12)
   @assertEqual(hlim3l, config%crop%rotation_grass(ICROP_GRASSD)%hlim3l, 1.0d-12)
   @assertEqual(hlim4,  config%crop%rotation_grass(ICROP_GRASSD)%hlim4,  1.0d-12)
end subroutine
