@test
subroutine test_cropfixed_hlim2_inverted_under_swoxygen1_fails()
   use funit
   use cropfixed_config_mod, only: cropfixed_config_t
   use error_mod, only: error_collection_t
   type(cropfixed_config_t) :: c
   type(error_collection_t) :: errors
   c%swoxygen = 1
   c%hlim2u = -10.0d0
   c%hlim2l =  -5.0d0   ! INVERTED: hlim2l should be < hlim2u for Feddes
   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

