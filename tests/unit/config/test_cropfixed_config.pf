@test
subroutine test_cropfixed_swrd_two_accepted()
   ! swrd=2 (root extension by max daily increase) is now supported on the
   ! TOML path — the compute kernel was always intact. It must NOT raise a
   ! cross-field stub error.
   use funit
   use cropfixed_config_mod, only: cropfixed_config_t
   use error_mod, only: error_collection_t, ERR_VALIDATION_CROSS_FIELD
   type(cropfixed_config_t) :: c
   type(error_collection_t) :: errors
   integer :: i
   logical :: found
   c%swrd = 2
   call c%validate(errors)
   found = .false.
   do i = 1, errors%count()
      if (errors%items(i)%code == ERR_VALIDATION_CROSS_FIELD .and. &
          index(errors%items(i)%message, 'swrd') > 0) found = .true.
   end do
   @assertFalse(found)
end subroutine

@test
subroutine test_cropfixed_swsalinity_one_rejected()
   ! swsalinity=1 (Maas-Hoffman) kernel is intact, but enabling it for a simple
   ! crop diverges from swap420gf (the salinity->uptake->cml feedback loop), so
   ! it stays gated pending investigation. See dev-docs investigation note.
   use funit
   use cropfixed_config_mod, only: cropfixed_config_t
   use error_mod, only: error_collection_t, ERR_VALIDATION_CROSS_FIELD
   type(cropfixed_config_t) :: c
   type(error_collection_t) :: errors
   integer :: i
   logical :: found
   c%swsalinity = 1
   call c%validate(errors)
   found = .false.
   do i = 1, errors%count()
      if (errors%items(i)%code == ERR_VALIDATION_CROSS_FIELD .and. &
          index(errors%items(i)%message, 'swsalinity') > 0) found = .true.
   end do
   @assertTrue(found)
end subroutine

