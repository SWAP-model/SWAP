@test
subroutine test_oxygenstress_crop_rotation_parity()
   use funit
   use variables, only: swCrop
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer :: i, n_rot

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/4.oxygenstress')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   @assertEqual(swCrop, config%crop%swcrop)

   ! Case 4 has 10 rotation entries (1993-2002), all type 3 (WOFOST grass).
   n_rot = size(config%crop%rotation_type)
   @assertEqual(10, n_rot)
   do i = 1, n_rot
      @assertEqual(3, config%crop%rotation_type(i))
   end do
end subroutine

! Phase 4c-b Task 14c: parity for the last type-3 (grassd) rotation entry of
! case 4.oxygenstress. Drive readgrass directly via the legacy_crop_helper
! bridge and cross-check `variables` globals against config%crop%rotation_grass.
!
! Case 4 grassd.crp has SWRD=2 (same as case 2), so readgrass populates
! rdi/rri/rdc as scalars. Note: case 4 has swdrought=2 (de Jong van Lier),
! but the hlim1/2u/2l/3h/3l/4 fields are still all read by readgrass when
! swoxygen=1, so the parity assertion still holds.
@test
subroutine test_oxygenstress_grass_data_parity()
   use funit
   use variables, only: &
      hlim1, hlim2u, hlim2l, hlim3h, hlim3l, hlim4, rdi, rri, rdc
   use legacy_crop_helper_mod, only: read_legacy_grass
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer  :: i, n_rot, last_grass_idx
   integer, parameter :: ICROP_GRASSD = 10

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/4.oxygenstress')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! Locate the last type-3 entry in the rotation.
   n_rot = size(config%crop%rotation_type)
   last_grass_idx = 0
   do i = n_rot, 1, -1
      if (config%crop%rotation_type(i) == 3) then
         last_grass_idx = i
         exit
      end if
   end do
   @assertTrue(last_grass_idx > 0)

   ! Sanity check: all 10 rotation entries are type 3; last is index 10.
   @assertEqual(ICROP_GRASSD, last_grass_idx)

   ! Drive the legacy readgrass from inside the case directory.
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/4.oxygenstress')
   call read_legacy_grass(ICROP_GRASSD, 'grassd')
   call chdir_to(trim(orig_cwd))

   ! Feddes water-stress parameters (swoxygen=1 → hlim1/2u/2l populated).
   @assertEqual(hlim1,  config%crop%rotation_grass(ICROP_GRASSD)%hlim1,  1.0e-12_real64)
   @assertEqual(hlim2u, config%crop%rotation_grass(ICROP_GRASSD)%hlim2u, 1.0e-12_real64)
   @assertEqual(hlim2l, config%crop%rotation_grass(ICROP_GRASSD)%hlim2l, 1.0e-12_real64)
   @assertEqual(hlim3h, config%crop%rotation_grass(ICROP_GRASSD)%hlim3h, 1.0e-12_real64)
   @assertEqual(hlim3l, config%crop%rotation_grass(ICROP_GRASSD)%hlim3l, 1.0e-12_real64)
   @assertEqual(hlim4,  config%crop%rotation_grass(ICROP_GRASSD)%hlim4,  1.0e-12_real64)

   ! Root growth (swrd=2 → rdi/rri/rdc populated).
   @assertEqual(rdi, config%crop%rotation_grass(ICROP_GRASSD)%rdi, 1.0e-12_real64)
   @assertEqual(rri, config%crop%rotation_grass(ICROP_GRASSD)%rri, 1.0e-12_real64)
   @assertEqual(rdc, config%crop%rotation_grass(ICROP_GRASSD)%rdc, 1.0e-12_real64)
end subroutine

! Phase 4d Task 20c: parity for the four new sections — bottom_boundary,
! heat, irrigation, solute — added to the case 4 swap.toml in Task 17.
@test
subroutine test_oxygenstress_parity_4d_sections()
   use funit
   use variables, only: swbotb, shape, hdrain, rimlay, swhea, swcalt,    &
                        swtopbhea, swbotbhea, swirfix, swsolu
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/4.oxygenstress')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! [bottom_boundary] — case 4 SWBOTB=3 (Cauchy / regional aquifer).
   @assertEqual(swbotb, config%bottom_boundary%swbotb)
   @assertEqual(shape,  config%bottom_boundary%shape,  1.0e-12_real64)
   @assertEqual(hdrain, config%bottom_boundary%hdrain, 1.0e-12_real64)
   @assertEqual(rimlay, config%bottom_boundary%rimlay, 1.0e-12_real64)
   ! READING NOTE: case 4 uses SW3=2 (date-keyed HAQUIF table), not modelled
   ! in current bottom_boundary_config_t (which covers only the SW3=1 sinus
   ! scalars aqave/aqamp/aqper/aqtmax). Deferred to a future phase.

   ! [heat] — case 4 SWHEA=1 with numerical method (SWCALT=2).
   @assertEqual(swhea,     config%heat%swhea)
   @assertEqual(swcalt,    config%heat%swcalt)
   @assertEqual(swtopbhea, config%heat%swtopbhea)
   @assertEqual(swbotbhea, config%heat%swbotbhea)
   ! READING NOTE: per-layer arrays psand/pclay/porg deferred (variable-
   ! length config side vs. fixed-size legacy `(maho)`).
   @assertTrue(allocated(config%heat%psand))
   @assertTrue(allocated(config%heat%tsoil_init))

   ! [irrigation] — case 4 SWIRFIX=0.
   @assertEqual(swirfix, config%irrigation%swirfix)

   ! [solute] — case 4 SWSOLU=0.
   @assertEqual(swsolu, config%solute%swsolu)
end subroutine

! Phase 3 Task 9: init-parity for case 4 grassd.crp.
! cropgrass_init_from_config must reproduce the same variables-module globals
! as legacy readgrass. Case 4: swoxygen=2, swcompensate=1, swdrought=1 →
! all three guarded branches (srl, alphacrit, cumdens) are active.
@test
subroutine test_oxygenstress_grass_init_parity()
   use funit
   use variables, only: &
      cumdens, kdif, srl, alphacrit,                                          &
      swoxygen, swdrought, swcompensate,                                      &
      hlim1, hlim2u, hlim2l, hlim3h, hlim3l, hlim4,                         &
      rdi, rri, rdc
   use legacy_crop_helper_mod, only: read_legacy_grass
   use cropgrass_init_mod,     only: cropgrass_init_from_config
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer,  parameter :: ICROP_GRASSD = 10
   real(8) :: legacy_cumdens(202)
   real(8) :: legacy_kdif, legacy_srl, legacy_alphacrit

   ! 1. Load TOML config (populates rotation_grass).
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/4.oxygenstress')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! 2. Call legacy readgrass to populate variables globals.
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/4.oxygenstress')
   call read_legacy_grass(ICROP_GRASSD, 'grassd')
   call chdir_to(trim(orig_cwd))

   ! 3. Save key legacy globals.
   legacy_cumdens  = cumdens
   legacy_kdif     = kdif
   legacy_srl      = srl
   legacy_alphacrit = alphacrit

   ! 4. Reset those globals.
   cumdens  = 0.0d0
   kdif     = 0.0d0
   srl      = 0.0d0
   alphacrit = 0.0d0

   ! 5. Call init from config.
   call cropgrass_init_from_config(config%crop%rotation_grass(ICROP_GRASSD), ICROP_GRASSD)

   ! 6. Assert globals match legacy values.
   ! swoxygen=2 → srl populated.
   @assertEqual(legacy_kdif,      kdif,      1.0d-12)
   @assertEqual(legacy_srl,       srl,       1.0d-12)
   ! swcompensate=1 → alphacrit populated.
   @assertEqual(legacy_alphacrit, alphacrit, 1.0d-12)
   ! Literal spot-checks (from grassd.crp / TOML).
   @assertEqual(0.60d0,     kdif,      1.0d-12)
   @assertEqual(383571.0d0, srl,       1.0d-12)
   @assertEqual(0.7d0,      alphacrit, 1.0d-12)
   ! Feddes stress parameters (swdrought=1 → hlim3h/3l/4 active).
   @assertEqual(hlim3h, config%crop%rotation_grass(ICROP_GRASSD)%hlim3h, 1.0d-12)
   @assertEqual(hlim3l, config%crop%rotation_grass(ICROP_GRASSD)%hlim3l, 1.0d-12)
   @assertEqual(hlim4,  config%crop%rotation_grass(ICROP_GRASSD)%hlim4,  1.0d-12)
   ! swdrought=1 → cumdens built by init math.
   @assertEqual(legacy_cumdens, cumdens, 1.0d-10)
end subroutine

! Phase 4d Task 20c: grass mowing parity for case 4 grassd.crp.
! Case 4 SEQGRAZMOW = all-2 (mowing-only), SWHARVEST=1 (DM-threshold).
! Mowing block reads swdmmow + maxdaymow; grazing block stays unread.
@test
subroutine test_oxygenstress_parity_grass_mowing()
   use funit
   use legacy_crop_helper_mod, only: read_legacy_grass_with_mowing
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer, parameter :: ICROP_GRASSD = 10
   integer :: swharvest, swdmmow, swdmgrz
   integer :: daylastharvest, maxdaymow, maxdaygrz
   real(8) :: dmharvest, dmlastharvest, dmgrazing, tagprest

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/4.oxygenstress')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap('swap')
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! Drive the legacy readgrass from inside the case directory.
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/4.oxygenstress')
   call read_legacy_grass_with_mowing(ICROP_GRASSD, 'grassd',                &
                                      swharvest, dmharvest,                  &
                                      daylastharvest, dmlastharvest,         &
                                      swdmmow, maxdaymow,                    &
                                      swdmgrz, maxdaygrz,                    &
                                      dmgrazing, tagprest)
   call chdir_to(trim(orig_cwd))

   ! Mowing scalars (case 4 SWHARVEST=1 + swdmmow=2 → maxdaymow read).
   @assertEqual(swharvest, config%crop%rotation_grass(ICROP_GRASSD)%swharv)
   @assertEqual(swdmmow,   config%crop%rotation_grass(ICROP_GRASSD)%swdmmow)
   @assertEqual(maxdaymow, config%crop%rotation_grass(ICROP_GRASSD)%maxdaymow)
   ! READING NOTE: dmharvest/daylastharvest/dmlastharvest are only read
   ! inside the swdmmow=1 sub-branch (readswap.f90 lines 3996-3999); case 4
   ! uses swdmmow=2 so those globals stay at 0 — TOML carries them
   ! verbatim, so a direct legacy↔config compare would fail. Deferred.

   ! READING NOTE: case 4 SEQGRAZMOW = all-2 (mowing-only), so swGrz=.false.
   ! and the entire grazing block (readswap.f90 lines 3910-3982) is skipped.
   ! Grazing globals stay at 0; deferred.
end subroutine
