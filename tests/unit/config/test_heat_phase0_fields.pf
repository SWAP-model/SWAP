! Tests for the 6 physics fields promoted into heat_config_t in
! Phase 0 of the heat state-migration arc. Each scalar gets a
! default-value test; the two allocatable 2D tables get
! default-unallocated + allocation-shape tests.
! See SS-HEAT Phase 0 / 2026-05-10 design spec.

@test
subroutine test_heat_config_ddamp_default_zero()
   use funit
   use iso_fortran_env, only: real64
   use heat_config_mod, only: heat_config_t
   type(heat_config_t) :: cfg
   @assertEqual(0.0_real64, cfg%ddamp, 1.0e-12_real64)
end subroutine

@test
subroutine test_heat_config_tmean_default_zero()
   use funit
   use iso_fortran_env, only: real64
   use heat_config_mod, only: heat_config_t
   type(heat_config_t) :: cfg
   @assertEqual(0.0_real64, cfg%tmean, 1.0e-12_real64)
end subroutine

@test
subroutine test_heat_config_tampli_default_zero()
   use funit
   use iso_fortran_env, only: real64
   use heat_config_mod, only: heat_config_t
   type(heat_config_t) :: cfg
   @assertEqual(0.0_real64, cfg%tampli, 1.0e-12_real64)
