@test
subroutine test_bb_swbotb_out_of_range_fails()
   use funit
   use error_mod
   use bottom_boundary_config_mod
   type(bottom_boundary_config_t) :: c
   type(error_collection_t) :: errors
   c%swbotb = 9
   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_bb_swbotb_zero_skips_validation()
   ! Phase 4d Task 5: swbotb=0 is the "section absent" sentinel. The reader
   ! leaves config at defaults when [bottom_boundary] is missing, so the
   ! validator must short-circuit instead of flagging swbotb=0 as out-of-range.
   ! Remove this no-op once Phase 4d Tasks 17-19 add [bottom_boundary] to
   ! every per-case TOML and a missing section becomes an error.
   use funit
   use error_mod
   use bottom_boundary_config_mod
   type(bottom_boundary_config_t) :: c
   type(error_collection_t) :: errors
   c%swbotb = 0
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_bb_swbotb1_with_bbcfil_passes()
   use funit
   use error_mod
   use bottom_boundary_config_mod
   type(bottom_boundary_config_t) :: c
   type(error_collection_t) :: errors
   c%swbotb = 1
   c%bbcfil = "case.bbc"
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_bb_swbotb1_with_swc_table_passes()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use bottom_boundary_config_mod
   type(bottom_boundary_config_t) :: c
   type(error_collection_t) :: errors
   c%swbotb = 1
   allocate(c%swc_table(2, 2))
   c%swc_table(1, :) = [1.0_real64, -50.0_real64]
   c%swc_table(2, :) = [365.0_real64, -75.0_real64]
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

