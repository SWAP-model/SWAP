! Phase 4c-b Task 14a: parity for the maizes (type-1, icrop=1) rotation entry.
@test
subroutine test_hupselbrook_parity_maizes_cropfixed()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer, parameter       :: ICROP_MAIZES = 1

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! Phenology
   @assertEqual(1,   config%crop%rotation_fixed(ICROP_MAIZES)%idev)
   @assertEqual(168, config%crop%rotation_fixed(ICROP_MAIZES)%lcc)

   ! Light extinction
   @assertEqual(0.6_real64,  config%crop%rotation_fixed(ICROP_MAIZES)%kdif, 1.0e-12_real64)
   @assertEqual(0.75_real64, config%crop%rotation_fixed(ICROP_MAIZES)%kdir, 1.0e-12_real64)

   ! Feddes water stress (swoxygen=1)
   @assertEqual(-15.0_real64,   config%crop%rotation_fixed(ICROP_MAIZES)%hlim1,  1.0e-12_real64)
   @assertEqual(-30.0_real64,   config%crop%rotation_fixed(ICROP_MAIZES)%hlim2u, 1.0e-12_real64)
   @assertEqual(-30.0_real64,   config%crop%rotation_fixed(ICROP_MAIZES)%hlim2l, 1.0e-12_real64)
   @assertEqual(-325.0_real64,  config%crop%rotation_fixed(ICROP_MAIZES)%hlim3h, 1.0e-12_real64)
   @assertEqual(-600.0_real64,  config%crop%rotation_fixed(ICROP_MAIZES)%hlim3l, 1.0e-12_real64)
   @assertEqual(-8000.0_real64, config%crop%rotation_fixed(ICROP_MAIZES)%hlim4,  1.0e-12_real64)
   @assertEqual(0.5_real64,     config%crop%rotation_fixed(ICROP_MAIZES)%adcrh,  1.0e-12_real64)
   @assertEqual(0.1_real64,     config%crop%rotation_fixed(ICROP_MAIZES)%adcrl,  1.0e-12_real64)

   ! Root depth (TOML stores values verbatim).
   @assertEqual( 10.0_real64, config%crop%rotation_fixed(ICROP_MAIZES)%rdi, 1.0e-12_real64)
   @assertEqual(  2.2_real64, config%crop%rotation_fixed(ICROP_MAIZES)%rri, 1.0e-12_real64)
   @assertEqual(100.0_real64, config%crop%rotation_fixed(ICROP_MAIZES)%rdc, 1.0e-12_real64)

   ! Interception
   @assertEqual(0.25_real64, config%crop%rotation_fixed(ICROP_MAIZES)%cofab, 1.0e-12_real64)
end subroutine

! Phase 4c-b Task 14a: parity for the last type-3 (grassd, icrop=3) rotation
! entry of hupselbrook.
@test
subroutine test_hupselbrook_parity_last_grass_rotation()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer  :: i, n_rot, last_grass_idx
   integer, parameter :: ICROP_GRASSD = 3

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! Locate the last type-3 entry in the rotation.
   n_rot = size(config%crop%rotation_type)
   last_grass_idx = 0
   do i = n_rot, 1, -1
      if (config%crop%rotation_type(i) == 3) then
         last_grass_idx = i
         exit
      end if
   end do
   @assertTrue(last_grass_idx > 0)
   @assertEqual(ICROP_GRASSD, last_grass_idx)

   ! Light extinction
   @assertEqual(0.6_real64,  config%crop%rotation_grass(ICROP_GRASSD)%kdif, 1.0e-12_real64)
   @assertEqual(0.75_real64, config%crop%rotation_grass(ICROP_GRASSD)%kdir, 1.0e-12_real64)

   ! Feddes water stress (swoxygen=1)
   @assertEqual( 0.0_real64,    config%crop%rotation_grass(ICROP_GRASSD)%hlim1,  1.0e-12_real64)
   @assertEqual( 1.0_real64,    config%crop%rotation_grass(ICROP_GRASSD)%hlim2u, 1.0e-12_real64)
   @assertEqual(-1.0_real64,    config%crop%rotation_grass(ICROP_GRASSD)%hlim2l, 1.0e-12_real64)
   @assertEqual(-200.0_real64,  config%crop%rotation_grass(ICROP_GRASSD)%hlim3h, 1.0e-12_real64)
   @assertEqual(-800.0_real64,  config%crop%rotation_grass(ICROP_GRASSD)%hlim3l, 1.0e-12_real64)
   @assertEqual(-8000.0_real64, config%crop%rotation_grass(ICROP_GRASSD)%hlim4,  1.0e-12_real64)
   @assertEqual(0.5_real64,     config%crop%rotation_grass(ICROP_GRASSD)%adcrh,  1.0e-12_real64)
   @assertEqual(0.1_real64,     config%crop%rotation_grass(ICROP_GRASSD)%adcrl,  1.0e-12_real64)

   ! Interception
   @assertEqual(0.25_real64, config%crop%rotation_grass(ICROP_GRASSD)%cofab, 1.0e-12_real64)
end subroutine

! Phase 4c-b Task 8: full WOFOST parity for the potatod (icrop=2) rotation
! entry of hupselbrook.
!
! SS-A note: large-array assertions (chtb 732, dtsmtb 30, slatb 30, amaxtb,
! tmpftb, tmnftb, frtb, fltb, fstb, fotb, rdrrtb, rdrstb, rfsetb) were
! dropped per Decision 2 — coverage relocated to/already in
! tests/unit/io/toml/test_read_cropwofost_toml.pf which exercises the TOML
! reader directly on these tables. Tautological once the legacy reader is
! gone (SS-C).
@test
subroutine test_hupselbrook_parity_potatod_wofost()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64

   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer, parameter       :: ICROP_POTATOD = 2

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! preparation (swprep=0)
   @assertEqual(0, config%crop%rotation_wofost(ICROP_POTATOD)%preparation%swprep)

   ! sowing (swsow=0)
   @assertEqual(0, config%crop%rotation_wofost(ICROP_POTATOD)%sowing%swsow)

   ! germination (swgerm=2)
   @assertEqual(2, config%crop%rotation_wofost(ICROP_POTATOD)%germination%swgerm)
   @assertEqual(170.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%germination%tsumemeopt, 1.0e-12_real64)
   @assertEqual(3.0_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%germination%tbasem,     1.0e-12_real64)

   ! harvest
   @assertEqual(2.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%harvest%dvsend, 1.0e-12_real64)
   @assertEqual(0,          config%crop%rotation_wofost(ICROP_POTATOD)%harvest%swharv)

   ! crop_factor (swcf=2)
   @assertEqual(2,             config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%swcf)
   @assertEqual(0.19_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%albedo, 1.0e-12_real64)
   @assertEqual(207.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%rsc,    1.0e-12_real64)
   @assertEqual(0.0_real64,    config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%rsw,    1.0e-12_real64)

   ! phenology
   @assertEqual(0,              config%crop%rotation_wofost(ICROP_POTATOD)%phenology%idsl)
   @assertEqual(150.0_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%phenology%tsumea, 1.0e-12_real64)
   @assertEqual(1550.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%phenology%tsumam, 1.0e-12_real64)

   ! initial
   @assertEqual(75.0_real64,    config%crop%rotation_wofost(ICROP_POTATOD)%initial%tdwi,   1.0e-12_real64)
   @assertEqual(0.0589_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%initial%laiem,  1.0e-12_real64)
   @assertEqual(0.012_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%initial%rgrlai, 1.0e-12_real64)

   ! green_area
   @assertEqual(0.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%green_area%spa,   1.0e-12_real64)
   @assertEqual(0.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%green_area%ssa,   1.0e-12_real64)
   @assertEqual(37.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%green_area%span,  1.0e-12_real64)
   @assertEqual(2.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%green_area%tbase, 1.0e-12_real64)

   ! assimilation
   @assertEqual(1.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%kdif, 1.0e-12_real64)
   @assertEqual(0.75_real64, config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%kdir, 1.0e-12_real64)
   @assertEqual(0.45_real64, config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%eff,  1.0e-12_real64)

   ! conversion
   @assertEqual(0.72_real64, config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvl, 1.0e-12_real64)
   @assertEqual(0.85_real64, config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvo, 1.0e-12_real64)
   @assertEqual(0.72_real64, config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvr, 1.0e-12_real64)
   @assertEqual(0.69_real64, config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvs, 1.0e-12_real64)

   ! respiration
   @assertEqual(2.0_real64,    config%crop%rotation_wofost(ICROP_POTATOD)%respiration%q10, 1.0e-12_real64)
   @assertEqual(0.03_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rml, 1.0e-12_real64)
   @assertEqual(0.0045_real64, config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rmo, 1.0e-12_real64)
   @assertEqual(0.01_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rmr, 1.0e-12_real64)
   @assertEqual(0.015_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rms, 1.0e-12_real64)

   ! death
   @assertEqual(0.03_real64, config%crop%rotation_wofost(ICROP_POTATOD)%death%perdl, 1.0e-12_real64)

   ! root (swrd=2)
   @assertEqual(2,             config%crop%rotation_wofost(ICROP_POTATOD)%root%swrd)
   @assertEqual(10.0_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%root%rdi,    1.0e-12_real64)
   @assertEqual(1.2_real64,    config%crop%rotation_wofost(ICROP_POTATOD)%root%rri,    1.0e-12_real64)
   @assertEqual(50.0_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%root%rdc,    1.0e-12_real64)
   @assertEqual(1,             config%crop%rotation_wofost(ICROP_POTATOD)%root%swdmi2rd)
   @assertEqual(3000.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%root%wrtmax, 1.0e-12_real64)

   ! oxygen_stress (swoxygen=1)
   @assertEqual(1,             config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%swoxygen)
   @assertEqual(1,             config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%swwrtnonox)
   @assertEqual(0.5_real64,    config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%aeratecrit, 1.0e-12_real64)
   @assertEqual(-10.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%hlim1,      1.0e-12_real64)
   @assertEqual(-25.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%hlim2u,     1.0e-12_real64)
   @assertEqual(-25.0_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%hlim2l,     1.0e-12_real64)

   ! drought_stress
   @assertEqual(1,               config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%swdrought)
   @assertEqual(-300.0_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%hlim3h, 1.0e-12_real64)
   @assertEqual(-500.0_real64,   config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%hlim3l, 1.0e-12_real64)
   @assertEqual(-10000.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%hlim4,  1.0e-12_real64)
   @assertEqual(0.5_real64,      config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%adcrh,  1.0e-12_real64)
   @assertEqual(0.1_real64,      config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%adcrl,  1.0e-12_real64)

   ! salinity (swsalinity=0)
   @assertEqual(0, config%crop%rotation_wofost(ICROP_POTATOD)%salinity%swsalinity)

   ! compensate (swcompensate=0)
   @assertEqual(0, config%crop%rotation_wofost(ICROP_POTATOD)%compensate%swcompensate)

   ! interception (swinter=1)
   @assertEqual(1,           config%crop%rotation_wofost(ICROP_POTATOD)%interception%swinter)
   @assertEqual(0.25_real64, config%crop%rotation_wofost(ICROP_POTATOD)%interception%cofab, 1.0e-12_real64)

   ! co2 (swco2=0)
   @assertEqual(0, config%crop%rotation_wofost(ICROP_POTATOD)%co2%swco2)

   ! management
   @assertEqual(2,           config%crop%rotation_wofost(ICROP_POTATOD)%management%swpotrelmf)
   @assertEqual(0.9_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%management%relmf, 1.0e-12_real64)
   @assertEqual(0.2_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%management%fraharlosorm_lv,     1.0e-12_real64)
   @assertEqual(0.3_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%management%fradeceasedlvtosoil, 1.0e-12_real64)
end subroutine

! Phase 4d Task 20a: parity for the four new sections — bottom_boundary,
! heat, irrigation, solute — added to the case 1 swap.toml in Task 17.
@test
subroutine test_hupselbrook_parity_4d_sections()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/1.hupselbrook/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! [bottom_boundary] — case 1 SWBOTB=6 (free outflow).
   @assertEqual(6, config%bottom_boundary%swbotb)

   ! [heat] — case 1 SWHEA=1 with numerical method (SWCALT=2).
   @assertEqual(1, config%heat%swhea)
   @assertEqual(2, config%heat%swcalt)
   @assertEqual(1, config%heat%swtopbhea)
   @assertEqual(1, config%heat%swbotbhea)
   @assertTrue(allocated(config%heat%psand))
   @assertTrue(allocated(config%heat%tsoil_init))

   ! [irrigation] — case 1 SWIRFIX=1 with one inline fixed event.
   @assertEqual(1, config%irrigation%swirfix)
   @assertTrue(allocated(config%irrigation%fixed_events))
   @assertEqual(1, size(config%irrigation%fixed_events, 1))

   ! [solute] — case 1 SWSOLU=1 with simple boundary transport.
   @assertEqual(1,           config%solute%swsolu)
   @assertEqual(0,           config%solute%swbotbc)
   @assertEqual(0.1_real64,  config%solute%cdrain, 1.0e-12_real64)
   @assertEqual(0.1_real64,  config%solute%cseep,  1.0e-12_real64)
   @assertEqual(0.0_real64,  config%solute%tscf,   1.0e-12_real64)
   @assertEqual(5.0_real64,  config%solute%ldis,   1.0e-12_real64)
end subroutine
