! Tests for the surfacewater cohort reset() procedures:
!   - surfacewater_intermediate_t           (Task A1, A2)
!   - surfacewater_drainage_cumulative_t    (Phase A correction Task 1)
!   - surfacewater_reservoir_cumulative_t   (Phase A correction Task 1)
!
! The original surfacewater_cumulative_t was deprecated and removed
! during the Phase A correction; its tests are gone. The new pair of
! cohorts is partitioned by activity gate (fldrain vs flSurfaceWater).

@test
subroutine test_intermediate_reset_zeroes_scalar_iqdra()
   use funit
   use iso_fortran_env, only: real64
   use surfacewater_state_mod, only: surfacewater_intermediate_t
   type(surfacewater_intermediate_t) :: cohort

   cohort%iqdra = 42.0_real64
   call cohort%reset()
   @assertEqual(0.0_real64, cohort%iqdra, 1.0e-12_real64)
end subroutine test_intermediate_reset_zeroes_scalar_iqdra

@test
subroutine test_intermediate_reset_zeroes_allocated_arrays()
   use funit
   use iso_fortran_env, only: real64
   use surfacewater_state_mod, only: surfacewater_intermediate_t
   type(surfacewater_intermediate_t) :: cohort

   allocate(cohort%inqdra(2, 3));     cohort%inqdra     = 1.0_real64
   allocate(cohort%inqdra_in(2, 3));  cohort%inqdra_in  = 2.0_real64
   allocate(cohort%inqdra_out(2, 3)); cohort%inqdra_out = 3.0_real64

   call cohort%reset()

   @assertEqual(0.0_real64, sum(cohort%inqdra),     1.0e-12_real64)
   @assertEqual(0.0_real64, sum(cohort%inqdra_in),  1.0e-12_real64)
   @assertEqual(0.0_real64, sum(cohort%inqdra_out), 1.0e-12_real64)
end subroutine test_intermediate_reset_zeroes_allocated_arrays

@test
subroutine test_intermediate_reset_safe_when_arrays_not_allocated()
   use funit
   use surfacewater_state_mod, only: surfacewater_intermediate_t
   type(surfacewater_intermediate_t) :: cohort

   ! No allocation — reset() must not crash.
   call cohort%reset()

   @assertFalse(allocated(cohort%inqdra))
   @assertFalse(allocated(cohort%inqdra_in))
   @assertFalse(allocated(cohort%inqdra_out))
end subroutine test_intermediate_reset_safe_when_arrays_not_allocated


! Tests for the SS-CRR Phase A correction split: drainage_cumulative
! and reservoir_cumulative cohorts replace the single cumulative
! cohort. Each is gated by a different activity flag (fldrain vs
! flSurfaceWater) and has a single canonical reset owner.

@test
subroutine test_dr_cum_reset_zeroes_cqdra()
   use funit
   use iso_fortran_env, only: real64
   use surfacewater_state_mod, only: surfacewater_drainage_cumulative_t
   type(surfacewater_drainage_cumulative_t) :: cohort

   cohort%cqdra = 42.0_real64
   call cohort%reset()
   @assertEqual(0.0_real64, cohort%cqdra, 1.0e-12_real64)
end subroutine test_dr_cum_reset_zeroes_cqdra

@test
subroutine test_dr_cum_reset_zeroes_per_level_arrays()
   use funit
   use iso_fortran_env, only: real64
   use surfacewater_state_mod, only: surfacewater_drainage_cumulative_t
   type(surfacewater_drainage_cumulative_t) :: cohort

   allocate(cohort%cqdrain(5));    cohort%cqdrain    = 5.0_real64
   allocate(cohort%cqdrainin(5));  cohort%cqdrainin  = 5.0_real64
   allocate(cohort%cqdrainout(5)); cohort%cqdrainout = 5.0_real64

   call cohort%reset()

   @assertEqual(0.0_real64, sum(cohort%cqdrain),    1.0e-12_real64)
   @assertEqual(0.0_real64, sum(cohort%cqdrainin),  1.0e-12_real64)
   @assertEqual(0.0_real64, sum(cohort%cqdrainout), 1.0e-12_real64)
end subroutine test_dr_cum_reset_zeroes_per_level_arrays

@test
subroutine test_dr_cum_reset_safe_unallocated()
   use funit
   use surfacewater_state_mod, only: surfacewater_drainage_cumulative_t
   type(surfacewater_drainage_cumulative_t) :: cohort

   ! No allocation — reset() must not crash.
   call cohort%reset()

   @assertFalse(allocated(cohort%cqdrain))
   @assertFalse(allocated(cohort%cqdrainin))
   @assertFalse(allocated(cohort%cqdrainout))
end subroutine test_dr_cum_reset_safe_unallocated

@test
subroutine test_res_cum_reset_zeroes_all_scalars()
   use funit
   use iso_fortran_env, only: real64
   use surfacewater_state_mod, only: surfacewater_reservoir_cumulative_t
   type(surfacewater_reservoir_cumulative_t) :: cohort

   cohort%cqdrd  = 1.0_real64
   cohort%cwsupp = 2.0_real64
   cohort%cwout  = 3.0_real64

   call cohort%reset()

   @assertEqual(0.0_real64, cohort%cqdrd,  1.0e-12_real64)
   @assertEqual(0.0_real64, cohort%cwsupp, 1.0e-12_real64)
   @assertEqual(0.0_real64, cohort%cwout,  1.0e-12_real64)
end subroutine test_res_cum_reset_zeroes_all_scalars
