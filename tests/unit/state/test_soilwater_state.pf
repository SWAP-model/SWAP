   @assertEqual(0.0_real64, sw%igird,     1.0e-12_real64)
   @assertEqual(0.0_real64, sw%inird,     1.0e-12_real64)
end subroutine test_swcore_intr_reset_zeroes_all_non_per_day

@test
subroutine test_swcore_intr_reset_also_zeroes_per_day()
   ! reset_intermediate() zeroes the 8 per-day fields as well (it subsumes flDayStart).
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw

   ! Seed per-day scalars
   sw%tra          = 1.5_real64
   sw%iqredwet_day = 2.5_real64
   sw%iqreddry_day = 3.5_real64
   sw%iqredsol_day = 4.5_real64
   sw%iqredfrs_day = 5.5_real64
   sw%iptra_day    = 6.5_real64

   call sw%reset_intermediate()

   @assertEqual(0.0_real64, sw%tra,          1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iqredwet_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iqreddry_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iqredsol_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iqredfrs_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iptra_day,    1.0e-12_real64)
end subroutine test_swcore_intr_reset_also_zeroes_per_day

@test
subroutine test_swcore_intr_reset_per_day_orthogonality()
   ! ORTHOGONALITY: reset_intermediate_per_day() zeroes only the 8 per-day fields.
   ! Non-per-day scalars seeded non-zero must remain unchanged after the per-day reset.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw

   ! Seed ALL scalar fields non-zero
   sw%iqrot        = 1.0_real64
   sw%iqssdi       = 2.0_real64
   sw%iqredwet     = 3.0_real64
   sw%iqreddry     = 4.0_real64
   sw%iqredsol     = 5.0_real64
   sw%iqredfrs     = 6.0_real64
   sw%ies0         = 7.0_real64
   sw%iet0         = 8.0_real64
   sw%iew0         = 9.0_real64
   sw%iintc        = 10.0_real64
   sw%iruno        = 11.0_real64
   sw%irunoCN      = 12.0_real64
   sw%irunon       = 13.0_real64
   sw%iqbot        = 14.0_real64
   sw%iqtdo        = 15.0_real64
   sw%iqtup        = 16.0_real64
   sw%IPondBeg     = 17.0_real64
   sw%iprec        = 18.0_real64
   sw%igird        = 19.0_real64
   sw%inird        = 20.0_real64
   sw%tra          = 21.0_real64
   sw%iqredwet_day = 22.0_real64
   sw%iqreddry_day = 23.0_real64
   sw%iqredsol_day = 24.0_real64
   sw%iqredfrs_day = 25.0_real64
   sw%iptra_day    = 26.0_real64

   call sw%reset_intermediate_per_day()

   ! Per-day scalars must be zero
   @assertEqual(0.0_real64, sw%tra,          1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iqredwet_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iqreddry_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iqredsol_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iqredfrs_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, sw%iptra_day,    1.0e-12_real64)

   ! Non-per-day scalars must be UNCHANGED (orthogonality)
   @assertEqual( 1.0_real64, sw%iqrot,     1.0e-12_real64)
   @assertEqual( 2.0_real64, sw%iqssdi,    1.0e-12_real64)
   @assertEqual( 3.0_real64, sw%iqredwet,  1.0e-12_real64)
   @assertEqual( 4.0_real64, sw%iqreddry,  1.0e-12_real64)
   @assertEqual( 5.0_real64, sw%iqredsol,  1.0e-12_real64)
   @assertEqual( 6.0_real64, sw%iqredfrs,  1.0e-12_real64)
   @assertEqual( 7.0_real64, sw%ies0,      1.0e-12_real64)
   @assertEqual( 8.0_real64, sw%iet0,      1.0e-12_real64)
   @assertEqual( 9.0_real64, sw%iew0,      1.0e-12_real64)
   @assertEqual(10.0_real64, sw%iintc,     1.0e-12_real64)
   @assertEqual(11.0_real64, sw%iruno,     1.0e-12_real64)
   @assertEqual(12.0_real64, sw%irunoCN,   1.0e-12_real64)
   @assertEqual(13.0_real64, sw%irunon,    1.0e-12_real64)
   @assertEqual(14.0_real64, sw%iqbot,     1.0e-12_real64)
   @assertEqual(15.0_real64, sw%iqtdo,     1.0e-12_real64)
   @assertEqual(16.0_real64, sw%iqtup,     1.0e-12_real64)
   @assertEqual(17.0_real64, sw%IPondBeg,  1.0e-12_real64)
   @assertEqual(18.0_real64, sw%iprec,     1.0e-12_real64)
   @assertEqual(19.0_real64, sw%igird,     1.0e-12_real64)
   @assertEqual(20.0_real64, sw%inird,     1.0e-12_real64)
end subroutine test_swcore_intr_reset_per_day_orthogonality

@test
subroutine test_swcore_intr_reset_with_allocated_arrays()
   ! reset_intermediate() zeroes allocated non-per-day arrays (allocated() guard works).
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw
   integer, parameter :: n = 4

   ! Allocate and seed non-per-day arrays
   allocate(sw%inq(n));       sw%inq       = 5.0_real64
   allocate(sw%inqrot(n));    sw%inqrot    = 5.0_real64
   allocate(sw%inqssdi(n));   sw%inqssdi   = 5.0_real64
   allocate(sw%iqdo(n));      sw%iqdo      = 5.0_real64
   allocate(sw%iqup(n));      sw%iqup      = 5.0_real64
   allocate(sw%IThetaBeg(n)); sw%IThetaBeg = 5.0_real64

   call sw%reset_intermediate()

   @assertEqual(0.0_real64, maxval(abs(sw%inq)),       1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%inqrot)),    1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%inqssdi)),   1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%iqdo)),      1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%iqup)),      1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%IThetaBeg)), 1.0e-12_real64)
end subroutine test_swcore_intr_reset_with_allocated_arrays

@test
subroutine test_swcore_intr_reset_per_day_arrays_allocated()
   ! reset_intermediate_per_day() zeroes allocated per-day arrays when they exist.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw
   integer, parameter :: n = 5

   allocate(sw%qpotrot_day(n)); sw%qpotrot_day = 7.0_real64
   allocate(sw%qredtot_day(n)); sw%qredtot_day = 8.0_real64

   call sw%reset_intermediate_per_day()

   @assertEqual(0.0_real64, maxval(abs(sw%qpotrot_day)), 1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%qredtot_day)), 1.0e-12_real64)
end subroutine test_swcore_intr_reset_per_day_arrays_allocated

