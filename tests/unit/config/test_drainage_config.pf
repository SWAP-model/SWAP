@test
subroutine test_drainage_valid_passes()
   use funit
   use error_mod
   use drainage_config_mod
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%swdra  = 1
   d%dramet = 1
   d%swdivd = 0
   d%nrlevs = 1
   call d%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_drainage_dramet2_requires_swdivd1()
   use funit
   use error_mod
   use drainage_config_mod
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%swdra  = 1
   d%dramet = 2
   d%swdivd = 0
   d%nrlevs = 1
   call d%validate(errors)
   @assertTrue(errors%has_fatals())
   @assertEqual(ERR_VALIDATION_CROSS_FIELD, errors%items(errors%count())%code)
end subroutine

@test
subroutine test_drainage_dramet2_with_swdivd1_passes()
   use funit
   use error_mod
   use drainage_config_mod
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%swdra  = 1
   d%dramet = 2
   d%swdivd = 1
   d%nrlevs = 1
   call d%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_drainage_invalid_swdra_fails()
   use funit
   use error_mod
   use drainage_config_mod
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%swdra = 5
   call d%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_drainage_nrlevs_too_many_fails()
   use funit
   use error_mod
   use drainage_config_mod
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%nrlevs = 10
   call d%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_drainage_finalize_clobbers_nrlevs_when_dramet_not_3()
   use funit
   use error_mod
   use drainage_config_mod
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%dramet = 2
   d%nrlevs = 0
   call d%finalize(errors)
   @assertEqual(1, d%nrlevs)
end subroutine

@test
subroutine test_drainage_finalize_clobbers_nrlevs_even_if_user_set()
   use funit
   use error_mod
   use drainage_config_mod
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%dramet = 1
   d%nrlevs = 4
   call d%finalize(errors)
   @assertEqual(1, d%nrlevs)
end subroutine

@test
subroutine test_drainage_finalize_preserves_nrlevs_when_dramet_is_3()
   use funit
   use error_mod
   use drainage_config_mod
   type(drainage_config_t)  :: d
   type(error_collection_t) :: errors
   d%dramet = 3
   d%nrlevs = 5
   call d%finalize(errors)
   @assertEqual(5, d%nrlevs)
end subroutine
