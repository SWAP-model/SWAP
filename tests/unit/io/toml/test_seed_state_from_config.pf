! pFUnit tests for seed_state_from_config (GR-SEED 2026-05-25 Task 11 rename).
!!
!! Each test constructs a minimal swap_config_t, populates the relevant
!! fields, calls seed_state_from_config(config, state), and asserts that the
!! expected state fields carry the expected values.
!!
!! [SS-BMI2 Task 5]: 15 TimeControl config fields (tstart, tend, dtmin,
!! dtmax, period, nprintday, flprintdt, swheader, swodat, swres, swscre,
!! MaxIt, MaxIterTime, msteps, flMaxIterTime) are now written to
!! state%timecontrol directly instead of bare variables% globals.

@test
subroutine test_seed_state_from_config_general_section()
   use funit
   use swap_config_mod, only: swap_config_t
   use seed_state_from_config_mod, only: seed_state_from_config
   use swap_state_mod, only: swap_state_t
   ! [GR-IO 2026-05-25 Phase 6 Step 2] All path/project assertions now read
   ! directly from config%general — bare-global legacy mirrors retired.
   implicit none
   type(swap_config_t) :: config
   type(swap_state_t)  :: state

   config%general%project   = "phase4f_unit"
   config%general%pathwork  = "./work/"
   config%general%pathatm   = "./atm/"
   config%general%pathcrop  = "./crop/"
   config%general%pathdrain = "./drain/"
   config%general%swscre    = 2
   config%simulation%tstart    = 365.0d0
   config%simulation%tend      = 730.0d0
   config%simulation%nprintday = 4
   config%simulation%period    = 7
   config%simulation%swres     = 1
   config%simulation%swodat    = 1

   call seed_state_from_config(config, state)

   @assertEqual("phase4f_unit", trim(config%general%project))
   @assertEqual("./work/",      trim(config%general%pathwork))
   @assertEqual("./atm/",       trim(config%general%pathatm))
   @assertEqual("./drain/",     trim(config%general%pathdrain))
   ! TimeControl config fields now go to state%timecontrol (SS-BMI2 Task 5)
   @assertEqual(2,              state%timecontrol%swscre)
   @assertEqual(365.0d0,        state%timecontrol%tstart)
   @assertEqual(730.0d0,        state%timecontrol%tend)
   @assertEqual(4,              state%timecontrol%nprintday)
   @assertEqual(7,              state%timecontrol%period)
   @assertEqual(1,              state%timecontrol%swres)
   @assertEqual(1,              state%timecontrol%swodat)
end subroutine test_seed_state_from_config_general_section


@test
subroutine test_seed_state_from_config_simulation_numerical()
   use funit
   use swap_config_mod, only: swap_config_t
   use seed_state_from_config_mod, only: seed_state_from_config
   use swap_state_mod, only: swap_state_t
   ! [GR-FINAL C1] dt written directly to state%timecontrol%dt (tc_dt_init_buf retired)
   ! [SS-BMI2 Task 5] dtmin, dtmax, MaxIt, msteps moved to state%timecontrol
   implicit none
   type(swap_config_t) :: config
   type(swap_state_t)  :: state

   config%simulation%numerical%dt        = 0.1d0
   config%simulation%numerical%dtmin     = 1.0d-5
   config%simulation%numerical%dtmax     = 0.5d0
   config%simulation%numerical%MaxIt     = 50
   config%simulation%numerical%MaxBackTr = 5
   config%simulation%numerical%taccur    = 5.0d-4

   call seed_state_from_config(config, state)

   ! [GR-FINAL C1] dt written directly to state%timecontrol%dt
   @assertEqual(0.1d0,   state%timecontrol%dt)
   ! [SS-BMI2 Task 5] numerical fields now in state%timecontrol
   @assertEqual(1.0d-5,  state%timecontrol%dtmin)
   @assertEqual(0.5d0,   state%timecontrol%dtmax)
   @assertEqual(50,      state%timecontrol%MaxIt)
   @assertEqual(5,       config%simulation%numerical%MaxBackTr)
   @assertEqual(5.0d-4,  config%simulation%numerical%taccur)
end subroutine test_seed_state_from_config_simulation_numerical


@test
subroutine test_seed_state_from_config_drainage_basic()
   ! [GR-SEED 2026-05-25 Task 7] Drainage seeding moved from adapter to
   ! state%drainage%init. Test now calls state%drainage%init to verify
   ! seeding; adapter Drainage block deleted. state%surfacewater%swdra is
   ! seeded by state%surfacewater%init — verified from config source here.
   use funit
   use swap_config_mod, only: swap_config_t
   use seed_state_from_config_mod, only: seed_state_from_config
   use swap_state_mod, only: swap_state_t
   ! [GR-BH Task 37] swdivd/nrlevs globals deleted; verified via config fields only.
   implicit none
   type(swap_config_t) :: config
   type(swap_state_t)  :: state
   integer, parameter :: numnod_test = 10

   config%drain%swdra    = 1
   config%drain%dramet   = 3
   config%drain%swdivd   = 1
   config%drain%swdislay = 1
   config%drain%nrlevs   = 4
   config%drain%basegw   = -250.0d0
   config%drain%entres   = 30.0d0

   call seed_state_from_config(config, state)

   ! state%drainage%init (not adapter) now seeds these fields.
   call state%drainage%init(config%drain, numnod_test)

   ! swdra is now seeded via state%surfacewater%init; verify from config source.
   @assertEqual(1,         config%drain%swdra)
   @assertEqual(3,         state%drainage%dramet)
   ! swdivd global retired (GR-BH Task 37) — state%drainage%swdivd seeded in swap_mod.f90
   @assertEqual(1,         config%drain%swdivd)
   @assertEqual(1,         state%drainage%swdislay)
   ! nrlevs global retired (GR-BH Task 37) — state%drainage%nrlevs seeded in swap_mod.f90
   @assertEqual(4,         config%drain%nrlevs)
   @assertEqual(-250.0d0,  state%drainage%basegw)
   @assertEqual(30.0d0,    state%drainage%entres)
end subroutine test_seed_state_from_config_drainage_basic


@test
subroutine test_seed_state_from_config_soil_with_layer_arrays()
   use funit
   use swap_config_mod, only: swap_config_t
   use seed_state_from_config_mod, only: seed_state_from_config
   use swap_state_mod, only: swap_state_t
   ! [GR-SEED 2026-05-25 Task 8] swsophy/swinco/bdens/swfrost seeding moved to
   ! state%soilwater%init (called from swap_mod after CalcGrid). This test now
   ! verifies what seed_state_from_config STILL does for the soil section:
   !   - surfacewater cross-writes (pondmx/rsro/rsroexp)
   !   - mesh%numlay derivation from isoillay
   !   - atmosphere%atmin7 and solute Cml writes (swinco=3 block, retained)
   ! [GR-SEED 2026-05-25 Task 9] apply_soil_tillage also retired from adapter;
   ! tillage seeding now in state%tillage%init (called from swap_mod).
   ! [GR-FINAL C1] pondini/pond seeded in swap_mod after soilwater_init.
   ! [GR-BH Task 36] cofani global retired — seeded via config in swap_mod.f90.
   ! [GR-SOIL 2026-05-24] swhyst/gwli no longer mirrored to variables — read via config.
   implicit none
   type(swap_config_t) :: config
   type(swap_state_t)  :: state

   config%soil%swsophy = 1
   config%soil%swhyst  = 2
   config%soil%swinco  = 2
   config%soil%gwli    = -75.0d0
   config%soil%pondini = 0.5d0
   config%soil%pondmx  = 1.0d0
   allocate(config%soil%cofani(3))
   config%soil%cofani = [1.5d0, 2.0d0, 2.5d0]

   call seed_state_from_config(config, state)

   ! [GR-SEED 2026-05-25 Task 8] swsophy/swinco now seeded by state%soilwater%init,
   ! not by seed_state_from_config — verify via config (canonical source).
   @assertEqual(1,        config%soil%swsophy)
   ! [GR-SOIL 2026-05-24] swhyst/gwli legacy mirrors retired — assert via config (canonical source).
   @assertEqual(2,        config%soil%swhyst)
   @assertEqual(2,        config%soil%swinco)
   @assertEqual(-75.0d0,  config%soil%gwli)
   ! [GR-FINAL C1] pondini/pond now seeded directly in swap_mod after soilwater_init;
   ! verify config source value is preserved.
   @assertEqual(0.5d0,    config%soil%pondini)
   ! [OD Steps 1-3] surfacewater%pondmx/rsro/rsroexp folded into surfacewater%init
   ! (config_soil parameter) — verify via config (canonical source).
   @assertEqual(1.0d0,    config%soil%pondmx)
   ! [GR-BH Task 36] cofani global retired: seed_state_from_config no longer writes to bare global.
   ! state%soilwater%cofani is seeded from config in swap_mod.f90 (swap_init_from_loaded_config).
end subroutine test_seed_state_from_config_soil_with_layer_arrays


@test
subroutine test_seed_state_from_config_surface_water_with_management()
   use funit
   use swap_config_mod, only: swap_config_t
   use seed_state_from_config_mod, only: seed_state_from_config
   use swap_state_mod, only: swap_state_t
   ! [GR-SEED 2026-05-25 Task 6] Management-period seeding moved to
   ! state%surfacewater%init — tested in test_surfacewater_state.pf.
   ! This test retains the config-preserves-its-own-values assertion only.
   implicit none
   type(swap_config_t) :: config
   type(swap_state_t)  :: state

   config%surface_water%swsrf  = 2
   config%surface_water%swsec  = 2
   config%surface_water%swqhr  = 1
   config%surface_water%osswlm = 0.05d0
   config%surface_water%nmper  = 2
   allocate(config%surface_water%impend(2))
   allocate(config%surface_water%swman(2))
   allocate(config%surface_water%wscap(2))
   allocate(config%surface_water%wldip(2))
   allocate(config%surface_water%intwl(2))
   allocate(config%surface_water%hbweir(2))
   config%surface_water%impend = [365.0d0, 730.0d0]
   config%surface_water%swman  = [1, 2]
   config%surface_water%wscap  = [0.0d0, 0.5d0]
   config%surface_water%wldip  = [10.0d0, 15.0d0]
   config%surface_water%intwl  = [1, 7]
   config%surface_water%hbweir = [-50.0d0, -75.0d0]

   call seed_state_from_config(config, state)

   ! Config retains its typed values after adapter runs.
   @assertEqual(2, config%surface_water%swsrf)
   @assertEqual(2, config%surface_water%swsec)
end subroutine test_seed_state_from_config_surface_water_with_management


@test
subroutine test_seed_state_from_config_zero_forces_retired_switches()
   use funit
   use swap_config_mod, only: swap_config_t
   use seed_state_from_config_mod, only: seed_state_from_config
   use swap_state_mod, only: swap_state_t
   ! [GR-SOIL 2026-05-24] swcaprise dropped from import — migrated to
   ! state%cfg%simulation%numerical%swcaprise (the adapter no longer
   ! writes a legacy mirror).
   implicit none
   type(swap_config_t) :: config
   type(swap_state_t)  :: state

   ! [GR-FINAL C4] W-globals (swafo/swaun/swvap/swbal/swwba/swsba/swblc/swdrf/
   ! swstr/swirg/swini/swswb/swoutputmodflow/swcapriseoutput) no longer
   ! explicitly zeroed by seed_state_from_config — they rely on Fortran module
   ! default (=0/.false.) or initialize.f90. Only the functional/C-category
   ! fields still explicitly forced are tested below.

   call seed_state_from_config(config, state)

   ! swheader now written to state%timecontrol%swheader — forced to 0 by ADR 0009 block
   @assertEqual(0, state%timecontrol%swheader)
end subroutine test_seed_state_from_config_zero_forces_retired_switches
