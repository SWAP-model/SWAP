! Phase 4c-b Task 12 parity test:
! legacy `variables` globals (after readswap for case 5.salinitystress)
! vs swap_config_t fields (after load_swap_config + validate + finalize).
!
! Case 5 highlights: 4 potatod (type-2 WOFOST) rotation entries 2012-2015,
! dramet=3 (multi-level drainage), and SWSALINITY=1 (Maas-Hoffman) active in
! the .crp - this is the regression case for the salinity-stress branch.
!
! Scope: existing-schema fields only.  SWSOLU/heat/SWBOTB/irrigation are
! deferred to Phase 4d per docs/phase-4c-b-salinitystress-audit.md.

@test
subroutine test_salinitystress_parity_general()
   use funit
   use parity_helpers_mod
   use variables, only: project, pathwork, pathatm, pathcrop, pathdrain, swscre
   use swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_both_for_salinitystress(config, errors)

   @assertFalse(errors%has_fatals())

   @assertEqual(trim(project),   trim(config%general%project))
   @assertEqual(trim(pathwork),  trim(config%general%pathwork))
   @assertEqual(trim(pathatm),   trim(config%general%pathatm))
   @assertEqual(trim(pathcrop),  trim(config%general%pathcrop))
   @assertEqual(trim(pathdrain), trim(config%general%pathdrain))
   @assertEqual(swscre,          config%general%swscre)
end subroutine

@test
subroutine test_salinitystress_parity_simulation()
   use funit
   use parity_helpers_mod
   use variables, only: tstart, tend, nprintday
   use swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_both_for_salinitystress(config, errors)

   @assertEqual(tstart,    config%simulation%tstart, 1.0d-9)
   @assertEqual(tend,      config%simulation%tend,   1.0d-9)
   @assertEqual(nprintday, config%simulation%nprintday)
end subroutine

@test
subroutine test_salinitystress_parity_meteorology()
   use funit
   use parity_helpers_mod
   use variables, only: metfil, lat, alt, altw, swetr, swdivide, swrain, angstroma, angstromb
   use swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_both_for_salinitystress(config, errors)

   @assertEqual(trim(metfil), trim(config%meteo%metfile))
   @assertEqual(lat,          config%meteo%lat,       1.0d-9)
   @assertEqual(alt,          config%meteo%alt,       1.0d-9)
   @assertEqual(altw,         config%meteo%altw,      1.0d-9)
   @assertEqual(swetr,        config%meteo%swetr)
   @assertEqual(swdivide,     config%meteo%swdivide)
   @assertEqual(swrain,       config%meteo%swrain)
   @assertEqual(angstroma,    config%meteo%angstroma, 1.0d-9)
   @assertEqual(angstromb,    config%meteo%angstromb, 1.0d-9)
end subroutine

@test
subroutine test_salinitystress_parity_drainage()
   use funit
   use parity_helpers_mod
   use variables, only: dramet, swdivd, swdislay, nrlevs
   use swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_both_for_salinitystress(config, errors)

   @assertEqual(dramet,   config%drain%dramet)
   @assertEqual(swdivd,   config%drain%swdivd)
   @assertEqual(swdislay, config%drain%swdislay)
   ! dramet=3 -> finalize does NOT clamp nrlevs to 1; value from file (2) is preserved.
   @assertEqual(nrlevs,   config%drain%nrlevs)
   @assertEqual(3,        config%drain%dramet)
   @assertEqual(2,        config%drain%nrlevs)
end subroutine

@test
subroutine test_salinitystress_parity_soil()
   use funit
   use parity_helpers_mod
   use variables, only: swsophy, swhyst, swinco, swmacro, pondmx
   use swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_both_for_salinitystress(config, errors)

   @assertEqual(swsophy, config%soil%swsophy)
   @assertEqual(swhyst,  config%soil%swhyst)
   ! READING NOTE: legacy SWINCO=3 (with INIFIL='swap.ini') is not yet wired
   ! in the schema; the case-5 swap.toml uses swinco=2 as a schema-clean
   ! stand-in (deferred to Phase 4d).  Assert against the TOML literal.
   @assertEqual(2,       config%soil%swinco)
   ! READING NOTE: gwli is not read by readswap when swinco==3 (legacy reads
   ! initial heads from INIFIL='swap.ini' in that branch).  TOML carries the
   ! value verbatim from the .toml -90.0; assert against the literal.
   @assertEqual(-90.0d0, config%soil%gwli, 1.0d-9)
   @assertEqual(swmacro, config%soil%swmacro)
   @assertEqual(pondmx,  config%soil%pondmx,  1.0d-9)
end subroutine

@test
subroutine test_salinitystress_parity_crop_meta()
   use funit
   use parity_helpers_mod
   use variables, only: swCrop
   use swap_config_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer :: i, n_rot

   call load_both_for_salinitystress(config, errors)

   @assertFalse(errors%has_fatals())

   @assertEqual(swCrop, config%crop%swcrop)

   ! Case 5 has 4 rotation entries (2012-2015), all type 2 (WOFOST potato).
   n_rot = size(config%crop%rotation_type)
   @assertEqual(4, n_rot)
   do i = 1, n_rot
      @assertEqual(2, config%crop%rotation_type(i))
   end do
end subroutine

! Phase 4c-b Task 12: full WOFOST parity for the first (icrop=1) potatod
! rotation entry of salinitystress.  All 4 rotation entries point to the
! same potatod.crp.toml file, so one read suffices to cover the WOFOST
! schema.  The headline feature is the salinity sub-section: SWSALINITY=1
! activates the Maas-Hoffman branch with SALTMAX=0.732, SALTSLOPE=0.0868.
@test
subroutine test_salinitystress_parity_potatod_wofost()
   use funit
   use variables, only: &
      flsolute,                                                          &
      ! crop_factor / phenology / initial / green_area scalars
      swcf, albedo, rsc, rsw, idsl, tsumea, tsumam, tdwi, laiem, rgrlai,  &
      spa, ssa, span, tbase, kdif, kdir, eff,                            &
      ! conversion / respiration / death scalars
      cvl, cvo, cvr, cvs, q10, rml, rmo, rmr, rms, perdl,                &
      ! root scalars
      swrd, rdi, rri, rdc, swdmi2rd,                                     &
      ! oxygen / drought / salinity / compensate / interception
      swoxygen, swwrtnonox, aeratecrit, hlim1, hlim2u, hlim2l,           &
      swdrought, hlim3h, hlim3l, hlim4, adcrh, adcrl,                    &
      swsalinity, saltmax, saltslope,                                    &
      swcompensate, swinter, cofab,                                      &
      ! tables
      dtsmtb, slatb, amaxtb, frtb, fltb, fstb, fotb,                     &
      ! harvest
      dvsend, swharv
   use parity_helpers_mod, only: load_both_for_salinitystress, reset_for_next_readswap
   use legacy_crop_helper_mod, only: read_legacy_wofost, flatten_table
   use chdir_helper_mod, only: chdir_to, get_cwd
   use swap_config_mod
   use error_mod
   use iso_fortran_env, only: real64

   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   real(real64)             :: flat(30)
   integer, parameter       :: ICROP_POTATOD = 1

   ! 1. Load the case (readswap on legacy side, load+validate+finalize on TOML).
   call load_both_for_salinitystress(config, errors)
   @assertFalse(errors%has_fatals())

   ! 2. Now invoke the legacy WOFOST reader from inside the case dir so the
   !    relative pathcrop ('./') resolves to the .crp file.
   ! READING NOTE: readwofost gates the salinity block on `flsolute`.  In a
   ! live SWAP run that flag is set during driver setup (case 5 has
   ! SWSOLU=1).  readswap() does not set it, so we force it here so
   ! readwofost actually parses SWSALINITY/SALTMAX/SALTSLOPE.
   flsolute = .true.
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/5.salinitystress')
   call reset_for_next_readswap()
   call read_legacy_wofost(ICROP_POTATOD, 'potatod')
   call chdir_to(trim(orig_cwd))

   ! ------------------------------------------------------------------
   ! germination (swgerm=0 -> only the switch itself is meaningful)
   ! ------------------------------------------------------------------
   @assertEqual(0, config%crop%rotation_wofost(ICROP_POTATOD)%germination%swgerm)

   ! ------------------------------------------------------------------
   ! harvest (case 5: dvsend=3.0 - harvest at maturity, distinct from case 1)
   ! ------------------------------------------------------------------
   @assertEqual(dvsend, config%crop%rotation_wofost(ICROP_POTATOD)%harvest%dvsend, 1.0e-12_real64)
   @assertEqual(swharv, config%crop%rotation_wofost(ICROP_POTATOD)%harvest%swharv)
   @assertEqual(3.0_real64, config%crop%rotation_wofost(ICROP_POTATOD)%harvest%dvsend, 1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! crop_factor (swcf=2 -> albedo, rsc, rsw populated)
   ! ------------------------------------------------------------------
   @assertEqual(swcf,   config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%swcf)
   @assertEqual(albedo, config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%albedo, 1.0e-12_real64)
   @assertEqual(rsc,    config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%rsc,    1.0e-12_real64)
   @assertEqual(rsw,    config%crop%rotation_wofost(ICROP_POTATOD)%crop_factor%rsw,    1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! phenology
   ! ------------------------------------------------------------------
   @assertEqual(idsl,   config%crop%rotation_wofost(ICROP_POTATOD)%phenology%idsl)
   @assertEqual(tsumea, config%crop%rotation_wofost(ICROP_POTATOD)%phenology%tsumea, 1.0e-12_real64)
   @assertEqual(tsumam, config%crop%rotation_wofost(ICROP_POTATOD)%phenology%tsumam, 1.0e-12_real64)
   flat = flatten_table(config%crop%rotation_wofost(ICROP_POTATOD)%phenology%dtsmtb, 30)
   @assertEqual(dtsmtb, flat, 1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! initial
   ! ------------------------------------------------------------------
   @assertEqual(tdwi,   config%crop%rotation_wofost(ICROP_POTATOD)%initial%tdwi,   1.0e-12_real64)
   @assertEqual(laiem,  config%crop%rotation_wofost(ICROP_POTATOD)%initial%laiem,  1.0e-12_real64)
   @assertEqual(rgrlai, config%crop%rotation_wofost(ICROP_POTATOD)%initial%rgrlai, 1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! green_area
   ! ------------------------------------------------------------------
   @assertEqual(spa,   config%crop%rotation_wofost(ICROP_POTATOD)%green_area%spa,   1.0e-12_real64)
   @assertEqual(ssa,   config%crop%rotation_wofost(ICROP_POTATOD)%green_area%ssa,   1.0e-12_real64)
   @assertEqual(span,  config%crop%rotation_wofost(ICROP_POTATOD)%green_area%span,  1.0e-12_real64)
   @assertEqual(tbase, config%crop%rotation_wofost(ICROP_POTATOD)%green_area%tbase, 1.0e-12_real64)
   flat = flatten_table(config%crop%rotation_wofost(ICROP_POTATOD)%green_area%slatb, 30)
   @assertEqual(slatb, flat, 1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! assimilation
   ! ------------------------------------------------------------------
   @assertEqual(kdif, config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%kdif, 1.0e-12_real64)
   @assertEqual(kdir, config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%kdir, 1.0e-12_real64)
   @assertEqual(eff,  config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%eff,  1.0e-12_real64)
   flat = flatten_table(config%crop%rotation_wofost(ICROP_POTATOD)%assimilation%amaxtb, 30)
   @assertEqual(amaxtb, flat, 1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! conversion / respiration / death
   ! ------------------------------------------------------------------
   @assertEqual(cvl, config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvl, 1.0e-12_real64)
   @assertEqual(cvo, config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvo, 1.0e-12_real64)
   @assertEqual(cvr, config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvr, 1.0e-12_real64)
   @assertEqual(cvs, config%crop%rotation_wofost(ICROP_POTATOD)%conversion%cvs, 1.0e-12_real64)
   @assertEqual(q10, config%crop%rotation_wofost(ICROP_POTATOD)%respiration%q10, 1.0e-12_real64)
   @assertEqual(rml, config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rml, 1.0e-12_real64)
   @assertEqual(rmo, config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rmo, 1.0e-12_real64)
   @assertEqual(rmr, config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rmr, 1.0e-12_real64)
   @assertEqual(rms, config%crop%rotation_wofost(ICROP_POTATOD)%respiration%rms, 1.0e-12_real64)
   @assertEqual(perdl, config%crop%rotation_wofost(ICROP_POTATOD)%death%perdl, 1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! partitioning
   ! ------------------------------------------------------------------
   flat = flatten_table(config%crop%rotation_wofost(ICROP_POTATOD)%partitioning%frtb, 30)
   @assertEqual(frtb, flat, 1.0e-12_real64)
   flat = flatten_table(config%crop%rotation_wofost(ICROP_POTATOD)%partitioning%fltb, 30)
   @assertEqual(fltb, flat, 1.0e-12_real64)
   flat = flatten_table(config%crop%rotation_wofost(ICROP_POTATOD)%partitioning%fstb, 30)
   @assertEqual(fstb, flat, 1.0e-12_real64)
   flat = flatten_table(config%crop%rotation_wofost(ICROP_POTATOD)%partitioning%fotb, 30)
   @assertEqual(fotb, flat, 1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! root (swrd=2 -> rdi/rri/rdc populated)
   ! ------------------------------------------------------------------
   @assertEqual(swrd,     config%crop%rotation_wofost(ICROP_POTATOD)%root%swrd)
   @assertEqual(rdi,      config%crop%rotation_wofost(ICROP_POTATOD)%root%rdi,      1.0e-12_real64)
   @assertEqual(rri,      config%crop%rotation_wofost(ICROP_POTATOD)%root%rri,      1.0e-12_real64)
   @assertEqual(rdc,      config%crop%rotation_wofost(ICROP_POTATOD)%root%rdc,      1.0e-12_real64)
   @assertEqual(swdmi2rd, config%crop%rotation_wofost(ICROP_POTATOD)%root%swdmi2rd)

   ! ------------------------------------------------------------------
   ! oxygen_stress (swoxygen=1 -> Feddes branch)
   ! ------------------------------------------------------------------
   @assertEqual(swoxygen,   config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%swoxygen)
   @assertEqual(swwrtnonox, config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%swwrtnonox)
   @assertEqual(aeratecrit, config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%aeratecrit, 1.0e-12_real64)
   @assertEqual(hlim1,      config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%hlim1,      1.0e-12_real64)
   @assertEqual(hlim2u,     config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%hlim2u,     1.0e-12_real64)
   @assertEqual(hlim2l,     config%crop%rotation_wofost(ICROP_POTATOD)%oxygen_stress%hlim2l,     1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! drought_stress
   ! ------------------------------------------------------------------
   @assertEqual(swdrought, config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%swdrought)
   @assertEqual(hlim3h,    config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%hlim3h, 1.0e-12_real64)
   @assertEqual(hlim3l,    config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%hlim3l, 1.0e-12_real64)
   @assertEqual(hlim4,     config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%hlim4,  1.0e-12_real64)
   @assertEqual(adcrh,     config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%adcrh,  1.0e-12_real64)
   @assertEqual(adcrl,     config%crop%rotation_wofost(ICROP_POTATOD)%drought_stress%adcrl,  1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! salinity (CASE 5 HEADLINE: swsalinity=1 -> Maas-Hoffman branch active)
   ! ------------------------------------------------------------------
   @assertEqual(1, swsalinity)
   @assertEqual(swsalinity, config%crop%rotation_wofost(ICROP_POTATOD)%salinity%swsalinity)
   @assertEqual(saltmax,    config%crop%rotation_wofost(ICROP_POTATOD)%salinity%saltmax,   1.0e-12_real64)
   @assertEqual(saltslope,  config%crop%rotation_wofost(ICROP_POTATOD)%salinity%saltslope, 1.0e-12_real64)
   @assertEqual(0.732_real64,  config%crop%rotation_wofost(ICROP_POTATOD)%salinity%saltmax,   1.0e-12_real64)
   @assertEqual(0.0868_real64, config%crop%rotation_wofost(ICROP_POTATOD)%salinity%saltslope, 1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! compensate / interception
   ! ------------------------------------------------------------------
   @assertEqual(swcompensate, config%crop%rotation_wofost(ICROP_POTATOD)%compensate%swcompensate)
   @assertEqual(swinter, config%crop%rotation_wofost(ICROP_POTATOD)%interception%swinter)
   @assertEqual(cofab,   config%crop%rotation_wofost(ICROP_POTATOD)%interception%cofab, 1.0e-12_real64)

   ! ------------------------------------------------------------------
   ! co2 (case 5: swco2=0, no tables)
   ! ------------------------------------------------------------------
   @assertEqual(0, config%crop%rotation_wofost(ICROP_POTATOD)%co2%swco2)
end subroutine
