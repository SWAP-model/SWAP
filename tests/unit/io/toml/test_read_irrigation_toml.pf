@test
subroutine test_read_irrigation_swirfix0_happy()
   use funit
   use tomlf, only: toml_table, toml_load
   use irrigation_config_mod
   use read_irrigation_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(irrigation_config_t)             :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/irrigation_swirfix0.toml')
   doc_ptr => doc
   call read_irrigation_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(0, c%swirfix)
   @assertFalse(allocated(c%fixed_events))

   ! Validator agrees: swirfix=0 short-circuits cleanly.
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_read_irrigation_swirfix1_irgfil()
   use funit
   use tomlf, only: toml_table, toml_load
   use irrigation_config_mod
   use read_irrigation_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(irrigation_config_t)             :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/irrigation_swirfix1_irgfil.toml')
   doc_ptr => doc
   call read_irrigation_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, c%swirfix)
   @assertTrue(allocated(c%irgfil))
   @assertEqual('wateruse.irg', c%irgfil)
   @assertFalse(allocated(c%fixed_events))

   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_read_irrigation_swirfix1_inline_table()
   use funit
   use tomlf, only: toml_table, toml_load
   use irrigation_config_mod
   use read_irrigation_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(irrigation_config_t)             :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/irrigation_swirfix1_inline.toml')
   doc_ptr => doc
   call read_irrigation_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, c%swirfix)
   @assertTrue(allocated(c%fixed_events))
   @assertEqual(2, size(c%fixed_events, 1))
   @assertEqual(4, size(c%fixed_events, 2))
   ! Date column is days-since-1900 via parse_date_to_days1900 with
   ! jd1900 = 2415020 (1899-12-31 = day 0): 2002-01-05 -> 37260,
   ! 2002-01-10 -> 37265.
   @assertEqual(37260.0d0, c%fixed_events(1, 1), 1.0d-12)
   @assertEqual(   25.0d0, c%fixed_events(1, 2), 1.0d-12)
   @assertEqual(    1.0d0, c%fixed_events(1, 4), 1.0d-12)
   @assertEqual(37265.0d0, c%fixed_events(2, 1), 1.0d-12)
   @assertEqual(    0.5d0, c%fixed_events(2, 3), 1.0d-12)
   @assertEqual(    0.0d0, c%fixed_events(2, 4), 1.0d-12)

   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

