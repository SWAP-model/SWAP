! Tests for csv_reader_mod (Phase 4f cleanup).
!
! Three cases mirror the three error paths the reader supports:
!   * happy: 4-column file with a header row + a comment + 3 data rows
!     parses cleanly into a (3, 4) table; col 1 = days-since-1900.
!   * malformed: a non-numeric cell in a real column appends a typed
!     ERR_PARSE_TYPE_MISMATCH and leaves the table unallocated.
!   * missing: a non-existent path appends ERR_IO_READ_FAILED.

@test
subroutine test_csv_reader_happy_4col()
   use funit
   use iso_fortran_env, only: real64
   use csv_reader_mod, only: read_csv_date_reals
   use error_mod, only: error_collection_t
   real(real64), allocatable :: table(:,:)
   type(error_collection_t)  :: errors

   call read_csv_date_reals('tests/unit/io/fixtures/csv_happy.csv', 3, table, errors)

   @assertFalse(errors%has_errors())
   @assertTrue(allocated(table))
   @assertEqual(3, size(table, 1))
   @assertEqual(4, size(table, 2))
   ! 2012-04-17 is days-since-1900 = 41015 (julian_day - 2415020).
   @assertEqual(41015.0_real64, table(1, 1), 1.0_real64)
   @assertEqual(14.40_real64,  table(1, 2), 1.0e-6_real64)
   @assertEqual(0.401_real64,  table(1, 3), 1.0e-6_real64)
   @assertEqual(1.0_real64,    table(1, 4), 1.0e-6_real64)
end subroutine

@test
subroutine test_csv_reader_malformed_row()
   use funit
   use iso_fortran_env, only: real64
   use csv_reader_mod, only: read_csv_date_reals
   use error_mod, only: error_collection_t, ERR_PARSE_TYPE_MISMATCH
   real(real64), allocatable :: table(:,:)
   type(error_collection_t)  :: errors

   call read_csv_date_reals('tests/unit/io/fixtures/csv_malformed.csv', 3, table, errors)

   @assertTrue(errors%has_errors())
   @assertEqual(ERR_PARSE_TYPE_MISMATCH, errors%items(1)%code)
   @assertFalse(allocated(table))
end subroutine

@test
subroutine test_csv_reader_missing_file()
   use funit
   use iso_fortran_env, only: real64
   use csv_reader_mod, only: read_csv_date_reals
   use error_mod, only: error_collection_t, ERR_IO_READ_FAILED
   real(real64), allocatable :: table(:,:)
   type(error_collection_t)  :: errors

   call read_csv_date_reals('tests/unit/io/fixtures/this_file_does_not_exist.csv', &
                            3, table, errors)

   @assertTrue(errors%has_errors())
   @assertEqual(ERR_IO_READ_FAILED, errors%items(1)%code)
   @assertFalse(allocated(table))
end subroutine
