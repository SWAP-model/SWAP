!> pFUnit tests for TOML-based SWAP configuration reader.
module test_readswaptoml
    use funit
    use swap_state_mod, only: swap_state_t, swap_state_init, swap_state_finalize
    use readswaptoml_mod, only: ReadSwapToml_state
    implicit none

contains

    !> Validate that representative TOML keys are mapped to `swap_state_t`.
    @test
    subroutine test_readswaptoml_maps_core_fields()
        type(swap_state_t) :: state
        integer :: iu
        character(len=*), parameter :: cfg = 'unit_readswaptoml_config.toml'

        call swap_state_init(state, numnod=3, numlay=1, nrlevs=1, ncrop=1)

        open(newunit=iu, file=cfg, status='replace', action='write')
        write(iu,'(A)') '[general]'
        write(iu,'(A)') 'project = "unit_project"'
        write(iu,'(A)') 'swscre = 2'
        write(iu,'(A)') ''
        write(iu,'(A)') '[general.paths]'
        write(iu,'(A)') 'work = "./work"'
        write(iu,'(A)') 'atmosphere = "./atm"'
        write(iu,'(A)') 'crop = "./crop"'
        write(iu,'(A)') 'drain = "./drain"'
        write(iu,'(A)') ''
        write(iu,'(A)') '[simulation]'
        write(iu,'(A)') 'start_date = 2025-01-02'
        write(iu,'(A)') 'end_date = 2025-01-05'
        write(iu,'(A)') ''
        write(iu,'(A)') '[output]'
        write(iu,'(A)') 'file_prefix = "unit_out"'
        write(iu,'(A)') 'nprintday = 1'
        write(iu,'(A)') 'swheader = 1'
        write(iu,'(A)') ''
        write(iu,'(A)') '[output.timing]'
        write(iu,'(A)') 'swmonth = 0'
        write(iu,'(A)') 'period = 7'
        write(iu,'(A)') 'swres = 1'
        write(iu,'(A)') 'swodat = 0'
        write(iu,'(A)') ''
        write(iu,'(A)') '[meteorology]'
        write(iu,'(A)') 'file = "meteo.bbc"'
        write(iu,'(A)') 'lat = 52.1'
        write(iu,'(A)') ''
        write(iu,'(A)') '[meteorology.evapotranspiration]'
        write(iu,'(A)') 'swetr = 1'
        write(iu,'(A)') 'alt = 10.0'
        write(iu,'(A)') 'altw = 2.0'
        write(iu,'(A)') 'angstrom_a = 0.25'
        write(iu,'(A)') 'angstrom_b = 0.50'
        write(iu,'(A)') 'swdivide = 0'
        write(iu,'(A)') ''
        write(iu,'(A)') '[meteorology.temporal]'
        write(iu,'(A)') 'swmetdetail = 0'
        write(iu,'(A)') 'nmetdetail = 1'
        write(iu,'(A)') 'swetsine = 0'
        write(iu,'(A)') ''
        write(iu,'(A)') '[meteorology.rainfall]'
        write(iu,'(A)') 'swrain = 1'
        write(iu,'(A)') 'rainfall_file = "rain.bbc"'
        write(iu,'(A)') ''
        write(iu,'(A)') '[crop.rotation]'
        write(iu,'(A)') 'crop_file = ["maizes.toml", "potatod.toml"]'
        write(iu,'(A)') 'start_date = ["2025-04-01", "2025-09-01"]'
        write(iu,'(A)') 'end_date = ["2025-08-15", "2026-02-01"]'
        write(iu,'(A)') ''
        write(iu,'(A)') '[drainage]'
        write(iu,'(A)') 'drainage_file = "swap.dra.toml"'
        write(iu,'(A)') ''
        write(iu,'(A)') '[boundary.bottom]'
        write(iu,'(A)') 'swbotb = 6'
        write(iu,'(A)') 'swqhbot = 2'
        write(iu,'(A)') 'deepgw = -150.0'
        write(iu,'(A)') 'hbot = -120.0'
        write(iu,'(A)') 'qbot = -0.01'
        write(iu,'(A)') ''
        write(iu,'(A)') '[boundary.top]'
        write(iu,'(A)') 'swpondmx = 1'
        write(iu,'(A)') 'pondmx = 2.5'
        write(iu,'(A)') 'rsro = 0.8'
        write(iu,'(A)') 'runon = 0.12'
        write(iu,'(A)') 'qtop = 0.03'
        close(iu)

        call ReadSwapToml_state(state, cfg)

        @assertEqual('unit_project', trim(state%time%project))
        @assertEqual(2, state%time%swscre)
        @assertEqual('./work', trim(state%time%pathwork))
        @assertEqual('./atm', trim(state%atm%pathatm))
        @assertEqual('./crop', trim(state%crop%pathcrop))
        @assertEqual('./drain', trim(state%drain%pathdrain))
        @assertEqual('unit_out', trim(state%time%outfil))
        @assertEqual(1, state%time%nprintday)
        @assertEqual('meteo.bbc', trim(state%atm%metfil))
        @assertEqual('rain.bbc', trim(state%atm%rainfil))
        @assertEqual(2, state%ncrop)
        @assertEqual('maizes.toml', trim(state%crop%cropfil(1)))
        @assertEqual('potatod.toml', trim(state%crop%cropfil(2)))
        @assertTrue(state%time%tstart > 0.0d0)
        @assertEqual(3.0d0, state%time%tend - state%time%tstart, tolerance=1.0d-9)
        @assertEqual('swap.dra.toml', trim(state%drain%drfil))
        @assertEqual(6, state%boundary%swbotb)
        @assertEqual(2, state%boundary%swqhbot)
        @assertEqual(-150.0d0, state%boundary%deepgw, tolerance=1.0d-9)
        @assertEqual(-120.0d0, state%boundary%hbot, tolerance=1.0d-9)
        @assertEqual(-0.01d0, state%boundary%qbot, tolerance=1.0d-12)
        @assertEqual(1, state%boundary%swpondmx)
        @assertEqual(2.5d0, state%boundary%pondmx, tolerance=1.0d-9)
        @assertEqual(0.8d0, state%boundary%rsro, tolerance=1.0d-9)
        @assertEqual(0.12d0, state%boundary%runon, tolerance=1.0d-9)
        @assertEqual(0.03d0, state%boundary%qtop, tolerance=1.0d-9)

        call swap_state_finalize(state)
        open(newunit=iu, file=cfg, status='old', action='readwrite')
        close(iu, status='delete')
    end subroutine test_readswaptoml_maps_core_fields

end module test_readswaptoml
