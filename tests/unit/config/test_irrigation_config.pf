! Phase 4d Task 10 — validator tests for irrigation_config_mod.
!
! Two type families: irrigation_config_t (top-level, swirfix gate) and
! irrigation_schedule_t (per-crop, schedule gate). Both validators
! short-circuit on a sentinel of 0 so that case TOMLs that omit the
! relevant block still validate clean.

@test
subroutine test_irr_swirfix_zero_sentinel_skips()
   use funit
   use error_mod
   use irrigation_config_mod
   type(irrigation_config_t) :: c
   type(error_collection_t)  :: errors
   c%swirfix = 0
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_irr_swirfix_out_of_range_fails()
   use funit
   use error_mod
   use irrigation_config_mod
   type(irrigation_config_t) :: c
   type(error_collection_t)  :: errors
   c%swirfix = 2
   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_irr_swirfix1_with_irgfil_passes()
   use funit
   use error_mod
   use irrigation_config_mod
   type(irrigation_config_t) :: c
   type(error_collection_t)  :: errors
   c%swirfix = 1
   c%irgfil  = "case.irg"
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_irr_swirfix1_with_fixed_events_passes()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use irrigation_config_mod
   type(irrigation_config_t) :: c
   type(error_collection_t)  :: errors
   c%swirfix = 1
   allocate(c%fixed_events(2, 4))
   c%fixed_events(1, :) = [1.0_real64,  20.0_real64, 0.5_real64, 0.0_real64]
   c%fixed_events(2, :) = [60.0_real64, 25.0_real64, 0.5_real64, 0.0_real64]
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_irr_swirfix1_missing_both_fails()
   use funit
   use error_mod
   use irrigation_config_mod
   type(irrigation_config_t) :: c
   type(error_collection_t)  :: errors
   c%swirfix = 1
   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_irr_fixed_events_wrong_cols_fails()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
