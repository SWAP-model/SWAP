! Tests for soilwater_state_t — typed state record for the soil-water
! boundary subsystem (ADR 0035, B-1.1) and crop water uptake subsystem
! (ADR 0036, C-1.1).
!
! Boundary subset: 12 scalar fields: 7 top-boundary (qtop, reva, hsurf,
! runots, QMpLatSs, ftoph, FlRunoff) + 5 bottom-boundary (qbot,
! qbot_nonfrozen, hbot, gwlinp, deepgw). All instantaneous.
!
! Crop-uptake subset (22 fields — C-1.1):
!   Per-node allocatables: qrot, qpotrot, qredwet, qreddry, qredsol,
!     qredfrs, mflux, mroot, hroot, rootrho, rootphi, rmax, mfluxtable
!   Scalars: qrosum, qredwetsum, qreddrysum, qredsolsum, qredfrssum
!   Flag: flWrtNonox
!   JvL scalars: Tactual, alpJvLier, hleaf, Hxylem
!
! Allocatable arrays are allocated by soilwater_init(sw, numnod, nlay) (C-1.2).
! This file covers: defaults, lifecycle (allocatable status), round-trips,
! aggregator path, and post-init allocation shape + zero checks.
!
! See docs/superpowers/specs/2026-05-10-state-migration-boundary-design.md
!     docs/superpowers/specs/2026-05-10-state-migration-crop-uptake-design.md

@test
subroutine test_soilwater_state_default_reals()
   ! All real(real64) fields default to 0.0.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw

   @assertEqual(0.0_real64, sw%qtop,           1.0e-12_real64)
   @assertEqual(0.0_real64, sw%reva,            1.0e-12_real64)
   @assertEqual(0.0_real64, sw%hsurf,           1.0e-12_real64)
   @assertEqual(0.0_real64, sw%runots,          1.0e-12_real64)
   @assertEqual(0.0_real64, sw%QMpLatSs,        1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qbot,            1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qbot_nonfrozen,  1.0e-12_real64)
   @assertEqual(0.0_real64, sw%hbot,            1.0e-12_real64)
   @assertEqual(0.0_real64, sw%gwlinp,          1.0e-12_real64)
   @assertEqual(0.0_real64, sw%deepgw,          1.0e-12_real64)
end subroutine test_soilwater_state_default_reals

@test
subroutine test_soilwater_state_default_logicals()
   ! Both logical fields default to .false.
   use funit
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw

   @assertFalse(sw%ftoph)
   @assertFalse(sw%FlRunoff)
end subroutine test_soilwater_state_default_logicals

@test
subroutine test_soilwater_state_write_read_roundtrip()
   ! Field write/read round-trip for representative scalars.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw

   sw%qtop    = 1.5_real64
   sw%reva    = 0.3_real64
   sw%qbot    = -0.8_real64
   sw%gwlinp  = 250.0_real64
   sw%ftoph   = .true.
   sw%FlRunoff = .true.

   @assertEqual(  1.5_real64, sw%qtop,   1.0e-12_real64)
   @assertEqual(  0.3_real64, sw%reva,   1.0e-12_real64)
   @assertEqual( -0.8_real64, sw%qbot,   1.0e-12_real64)
   @assertEqual(250.0_real64, sw%gwlinp, 1.0e-12_real64)
   @assertTrue(sw%ftoph)
   @assertTrue(sw%FlRunoff)
end subroutine test_soilwater_state_write_read_roundtrip

@test
subroutine test_soilwater_init_zeros_state()
   ! soilwater_init explicitly zeros all 12 fields, even when they were
   ! previously set to non-zero values. Verifies the forward-compatibility
   ! contract established in B-1.2 (D8).
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t, soilwater_init
   type(soilwater_state_t) :: sw

   ! Pre-load with non-zero / non-default values
   sw%qtop           = 99.0_real64
   sw%reva           = -5.0_real64
   sw%hsurf          = 10.0_real64
   sw%runots         = 3.0_real64
   sw%QMpLatSs       = 1.5_real64
   sw%ftoph          = .true.
   sw%FlRunoff       = .true.
   sw%qbot           = -2.0_real64
   sw%qbot_nonfrozen = -1.0_real64
   sw%hbot           = 500.0_real64
   sw%gwlinp         = 250.0_real64
   sw%deepgw         = -400.0_real64

   call soilwater_init(sw, 5, 2)

   ! All reals must be zero
   @assertEqual(0.0_real64, sw%qtop,           1.0e-12_real64)
   @assertEqual(0.0_real64, sw%reva,            1.0e-12_real64)
   @assertEqual(0.0_real64, sw%hsurf,           1.0e-12_real64)
   @assertEqual(0.0_real64, sw%runots,          1.0e-12_real64)
   @assertEqual(0.0_real64, sw%QMpLatSs,        1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qbot,            1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qbot_nonfrozen,  1.0e-12_real64)
   @assertEqual(0.0_real64, sw%hbot,            1.0e-12_real64)
   @assertEqual(0.0_real64, sw%gwlinp,          1.0e-12_real64)
   @assertEqual(0.0_real64, sw%deepgw,          1.0e-12_real64)
   ! Both logical flags must be .false.
   @assertFalse(sw%ftoph)
   @assertFalse(sw%FlRunoff)
end subroutine test_soilwater_init_zeros_state

@test
subroutine test_soilwater_state_aggregator_access()
   ! Aggregator path: state%soilwater%<field> round-trip via swap_state_t.
   use funit
   use iso_fortran_env, only: real64
   use swap_state_mod, only: swap_state_t
   type(swap_state_t) :: state

   ! Default at construction
   @assertEqual(0.0_real64, state%soilwater%qtop, 1.0e-12_real64)
   @assertEqual(0.0_real64, state%soilwater%qbot, 1.0e-12_real64)
   @assertFalse(state%soilwater%ftoph)

   ! Write then read through aggregator
   state%soilwater%qtop    = 1.0_real64
   state%soilwater%deepgw  = -350.0_real64
   state%soilwater%FlRunoff = .true.

   @assertEqual(  1.0_real64, state%soilwater%qtop,   1.0e-12_real64)
   @assertEqual(-350.0_real64, state%soilwater%deepgw, 1.0e-12_real64)
   @assertTrue(state%soilwater%FlRunoff)
end subroutine test_soilwater_state_aggregator_access

! =============================================================================
! C-1.1 — Crop water uptake extension tests (ADR 0036)
! =============================================================================

@test
subroutine test_soilwater_cropuptake_scalar_defaults()
   ! All new crop-uptake scalar fields default to 0.0 / .false.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw

   @assertEqual(0.0_real64, sw%qrosum,       1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qredwetsum,   1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qreddrysum,   1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qredsolsum,   1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qredfrssum,   1.0e-12_real64)
   @assertEqual(0.0_real64, sw%Tactual,      1.0e-12_real64)
   @assertEqual(0.0_real64, sw%alpJvLier,    1.0e-12_real64)
   @assertEqual(0.0_real64, sw%hleaf,        1.0e-12_real64)
   @assertEqual(0.0_real64, sw%Hxylem,       1.0e-12_real64)
   @assertFalse(sw%flWrtNonox)
end subroutine test_soilwater_cropuptake_scalar_defaults

@test
subroutine test_soilwater_cropuptake_allocatables_not_allocated()
   ! All 13 new allocatable arrays start unallocated before soilwater_init.
   ! Allocation is deferred to C-1.2 (soilwater_init signature bump).
   use funit
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw

   ! Primary Feddes+stress arrays
   @assertFalse(allocated(sw%qrot))
   @assertFalse(allocated(sw%qpotrot))
   @assertFalse(allocated(sw%qredwet))
   @assertFalse(allocated(sw%qreddry))
   @assertFalse(allocated(sw%qredsol))
   @assertFalse(allocated(sw%qredfrs))

   ! JvL per-node arrays
   @assertFalse(allocated(sw%mflux))
   @assertFalse(allocated(sw%mroot))
   @assertFalse(allocated(sw%hroot))
   @assertFalse(allocated(sw%rootrho))
   @assertFalse(allocated(sw%rootphi))
   @assertFalse(allocated(sw%rmax))

   ! Init-once lookup table
   @assertFalse(allocated(sw%mfluxtable))
end subroutine test_soilwater_cropuptake_allocatables_not_allocated

@test
subroutine test_soilwater_cropuptake_scalar_roundtrip()
   ! Scalar write/read round-trip for representative crop-uptake scalars.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw

   sw%qrosum     = 0.42_real64
   sw%qreddrysum = 0.10_real64
   sw%Tactual    = 0.38_real64
   sw%alpJvLier  = 1.23_real64
   sw%hleaf      = -1500.0_real64
   sw%Hxylem     = -200.0_real64
   sw%flWrtNonox = .true.

   @assertEqual( 0.42_real64,     sw%qrosum,     1.0e-12_real64)
   @assertEqual( 0.10_real64,     sw%qreddrysum, 1.0e-12_real64)
   @assertEqual( 0.38_real64,     sw%Tactual,    1.0e-12_real64)
   @assertEqual( 1.23_real64,     sw%alpJvLier,  1.0e-12_real64)
   @assertEqual(-1500.0_real64,   sw%hleaf,      1.0e-12_real64)
   @assertEqual(-200.0_real64,    sw%Hxylem,     1.0e-12_real64)
   @assertTrue(sw%flWrtNonox)
end subroutine test_soilwater_cropuptake_scalar_roundtrip

@test
subroutine test_soilwater_cropuptake_two_instances_independent()
   ! Two soilwater_state_t instances share no state (value semantics).
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t
   type(soilwater_state_t) :: sw1, sw2

   sw1%qrosum     = 1.0_real64
   sw1%alpJvLier  = 2.0_real64
   sw1%flWrtNonox = .true.

   ! sw2 must retain defaults, unaffected by sw1 assignments
   @assertEqual(0.0_real64, sw2%qrosum,    1.0e-12_real64)
   @assertEqual(0.0_real64, sw2%alpJvLier, 1.0e-12_real64)
   @assertFalse(sw2%flWrtNonox)

   ! sw1 reads must match what we wrote
   @assertEqual(1.0_real64, sw1%qrosum,    1.0e-12_real64)
   @assertEqual(2.0_real64, sw1%alpJvLier, 1.0e-12_real64)
   @assertTrue(sw1%flWrtNonox)
end subroutine test_soilwater_cropuptake_two_instances_independent

@test
subroutine test_soilwater_cropuptake_aggregator_access()
   ! Aggregator path: state%soilwater%<crop-uptake-field> round-trip.
   use funit
   use iso_fortran_env, only: real64
   use swap_state_mod, only: swap_state_t
   type(swap_state_t) :: state

   ! Defaults via aggregator
   @assertEqual(0.0_real64, state%soilwater%qrosum,    1.0e-12_real64)
   @assertEqual(0.0_real64, state%soilwater%Tactual,   1.0e-12_real64)
   @assertFalse(state%soilwater%flWrtNonox)
   @assertFalse(allocated(state%soilwater%qrot))
   @assertFalse(allocated(state%soilwater%mfluxtable))

   ! Write and read back through aggregator
   state%soilwater%qrosum     = 0.75_real64
   state%soilwater%hleaf      = -900.0_real64
   state%soilwater%flWrtNonox = .true.

   @assertEqual(  0.75_real64, state%soilwater%qrosum, 1.0e-12_real64)
   @assertEqual(-900.0_real64, state%soilwater%hleaf,  1.0e-12_real64)
   @assertTrue(state%soilwater%flWrtNonox)
end subroutine test_soilwater_cropuptake_aggregator_access

@test
subroutine test_soilwater_cropuptake_soilwater_init_zeros_new_scalars()
   ! soilwater_init zeroes all boundary AND new crop-uptake scalar fields
   ! even when they were pre-set to non-zero values.
   ! Per-node arrays are allocated by soilwater_init (C-1.2).
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t, soilwater_init
   type(soilwater_state_t) :: sw

   ! Pre-load with non-zero / non-default values
   sw%qrosum     = 5.0_real64
   sw%qredwetsum = 1.0_real64
   sw%qreddrysum = 2.0_real64
   sw%qredsolsum = 0.5_real64
   sw%qredfrssum = 0.1_real64
   sw%Tactual    = 3.0_real64
   sw%alpJvLier  = 1.5_real64
   sw%hleaf      = -2000.0_real64
   sw%Hxylem     = -100.0_real64
   sw%flWrtNonox = .true.

   call soilwater_init(sw, 5, 2)

   @assertEqual(0.0_real64, sw%qrosum,       1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qredwetsum,   1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qreddrysum,   1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qredsolsum,   1.0e-12_real64)
   @assertEqual(0.0_real64, sw%qredfrssum,   1.0e-12_real64)
   @assertEqual(0.0_real64, sw%Tactual,      1.0e-12_real64)
   @assertEqual(0.0_real64, sw%alpJvLier,    1.0e-12_real64)
   @assertEqual(0.0_real64, sw%hleaf,        1.0e-12_real64)
   @assertEqual(0.0_real64, sw%Hxylem,       1.0e-12_real64)
   @assertFalse(sw%flWrtNonox)
end subroutine test_soilwater_cropuptake_soilwater_init_zeros_new_scalars

! =============================================================================
! C-1.2 — soilwater_init(sw, numnod, nlay) allocation tests (ADR 0036)
! =============================================================================

@test
subroutine test_soilwater_init_allocates_per_node_arrays()
   ! After soilwater_init(sw, numnod, nlay) all 12 per-node arrays must be
   ! allocated with size == numnod.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t, soilwater_init
   type(soilwater_state_t) :: sw
   integer, parameter :: n = 10, nl = 3

   call soilwater_init(sw, n, nl)

   ! Feddes + stress path
   @assertTrue(allocated(sw%qrot))
   @assertTrue(allocated(sw%qpotrot))
   @assertTrue(allocated(sw%qredwet))
   @assertTrue(allocated(sw%qreddry))
   @assertTrue(allocated(sw%qredsol))
   @assertTrue(allocated(sw%qredfrs))

   ! JvL microscopic path
   @assertTrue(allocated(sw%mflux))
   @assertTrue(allocated(sw%mroot))
   @assertTrue(allocated(sw%hroot))
   @assertTrue(allocated(sw%rootrho))
   @assertTrue(allocated(sw%rootphi))
   @assertTrue(allocated(sw%rmax))

   ! Sizes must equal numnod
   @assertEqual(n, size(sw%qrot))
   @assertEqual(n, size(sw%qpotrot))
   @assertEqual(n, size(sw%qredwet))
   @assertEqual(n, size(sw%qreddry))
   @assertEqual(n, size(sw%qredsol))
   @assertEqual(n, size(sw%qredfrs))
   @assertEqual(n, size(sw%mflux))
   @assertEqual(n, size(sw%mroot))
   @assertEqual(n, size(sw%hroot))
   @assertEqual(n, size(sw%rootrho))
   @assertEqual(n, size(sw%rootphi))
   @assertEqual(n, size(sw%rmax))
end subroutine test_soilwater_init_allocates_per_node_arrays

@test
subroutine test_soilwater_init_allocates_mfluxtable()
   ! mfluxtable must be allocated with shape (nlay, 801) after init.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t, soilwater_init
   type(soilwater_state_t) :: sw
   integer, parameter :: n = 5, nl = 4

   call soilwater_init(sw, n, nl)

   @assertTrue(allocated(sw%mfluxtable))
   @assertEqual(nl,  size(sw%mfluxtable, 1))
   @assertEqual(801, size(sw%mfluxtable, 2))
end subroutine test_soilwater_init_allocates_mfluxtable

@test
subroutine test_soilwater_init_per_node_arrays_zeroed()
   ! All per-node arrays and mfluxtable must be zero after init.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t, soilwater_init
   type(soilwater_state_t) :: sw
   integer, parameter :: n = 6, nl = 2

   call soilwater_init(sw, n, nl)

   @assertEqual(0.0_real64, maxval(abs(sw%qrot)),    1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%qpotrot)), 1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%qredwet)), 1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%qreddry)), 1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%qredsol)), 1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%qredfrs)), 1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%mflux)),   1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%mroot)),   1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%hroot)),   1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%rootrho)), 1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%rootphi)), 1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%rmax)),    1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(sw%mfluxtable)), 1.0e-12_real64)
end subroutine test_soilwater_init_per_node_arrays_zeroed

@test
subroutine test_soilwater_init_different_sizes()
   ! Calling init with different numnod/nlay produces correct shapes.
   ! Verifies the size arguments are actually honoured.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_state_t, soilwater_init
   type(soilwater_state_t) :: sw1, sw2
   integer, parameter :: n1 = 20, nl1 = 5
   integer, parameter :: n2 = 3,  nl2 = 1

   call soilwater_init(sw1, n1, nl1)
   call soilwater_init(sw2, n2, nl2)

   @assertEqual(n1,  size(sw1%qrot))
   @assertEqual(nl1, size(sw1%mfluxtable, 1))
   @assertEqual(801, size(sw1%mfluxtable, 2))

   @assertEqual(n2,  size(sw2%qrot))
   @assertEqual(nl2, size(sw2%mfluxtable, 1))
   @assertEqual(801, size(sw2%mfluxtable, 2))
end subroutine test_soilwater_init_different_sizes
