   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf  = 2
   s%swsec  = 2
   s%wlact  = -10.0d0
   s%osswlm = 1.0d0
   s%nmper  = 2
   allocate(s%impend(2));  s%impend = [35430.0d0, 35444.0d0]
   allocate(s%swman(2));   s%swman  = [1, 1]
   allocate(s%wscap(2));   s%wscap  = [0.0d0, 0.0d0]
   allocate(s%wldip(2));   s%wldip  = [0.0d0, 0.0d0]
   allocate(s%intwl(2));   s%intwl  = [1, 1]
   s%swqhr  = 1
   s%sofcu  = 100.0d0
   ! hbweir deliberately not allocated
   allocate(s%alphaw(2));  s%alphaw = [1.7d0, 1.7d0]
   allocate(s%betaw(2));   s%betaw  = [1.5d0, 1.5d0]
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_swsrf_one_skips_swsec_validation()
   use funit
   use error_mod
   use surface_water_config_mod
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swsrf = 1
   s%nmper = 999999    ! would be out-of-range under swsrf=2
   s%swsec = 99        ! would fail enum under swsrf=2
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_finalize_normalises_alphaw_for_swqhr_one()
   ! Legacy rddre normalizes alphaw via
   !   alphaw = alphaw_raw * 8.64 * 100^(1-betaw) / sofcu
   ! finalize must apply the same transform so config matches the legacy
   ! global post-rddre.
   use funit
   use error_mod
   use surface_water_config_mod
   use iso_fortran_env, only: real64
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   real(real64) :: expected
   s%swsrf = 2; s%swsec = 2; s%swqhr = 1
   s%nmper = 1; s%sofcu = 100.0_real64
   allocate(s%alphaw(1));  s%alphaw = [1.7_real64]
   allocate(s%betaw(1));   s%betaw  = [1.5_real64]
   call s%finalize(errors)
   expected = 1.7_real64 * 8.64_real64 &
      * 100.0_real64 ** (1.0_real64 - 1.5_real64) / 100.0_real64
   @assertEqual(expected, s%alphaw(1), 1.0e-12_real64)
end subroutine

@test
subroutine test_finalize_skips_when_swqhr_two()
   ! When SWQHR=2 (table form), no normalization happens. alphaw stays raw.
   use funit
   use error_mod
   use surface_water_config_mod
   use iso_fortran_env, only: real64
   type(surface_water_config_t) :: s
   type(error_collection_t)     :: errors
   s%swqhr = 2
   s%nmper = 1; s%sofcu = 100.0_real64
   allocate(s%alphaw(1));  s%alphaw = [1.7_real64]
   allocate(s%betaw(1));   s%betaw  = [1.5_real64]
   call s%finalize(errors)
   @assertEqual(1.7_real64, s%alphaw(1), 1.0e-12_real64)
end subroutine
