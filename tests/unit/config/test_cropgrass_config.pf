end subroutine

! ---------------------------------------------------------------------------
! Phase 4d Task 15 — per-event mowing/grazing tables
! ---------------------------------------------------------------------------

@test
subroutine test_cropgrass_swharv2_fixed_dates_passes()
   use funit
   use error_mod
   use cropgrass_config_mod
   type(cropgrass_config_t) :: c
   type(error_collection_t) :: errors
   c%swharv  = 2
   c%nmow    = 3
   c%swdmmow = 2  ! DM threshold (legacy SWDMMOW=2 in cases)
   allocate(c%mowing_dates(3))
   c%mowing_dates = [120.0d0, 165.0d0, 210.0d0]
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_cropgrass_swharv2_without_mowing_dates_fails()
   use funit
   use error_mod
   use cropgrass_config_mod
   type(cropgrass_config_t) :: c
   type(error_collection_t) :: errors
   c%swharv  = 2
   c%nmow    = 3
   c%swdmmow = 2
   ! mowing_dates intentionally NOT allocated
   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_cropgrass_swharv2_heights_required_when_swdmmow0()
   use funit
   use error_mod
   use cropgrass_config_mod
   type(cropgrass_config_t) :: c
   type(error_collection_t) :: errors
   c%swharv  = 2
   c%nmow    = 2
   c%swdmmow = 0  ! heights branch
   allocate(c%mowing_dates(2))
   c%mowing_dates = [100.0d0, 200.0d0]
   ! mowing_heights NOT allocated → must error
   call c%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

