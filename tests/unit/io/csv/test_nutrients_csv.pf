! Tests for typed CSV record table for nutrients amendment event files.
! Family 3 of the CSV-families arc (ADR 0044).

@test
subroutine test_amendment_events_load_happy()
   use funit
   use iso_fortran_env,    only: real64
   use nutrients_csv_mod,  only: amendment_events_table_t
   use error_mod,          only: error_collection_t

   type(amendment_events_table_t) :: tbl
   type(error_collection_t)       :: errors

   call tbl%load('tests/unit/io/fixtures/csv_nutrients_events.csv', errors)

   @assertFalse(errors%has_errors())
   @assertTrue(tbl%is_loaded)
   @assertTrue(allocated(tbl%rows))
   @assertEqual(3, size(tbl%rows))

   ! Row 1 = 2012-03-15.  days_since_1900(2012,3,15) = 40981.
   ! material=3, amount_kgha=150.0, volat_fraction=0.25
   @assertEqual(40981.0_real64, tbl%rows(1)%date,           1.0_real64)
   @assertEqual(3,              tbl%rows(1)%material)
   @assertEqual(150.0_real64,   tbl%rows(1)%amount_kgha,    1.0e-6_real64)
   @assertEqual(0.25_real64,    tbl%rows(1)%volat_fraction, 1.0e-6_real64)

   ! Row 2 = 2012-06-01.  days_since_1900(2012,6,1) = 41059.
   @assertEqual(41059.0_real64, tbl%rows(2)%date, 1.0_real64)
   @assertEqual(5,              tbl%rows(2)%material)
end subroutine test_amendment_events_load_happy

@test
subroutine test_amendment_events_load_missing_file()
   use funit
   use nutrients_csv_mod, only: amendment_events_table_t
   use error_mod,         only: error_collection_t

   type(amendment_events_table_t) :: tbl
   type(error_collection_t)       :: errors

   call tbl%load('tests/unit/io/fixtures/does_not_exist_nutrients_events.csv', errors)

   @assertTrue(errors%has_errors())
   @assertFalse(tbl%is_loaded)
   @assertFalse(allocated(tbl%rows))
end subroutine test_amendment_events_load_missing_file

@test
subroutine test_amendment_events_load_bad_material()
   use funit
   use nutrients_csv_mod, only: amendment_events_table_t
   use error_mod,         only: error_collection_t

   type(amendment_events_table_t) :: tbl
   type(error_collection_t)       :: errors

   call tbl%load('tests/unit/io/fixtures/csv_nutrients_events_bad_material.csv', errors)

   @assertTrue(errors%has_errors())
   @assertFalse(tbl%is_loaded)
   @assertFalse(allocated(tbl%rows))
end subroutine test_amendment_events_load_bad_material

