   @assertEqual(0,             config%soil%swmacro)
end subroutine

@test
subroutine test_oxygenstress_crop_rotation_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer :: i, n_rot

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   @assertEqual(1, config%crop%swcrop)

   ! Case 4 has 10 rotation entries (1993-2002), all type 3 (WOFOST grass).
   n_rot = size(config%crop%rotation_type)
   @assertEqual(10, n_rot)
   do i = 1, n_rot
      @assertEqual(3, config%crop%rotation_type(i))
   end do
end subroutine

! Phase 4c-b Task 14c: parity for the last type-3 (grassd) rotation entry of
! case 4.oxygenstress. Case 4 grassd.crp has SWRD=2 and swoxygen=2.
@test
subroutine test_oxygenstress_grass_data_parity()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer  :: i, n_rot, last_grass_idx
   integer, parameter :: ICROP_GRASSD = 10

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! Locate the last type-3 entry in the rotation.
   n_rot = size(config%crop%rotation_type)
   last_grass_idx = 0
   do i = n_rot, 1, -1
      if (config%crop%rotation_type(i) == 3) then
         last_grass_idx = i
         exit
      end if
   end do
   @assertTrue(last_grass_idx > 0)
   @assertEqual(ICROP_GRASSD, last_grass_idx)

   ! Case 4 swoxygen=2 (Bartholomeus). Only hlim3h/hlim3l/hlim4 are
   ! authored in the .crp's drought-stress section.
   @assertEqual(-200.0_real64,  config%crop%rotation_grass(ICROP_GRASSD)%hlim3h, 1.0e-12_real64)
   @assertEqual(-800.0_real64,  config%crop%rotation_grass(ICROP_GRASSD)%hlim3l, 1.0e-12_real64)
   @assertEqual(-8000.0_real64, config%crop%rotation_grass(ICROP_GRASSD)%hlim4,  1.0e-12_real64)

   ! Root growth (swrd=2).
   @assertEqual(10.0_real64, config%crop%rotation_grass(ICROP_GRASSD)%rdi, 1.0e-12_real64)
   @assertEqual( 1.0_real64, config%crop%rotation_grass(ICROP_GRASSD)%rri, 1.0e-12_real64)
   @assertEqual(40.0_real64, config%crop%rotation_grass(ICROP_GRASSD)%rdc, 1.0e-12_real64)
end subroutine

! Phase 4d Task 20c: parity for the four new sections — bottom_boundary,
! heat, irrigation, solute — added to the case 4 swap.toml in Task 17.
@test
subroutine test_oxygenstress_parity_4d_sections()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! [bottom_boundary] — case 4 SWBOTB=3 (Cauchy / regional aquifer).
   @assertEqual(3,             config%bottom_boundary%swbotb)
   @assertEqual( 1.0_real64,   config%bottom_boundary%shape,  1.0e-12_real64)
   @assertEqual(-25.0_real64,  config%bottom_boundary%hdrain, 1.0e-12_real64)
   @assertEqual(500.0_real64,  config%bottom_boundary%rimlay, 1.0e-12_real64)

   ! [heat] — case 4 SWHEA=1 with numerical method (SWCALT=2).
   @assertEqual(1, config%heat%swhea)
   @assertEqual(2, config%heat%swcalt)
   @assertEqual(1, config%heat%swtopbhea)
   @assertEqual(1, config%heat%swbotbhea)
   @assertTrue(allocated(config%heat%psand))
   @assertTrue(allocated(config%heat%tsoil_init))

   ! [irrigation] — case 4 SWIRFIX=0.
   @assertEqual(0, config%irrigation%swirfix)

   ! [solute] — case 4 SWSOLU=0.
   @assertEqual(0, config%solute%swsolu)
end subroutine

! Phase 4d Task 20c: grass mowing parity for case 4 grassd.crp.
! Case 4 SEQGRAZMOW = all-2 (mowing-only), SWHARVEST=1 (DM-threshold).
@test
subroutine test_oxygenstress_parity_grass_mowing()
   use funit
   use swap_config_mod
   use load_swap_config_mod, only: load_swap_config
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   integer, parameter :: ICROP_GRASSD = 10

   call load_swap_config('tests/swap-cases/toml/4.oxygenstress/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)
   @assertFalse(errors%has_fatals())

   ! Mowing scalars (case 4 SWHARVEST=1 + swdmmow=2).
   @assertEqual(1, config%crop%rotation_grass(ICROP_GRASSD)%swharv)
   @assertEqual(2, config%crop%rotation_grass(ICROP_GRASSD)%swdmmow)
   ! maxdaymow asserted only structurally — covered by direct TOML reader test.
end subroutine
