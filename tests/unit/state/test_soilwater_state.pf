@test
subroutine test_swcore_intr_reset_zeroes_all_non_per_day()
   ! intr%reset() zeroes all 20 non-per-day scalars.
   ! (Arrays not allocated here; allocated() guard prevents crash.)
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_intermediate_t
   type(soilwater_intermediate_t) :: intr

   ! Seed all non-per-day scalars with non-zero
   intr%iqrot    = 1.0_real64
   intr%iqssdi   = 2.0_real64
   intr%iqredwet = 3.0_real64
   intr%iqreddry = 4.0_real64
   intr%iqredsol = 5.0_real64
   intr%iqredfrs = 6.0_real64
   intr%ies0     = 7.0_real64
   intr%iet0     = 8.0_real64
   intr%iew0     = 9.0_real64
   intr%iintc    = 10.0_real64
   intr%iruno    = 11.0_real64
   intr%irunoCN  = 12.0_real64
   intr%irunon   = 13.0_real64
   intr%iqbot    = 14.0_real64
   intr%iqtdo    = 15.0_real64
   intr%iqtup    = 16.0_real64
   intr%IPondBeg = 17.0_real64
   intr%iprec    = 18.0_real64
   intr%igird    = 19.0_real64
   intr%inird    = 20.0_real64

   call intr%reset()

   @assertEqual(0.0_real64, intr%iqrot,     1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqssdi,    1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqredwet,  1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqreddry,  1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqredsol,  1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqredfrs,  1.0e-12_real64)
   @assertEqual(0.0_real64, intr%ies0,      1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iet0,      1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iew0,      1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iintc,     1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iruno,     1.0e-12_real64)
   @assertEqual(0.0_real64, intr%irunoCN,   1.0e-12_real64)
   @assertEqual(0.0_real64, intr%irunon,    1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqbot,     1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqtdo,     1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqtup,     1.0e-12_real64)
   @assertEqual(0.0_real64, intr%IPondBeg,  1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iprec,     1.0e-12_real64)
   @assertEqual(0.0_real64, intr%igird,     1.0e-12_real64)
   @assertEqual(0.0_real64, intr%inird,     1.0e-12_real64)
end subroutine test_swcore_intr_reset_zeroes_all_non_per_day

@test
subroutine test_swcore_intr_reset_also_zeroes_per_day()
   ! intr%reset() zeroes the 8 per-day fields as well (it subsumes flDayStart).
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_intermediate_t
   type(soilwater_intermediate_t) :: intr

   ! Seed per-day scalars
   intr%tra          = 1.5_real64
   intr%iqredwet_day = 2.5_real64
   intr%iqreddry_day = 3.5_real64
   intr%iqredsol_day = 4.5_real64
   intr%iqredfrs_day = 5.5_real64
   intr%iptra_day    = 6.5_real64

   call intr%reset()

   @assertEqual(0.0_real64, intr%tra,          1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqredwet_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqreddry_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqredsol_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqredfrs_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iptra_day,    1.0e-12_real64)
end subroutine test_swcore_intr_reset_also_zeroes_per_day

@test
subroutine test_swcore_intr_reset_per_day_orthogonality()
   ! ORTHOGONALITY: intr%reset_per_day() zeroes only the 8 per-day fields.
   ! Non-per-day scalars seeded non-zero must remain unchanged after reset_per_day.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_intermediate_t
   type(soilwater_intermediate_t) :: intr

   ! Seed ALL scalar fields non-zero
   intr%iqrot        = 1.0_real64
   intr%iqssdi       = 2.0_real64
   intr%iqredwet     = 3.0_real64
   intr%iqreddry     = 4.0_real64
   intr%iqredsol     = 5.0_real64
   intr%iqredfrs     = 6.0_real64
   intr%ies0         = 7.0_real64
   intr%iet0         = 8.0_real64
   intr%iew0         = 9.0_real64
   intr%iintc        = 10.0_real64
   intr%iruno        = 11.0_real64
   intr%irunoCN      = 12.0_real64
   intr%irunon       = 13.0_real64
   intr%iqbot        = 14.0_real64
   intr%iqtdo        = 15.0_real64
   intr%iqtup        = 16.0_real64
   intr%IPondBeg     = 17.0_real64
   intr%iprec        = 18.0_real64
   intr%igird        = 19.0_real64
   intr%inird        = 20.0_real64
   intr%tra          = 21.0_real64
   intr%iqredwet_day = 22.0_real64
   intr%iqreddry_day = 23.0_real64
   intr%iqredsol_day = 24.0_real64
   intr%iqredfrs_day = 25.0_real64
   intr%iptra_day    = 26.0_real64

   call intr%reset_per_day()

   ! Per-day scalars must be zero
   @assertEqual(0.0_real64, intr%tra,          1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqredwet_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqreddry_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqredsol_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iqredfrs_day, 1.0e-12_real64)
   @assertEqual(0.0_real64, intr%iptra_day,    1.0e-12_real64)

   ! Non-per-day scalars must be UNCHANGED (orthogonality)
   @assertEqual( 1.0_real64, intr%iqrot,     1.0e-12_real64)
   @assertEqual( 2.0_real64, intr%iqssdi,    1.0e-12_real64)
   @assertEqual( 3.0_real64, intr%iqredwet,  1.0e-12_real64)
   @assertEqual( 4.0_real64, intr%iqreddry,  1.0e-12_real64)
   @assertEqual( 5.0_real64, intr%iqredsol,  1.0e-12_real64)
   @assertEqual( 6.0_real64, intr%iqredfrs,  1.0e-12_real64)
   @assertEqual( 7.0_real64, intr%ies0,      1.0e-12_real64)
   @assertEqual( 8.0_real64, intr%iet0,      1.0e-12_real64)
   @assertEqual( 9.0_real64, intr%iew0,      1.0e-12_real64)
   @assertEqual(10.0_real64, intr%iintc,     1.0e-12_real64)
   @assertEqual(11.0_real64, intr%iruno,     1.0e-12_real64)
   @assertEqual(12.0_real64, intr%irunoCN,   1.0e-12_real64)
   @assertEqual(13.0_real64, intr%irunon,    1.0e-12_real64)
   @assertEqual(14.0_real64, intr%iqbot,     1.0e-12_real64)
   @assertEqual(15.0_real64, intr%iqtdo,     1.0e-12_real64)
   @assertEqual(16.0_real64, intr%iqtup,     1.0e-12_real64)
   @assertEqual(17.0_real64, intr%IPondBeg,  1.0e-12_real64)
   @assertEqual(18.0_real64, intr%iprec,     1.0e-12_real64)
   @assertEqual(19.0_real64, intr%igird,     1.0e-12_real64)
   @assertEqual(20.0_real64, intr%inird,     1.0e-12_real64)
end subroutine test_swcore_intr_reset_per_day_orthogonality

@test
subroutine test_swcore_intr_reset_with_allocated_arrays()
   ! intr%reset() zeroes allocated non-per-day arrays (allocated() guard works).
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_intermediate_t
   type(soilwater_intermediate_t) :: intr
   integer, parameter :: n = 4

   ! Allocate and seed non-per-day arrays
   allocate(intr%inq(n));       intr%inq       = 5.0_real64
   allocate(intr%inqrot(n));    intr%inqrot    = 5.0_real64
   allocate(intr%inqssdi(n));   intr%inqssdi   = 5.0_real64
   allocate(intr%iqdo(n));      intr%iqdo      = 5.0_real64
   allocate(intr%iqup(n));      intr%iqup      = 5.0_real64
   allocate(intr%IThetaBeg(n)); intr%IThetaBeg = 5.0_real64

   call intr%reset()

   @assertEqual(0.0_real64, maxval(abs(intr%inq)),       1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(intr%inqrot)),    1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(intr%inqssdi)),   1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(intr%iqdo)),      1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(intr%iqup)),      1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(intr%IThetaBeg)), 1.0e-12_real64)
end subroutine test_swcore_intr_reset_with_allocated_arrays

@test
subroutine test_swcore_intr_reset_per_day_arrays_allocated()
   ! reset_per_day() zeroes allocated per-day arrays when they exist.
   use funit
   use iso_fortran_env, only: real64
   use soilwater_state_mod, only: soilwater_intermediate_t
   type(soilwater_intermediate_t) :: intr
   integer, parameter :: n = 5

   allocate(intr%qpotrot_day(n)); intr%qpotrot_day = 7.0_real64
   allocate(intr%qredtot_day(n)); intr%qredtot_day = 8.0_real64

   call intr%reset_per_day()

   @assertEqual(0.0_real64, maxval(abs(intr%qpotrot_day)), 1.0e-12_real64)
   @assertEqual(0.0_real64, maxval(abs(intr%qredtot_day)), 1.0e-12_real64)
end subroutine test_swcore_intr_reset_per_day_arrays_allocated

