! Unit tests for ttutil library utility functions
module test_ttutil
    use funit
    implicit none

contains

    ! ========================================
    ! Tests for LINT() - linear interpolation
    ! ========================================
    
    @test
    subroutine test_lint_basic_interpolation()
        ! Test basic linear interpolation in LINT function
        real :: table(6)
        real :: result
        real, external :: LINT
        
        ! Setup: x values at odd indices, y at even
        table(1) = 0.0
        table(2) = 0.0
        table(3) = 10.0
        table(4) = 100.0
        table(5) = 20.0
        table(6) = 200.0
        
        ! Interpolate at x=5
        result = LINT(table, 6, 5.0)
        @assertEqual(50.0, result, tolerance=1.0e-5)
    end subroutine

    @test
    subroutine test_lint_exact_values()
        ! Test LINT at exact table points
        real :: table(4)
        real :: result
        real, external :: LINT
        
        table(1) = 1.0
        table(2) = 10.0
        table(3) = 5.0
        table(4) = 50.0
        
        result = LINT(table, 4, 1.0)
        @assertEqual(10.0, result, tolerance=1.0e-5)
        
        result = LINT(table, 4, 5.0)
        @assertEqual(50.0, result, tolerance=1.0e-5)
    end subroutine

    ! ========================================
    ! Tests for NOTNUL() - return non-zero value
    ! ========================================
    
    @test
    subroutine test_notnul_nonzero()
        ! Test NOTNUL returns the value when non-zero
        real :: result
        real, external :: NOTNUL
        
        result = NOTNUL(5.0)
        @assertEqual(5.0, result, tolerance=1.0e-7)
        
        result = NOTNUL(-3.14)
        @assertEqual(-3.14, result, tolerance=1.0e-5)
        
        result = NOTNUL(0.001)
        @assertEqual(0.001, result, tolerance=1.0e-7)
    end subroutine

    @test
    subroutine test_notnul_zero()
        ! Test NOTNUL returns 1.0 when value is zero
        real :: result
        real, external :: NOTNUL
        
        result = NOTNUL(0.0)
        @assertEqual(1.0, result, tolerance=1.0e-7)
    end subroutine

    ! ========================================
    ! Tests for REANOR() - logical NOR operation
    ! ========================================
    
    @test
    subroutine test_reanor_both_negative()
        ! Test REANOR returns 1.0 when both arguments are negative or zero
        real :: result
        real, external :: REANOR
        
        result = REANOR(-1.0, -2.0)
        @assertEqual(1.0, result, tolerance=1.0e-7)
        
        result = REANOR(0.0, 0.0)
        @assertEqual(1.0, result, tolerance=1.0e-7)
        
        result = REANOR(-5.5, 0.0)
        @assertEqual(1.0, result, tolerance=1.0e-7)
    end subroutine

    @test
    subroutine test_reanor_at_least_one_positive()
        ! Test REANOR returns 0.0 when at least one argument is positive
        real :: result
        real, external :: REANOR
        
        result = REANOR(1.0, -2.0)
        @assertEqual(0.0, result, tolerance=1.0e-7)
        
        result = REANOR(-1.0, 2.0)
        @assertEqual(0.0, result, tolerance=1.0e-7)
        
        result = REANOR(1.0, 2.0)
        @assertEqual(0.0, result, tolerance=1.0e-7)
        
        result = REANOR(0.1, 0.0)
        @assertEqual(0.0, result, tolerance=1.0e-7)
    end subroutine

    ! ========================================
    ! Tests for REAAND() - logical AND operation
    ! ========================================
    
    @test
    subroutine test_reaand_both_positive()
        ! Test REAAND returns 1.0 when both arguments are positive
        real :: result
        real, external :: REAAND
        
        result = REAAND(1.0, 2.0)
        @assertEqual(1.0, result, tolerance=1.0e-7)
        
        result = REAAND(0.001, 100.0)
        @assertEqual(1.0, result, tolerance=1.0e-7)
        
        result = REAAND(3.14, 2.718)
        @assertEqual(1.0, result, tolerance=1.0e-7)
    end subroutine

    @test
    subroutine test_reaand_at_least_one_nonpositive()
        ! Test REAAND returns 0.0 when at least one argument is not positive
        real :: result
        real, external :: REAAND
        
        result = REAAND(0.0, 1.0)
        @assertEqual(0.0, result, tolerance=1.0e-7)
        
        result = REAAND(1.0, 0.0)
        @assertEqual(0.0, result, tolerance=1.0e-7)
        
        result = REAAND(-1.0, 2.0)
        @assertEqual(0.0, result, tolerance=1.0e-7)
        
        result = REAAND(1.0, -2.0)
        @assertEqual(0.0, result, tolerance=1.0e-7)
        
        result = REAAND(-1.0, -2.0)
        @assertEqual(0.0, result, tolerance=1.0e-7)
    end subroutine

    ! ========================================
    ! Edge cases and combinations
    ! ========================================
    
    @test
    subroutine test_reaand_reanor_complementary()
        ! Test that REAAND and REANOR are complementary for certain inputs
        real :: result_and, result_nor
        real, external :: REAAND, REANOR
        
        ! For negative values, REANOR=1, REAAND=0
        result_and = REAAND(-1.0, -2.0)
        result_nor = REANOR(-1.0, -2.0)
        @assertEqual(0.0, result_and, tolerance=1.0e-7)
        @assertEqual(1.0, result_nor, tolerance=1.0e-7)
        
        ! For positive values, REANOR=0, REAAND=1
        result_and = REAAND(1.0, 2.0)
        result_nor = REANOR(1.0, 2.0)
        @assertEqual(1.0, result_and, tolerance=1.0e-7)
        @assertEqual(0.0, result_nor, tolerance=1.0e-7)
    end subroutine

end module test_ttutil