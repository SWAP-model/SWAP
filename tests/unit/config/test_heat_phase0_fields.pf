@test
subroutine test_heat_config_timref_default_zero()
   use funit
   use iso_fortran_env, only: real64
   use heat_config_mod, only: heat_config_t
   type(heat_config_t) :: cfg
   @assertEqual(0.0_real64, cfg%timref, 1.0e-12_real64)
