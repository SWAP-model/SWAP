@test
subroutine test_surfacewater_crop_rotation_parity()
   use funit
   use variables, only: swCrop
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer :: i, n_rot

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/6.surfacewater')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap()
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/6.surfacewater/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   @assertEqual(swCrop, config%crop%swcrop)

   ! Case 6 has 3 rotation entries (1997-1999), all type 1 (fixed crop).
   n_rot = size(config%crop%rotation_type)
   @assertEqual(3, n_rot)
   do i = 1, n_rot
      @assertEqual(1, config%crop%rotation_type(i))
   end do
end subroutine

! Phase 4c-b Task 14d: parity for the last type-1 (grass.crp) rotation entry of
! case 6.surfacewater. Drive readcropfixed directly via the legacy_crop_helper
! bridge and cross-check `variables` globals against config%crop%rotation_fixed.
!
! case 6 grass.crp switches: SWRD=1, SWOXYGEN=0, SWDROUGHT=1, SWINTER=1.
! Per readcropfixed (readswap.f90 ~2037 onwards):
!   - idev/lcc/kdif/kdir: always read.
!   - hlim1/hlim2u/hlim2l: only read when SWOXYGEN=1 → NOT populated here.
!   - hlim3h/hlim3l/hlim4/adcrh/adcrl: read for SWDROUGHT=1.
!   - rdi/rri/rdc: only read when SWRD=2 → NOT populated here (SWRD=1 reads rdtb).
!   - cofab: read for SWINTER=1.
@test
subroutine test_surfacewater_fixed_data_parity()
   use funit
   use variables, only: &
      idev, kdif, kdir, hlim3h, hlim3l, hlim4, adcrh, adcrl, cofab
   use legacy_crop_helper_mod, only: read_legacy_cropfixed
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd
   integer  :: i, n_rot, last_fixed_idx
   integer, parameter :: ICROP_GRASS = 3

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/6.surfacewater')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap()
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/6.surfacewater/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! Locate the last type-1 entry in the rotation.
   n_rot = size(config%crop%rotation_type)
   last_fixed_idx = 0
   do i = n_rot, 1, -1
      if (config%crop%rotation_type(i) == 1) then
         last_fixed_idx = i
         exit
      end if
   end do
   @assertTrue(last_fixed_idx > 0)

   ! Sanity check: all 3 rotation entries are type 1; last is index 3.
   @assertEqual(ICROP_GRASS, last_fixed_idx)

   ! Drive the legacy readcropfixed from inside the case directory.
   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/6.surfacewater')
   call read_legacy_cropfixed(ICROP_GRASS, 'grass')
   call chdir_to(trim(orig_cwd))

   ! Phenology (lcc is a local in readcropfixed, not exposed via variables;
   ! cross-check the literal LCC=366 from grass.crp).
   @assertEqual(idev, config%crop%rotation_fixed(ICROP_GRASS)%idev)
   @assertEqual(366,  config%crop%rotation_fixed(ICROP_GRASS)%lcc)

   ! Light extinction.
   @assertEqual(kdif, config%crop%rotation_fixed(ICROP_GRASS)%kdif, 1.0e-12_real64)
   @assertEqual(kdir, config%crop%rotation_fixed(ICROP_GRASS)%kdir, 1.0e-12_real64)

   ! READING NOTE: grass.crp has SWOXYGEN=0, so readcropfixed does NOT
   ! read hlim1/hlim2u/hlim2l (readswap.f90 line ~2235 in the swoxygen=1
   ! branch). TOML side defaults to 0 — assert against literal 0.
   @assertEqual(0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%hlim1,  1.0e-12_real64)
   @assertEqual(0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%hlim2u, 1.0e-12_real64)
   @assertEqual(0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%hlim2l, 1.0e-12_real64)

   ! Drought-stress (SWDROUGHT=1 → hlim3h/hlim3l/hlim4/adcrh/adcrl populated).
   @assertEqual(hlim3h, config%crop%rotation_fixed(ICROP_GRASS)%hlim3h, 1.0e-12_real64)
   @assertEqual(hlim3l, config%crop%rotation_fixed(ICROP_GRASS)%hlim3l, 1.0e-12_real64)
   @assertEqual(hlim4,  config%crop%rotation_fixed(ICROP_GRASS)%hlim4,  1.0e-12_real64)
   @assertEqual(adcrh,  config%crop%rotation_fixed(ICROP_GRASS)%adcrh,  1.0e-12_real64)
   @assertEqual(adcrl,  config%crop%rotation_fixed(ICROP_GRASS)%adcrl,  1.0e-12_real64)

   ! READING NOTE: grass.crp has SWRD=1, so readcropfixed reads the rdtb
   ! table (not rdi/rri/rdc scalars; readswap.f90 lines 2177-2181). The
   ! legacy globals stay at 0 even though the .crp declares RDI/RDC=30
   ! and RRI=0. TOML side stores the values verbatim — assert literals.
   @assertEqual(30.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%rdi, 1.0e-12_real64)
   @assertEqual( 0.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%rri, 1.0e-12_real64)
   @assertEqual(30.0_real64, config%crop%rotation_fixed(ICROP_GRASS)%rdc, 1.0e-12_real64)

   ! Interception (SWINTER=1 → cofab populated).
   @assertEqual(cofab, config%crop%rotation_fixed(ICROP_GRASS)%cofab, 1.0e-12_real64)
end subroutine

! Phase 4d Task 20d: parity for the four new sections — bottom_boundary,
! heat, irrigation, solute — added to the case 6 swap.toml in Task 17.
! Case 6 disables heat, irrigation, and solute entirely (all-0 switches).
@test
subroutine test_surfacewater_parity_4d_sections()
   use funit
   use variables, only: swhea, swirfix, swsolu
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   use iso_fortran_env, only: real64
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/6.surfacewater')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap()
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/6.surfacewater/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   @assertFalse(errors%has_fatals())

   ! [bottom_boundary] — case 6 schema-side SWBOTB=1 with bbcfil="swap"
   ! (the SWBBCFILE=1 BBC-file reference branch). Legacy `variables%swbotb`
   ! is populated from the .bbc file itself (case 6: SWBOTB=3 from
   ! swap.bbc), not from the .swp — so the schema int and the legacy
   ! global are semantically different. Assert structure only.
   ! READING NOTE: schema does not yet model the .bbc-file-reference
   ! semantics distinct from inline SWBOTB=1; legacy `variables%swbotb`
   ! cross-check deferred.
   @assertTrue(allocated(config%bottom_boundary%bbcfil))

   ! [heat] — case 6 SWHEA=0 (heat transport disabled).
   @assertEqual(swhea, config%heat%swhea)

   ! [irrigation] — case 6 SWIRFIX=0.
   @assertEqual(swirfix, config%irrigation%swirfix)

   ! [solute] — case 6 SWSOLU=0.
   @assertEqual(swsolu, config%solute%swsolu)
end subroutine
