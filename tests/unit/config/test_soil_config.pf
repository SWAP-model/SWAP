@test
subroutine test_soil_valid_passes()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%swsophy = 0
   s%swhyst  = 0
   s%swinco  = 1
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_soil_swhyst_out_of_enum_fails()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%swhyst = 5
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_swinco_invalid_fails()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%swinco = 0
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_negative_pondmx_fails()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%swinco = 1
   s%pondmx = -0.5d0
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_discretization_swdiscrvert_zero_validates_clean()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   ! All defaults — swdiscrvert=0; validator skips the body.
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_soil_discretization_swdiscrvert_one_minimal_valid()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%discretization%swdiscrvert = 1
   s%discretization%numnodnew   = 3
   allocate(s%discretization%dznew(3))
   s%discretization%dznew = [10.0d0, 10.0d0, 10.0d0]
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_soil_discretization_swdiscrvert_one_dznew_size_mismatch()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%discretization%swdiscrvert = 1
   s%discretization%numnodnew   = 4
   allocate(s%discretization%dznew(3))
   s%discretization%dznew = [10.0d0, 10.0d0, 10.0d0]
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_frost_swfrost_zero_validates_clean()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%frost%swfrost = 0
   ! tfroststa/tfrostend left at defaults; with swfrost=0 they're not bound-checked.
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_soil_frost_swfrost_one_tfrostend_above_tfroststa()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%frost%swfrost   = 1
   s%frost%tfroststa = -1.0d0
   s%frost%tfrostend =  0.0d0   ! end >= start — cross-field violation
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_cofani_out_of_range()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   allocate(s%cofani(2))
   s%cofani = [1.0d0, 1.0d6]   ! 1e6 way above 100 ceiling
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

@test
subroutine test_soil_nrstaring_out_of_range()
   use funit
   use error_mod
   use soil_config_mod
   type(soil_config_t)      :: s
   type(error_collection_t) :: errors
   s%nrstaring = 99   ! must be 0..6
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine
