   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/general_minimal.toml')
   doc_ptr => doc
   call read_solute_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(0, c%swsolu)
   @assertFalse(allocated(c%pertabsolu))
end subroutine

@test
subroutine test_read_solute_malformed_pertabsolu()
   use funit
   use tomlf, only: toml_table, toml_load
   use solute_config_mod
   use read_solute_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(solute_config_t)                 :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/solute_malformed_pertabsolu.toml')
   doc_ptr => doc
   call read_solute_toml(doc_ptr, c, errors)

   @assertTrue(errors%has_errors())
   @assertFalse(allocated(c%pertabsolu))
end subroutine

@test
subroutine test_read_solute_swsolu1_minimal_reader_passes()
   ! Reader is mechanical: it reads every key as optional with defaults.
   ! When swsolu=1 is set but no other payload, the reader still succeeds
   ! and the validator owns the required-ness checks (here all defaults
   ! are within the legacy ranges, so validation also passes — required
   ! fields are not yet flagged as such per spec D4).
   use funit
   use tomlf, only: toml_table, toml_load
   use solute_config_mod
   use read_solute_toml_mod
   use error_mod
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(solute_config_t)                 :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/solute_swsolu1_minimal.toml')
   doc_ptr => doc
   call read_solute_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(1, c%swsolu)
   @assertFalse(allocated(c%pertabsolu))
end subroutine
