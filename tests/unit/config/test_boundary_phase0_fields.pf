! Bottom-boundary config: TOML round-trip + validator tests for the sine
! (swbotb=2), exponential q(h) (swbotb=4/swqhbot=1), and lysimeter-plate
! (swbotb=8) parameter groups promoted into bottom_boundary_config_t.
!
! The per-scalar default-zero tests that once accompanied each group were
! removed 2026-07-05 (they asserted compiler default-initialisation only).
!
! Spec: docs/superpowers/specs/2026-05-10-state-migration-boundary-design.md

! -----------------------------------------------------------------------
! sine group (swbotb=2): TOML round-trip — fixture
!     bottom_boundary_swbotb2_sine.toml contains
!     swbotb=2, sw2=1, sinmax=180.0, sinamp=-0.002, sinave=-0.001.
! -----------------------------------------------------------------------

@test
subroutine test_sinmax_sinamp_sinave_toml_read()
   use funit
   use iso_fortran_env, only: real64
   use tomlf, only: toml_table, toml_load
   use bottom_boundary_config_mod, only: bottom_boundary_config_t
   use read_bottom_boundary_toml_mod, only: read_bottom_boundary_toml
   use error_mod, only: error_collection_t
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(bottom_boundary_config_t)        :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/bottom_boundary_swbotb2_sine.toml')
   doc_ptr => doc
   call read_bottom_boundary_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(2,        c%swbotb)
   @assertEqual(1,        c%sw2)
   @assertEqual(180.0_real64, c%sinmax, 1.0e-12_real64)
   @assertEqual(-0.002_real64, c%sinamp, 1.0e-12_real64)
   @assertEqual(-0.001_real64, c%sinave, 1.0e-12_real64)
end subroutine

! -----------------------------------------------------------------------
! (c) Validator accepts swbotb=2, sw2=1 with in-range sine parameters.
! -----------------------------------------------------------------------

@test
subroutine test_swbotb2_sw2_1_sine_valid_passes()
   use funit
   use iso_fortran_env, only: real64
   use error_mod, only: error_collection_t
   use bottom_boundary_config_mod, only: bottom_boundary_config_t
   type(bottom_boundary_config_t) :: c
   type(error_collection_t)       :: errors

   c%swbotb = 2
   c%sw2    = 1
   c%sinmax = 91.0_real64
   c%sinamp = -0.003_real64
   c%sinave = -0.001_real64
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

! -----------------------------------------------------------------------
! (d) Validator rejects sinmax out of range (> 366).
! -----------------------------------------------------------------------

@test
subroutine test_swbotb2_sw2_1_sinmax_out_of_range_fails()
   use funit
   use iso_fortran_env, only: real64
   use error_mod, only: error_collection_t, ERR_VALIDATION_OUT_OF_RANGE
   use bottom_boundary_config_mod, only: bottom_boundary_config_t
   type(bottom_boundary_config_t) :: c
   type(error_collection_t)       :: errors

   c%swbotb = 2
   c%sw2    = 1
   c%sinmax = 400.0_real64   ! out of [0, 366]
   c%sinamp = -0.003_real64
   c%sinave = -0.001_real64
   call c%validate(errors)
   @assertTrue(errors%has_errors())
   @assertEqual(ERR_VALIDATION_OUT_OF_RANGE, errors%items(1)%code)
end subroutine

! =======================================================================
! exponential q(h) group: cofqha / cofqhb / cofqhc / swcofqhc
! swbotb=4 .and. swqhbot=1 path
! =======================================================================

! -----------------------------------------------------------------------
! TOML round-trip — fixture bottom_boundary_swbotb4_cofqh.toml:
!     swbotb=4, swqhbot=1, cofqha=0.005, cofqhb=-0.15, cofqhc=-0.0001,
!     swcofqhc=1.
! -----------------------------------------------------------------------

@test
subroutine test_cofqha_cofqhb_cofqhc_swcofqhc_toml_read()
   use funit
   use iso_fortran_env, only: real64
   use tomlf, only: toml_table, toml_load
   use bottom_boundary_config_mod, only: bottom_boundary_config_t
   use read_bottom_boundary_toml_mod, only: read_bottom_boundary_toml
   use error_mod, only: error_collection_t
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(bottom_boundary_config_t)        :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/bottom_boundary_swbotb4_cofqh.toml')
   doc_ptr => doc
   call read_bottom_boundary_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(4,             c%swbotb)
   @assertEqual(1,             c%swqhbot)
   @assertEqual(0.005_real64,  c%cofqha,   1.0e-12_real64)
   @assertEqual(-0.15_real64,  c%cofqhb,   1.0e-12_real64)
   @assertEqual(-0.0001_real64, c%cofqhc,  1.0e-12_real64)
   @assertEqual(1,             c%swcofqhc)
end subroutine

! -----------------------------------------------------------------------
! (c) Validator accepts swbotb=4, swqhbot=1 with valid coefficients.
! -----------------------------------------------------------------------

@test
subroutine test_swbotb4_swqhbot1_cofqh_valid_passes()
   use funit
   use iso_fortran_env, only: real64
   use error_mod, only: error_collection_t
   use bottom_boundary_config_mod, only: bottom_boundary_config_t
   type(bottom_boundary_config_t) :: c
   type(error_collection_t)       :: errors

   c%swbotb   = 4
   c%swqhbot  = 1
   c%cofqha   = 0.005_real64
   c%cofqhb   = -0.15_real64
   c%cofqhc   = -0.0001_real64
   c%swcofqhc = 1
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

! -----------------------------------------------------------------------
! (d) Validator rejects swcofqhc with invalid value (not 0 or 1).
! -----------------------------------------------------------------------

@test
subroutine test_swbotb4_swqhbot1_swcofqhc_invalid_fails()
   use funit
   use iso_fortran_env, only: real64
   use error_mod, only: error_collection_t, ERR_VALIDATION_ENUM
   use bottom_boundary_config_mod, only: bottom_boundary_config_t
   type(bottom_boundary_config_t) :: c
   type(error_collection_t)       :: errors

   c%swbotb   = 4
   c%swqhbot  = 1
   c%cofqha   = 0.005_real64
   c%cofqhb   = -0.15_real64
   c%cofqhc   = -0.0001_real64
   c%swcofqhc = 99   ! invalid — not 0 or 1
   call c%validate(errors)
   @assertTrue(errors%has_errors())
   @assertEqual(ERR_VALIDATION_ENUM, errors%items(1)%code)
end subroutine

! =======================================================================
! lysimeter-plate group: hplate — swbotb=8 plate pressure head.
! Negative values are physically valid (pressure head below atmospheric).
! =======================================================================

! -----------------------------------------------------------------------
! TOML round-trip — fixture bottom_boundary_swbotb8_lysimeter.toml:
!     swbotb=8, hplate=-100.0
! -----------------------------------------------------------------------

@test
subroutine test_hplate_toml_read()
   use funit
   use iso_fortran_env, only: real64
   use tomlf, only: toml_table, toml_load
   use bottom_boundary_config_mod, only: bottom_boundary_config_t
   use read_bottom_boundary_toml_mod, only: read_bottom_boundary_toml
   use error_mod, only: error_collection_t
   type(toml_table), allocatable, target :: doc
   type(toml_table), pointer             :: doc_ptr
   type(bottom_boundary_config_t)        :: c
   type(error_collection_t)              :: errors

   call toml_load(doc, 'tests/unit/io/toml/fixtures/bottom_boundary_swbotb8_lysimeter.toml')
   doc_ptr => doc
   call read_bottom_boundary_toml(doc_ptr, c, errors)

   @assertFalse(errors%has_errors())
   @assertEqual(8,            c%swbotb)
   @assertEqual(-100.0_real64, c%hplate, 1.0e-12_real64)
end subroutine

! -----------------------------------------------------------------------
! (c) Validator accepts swbotb=8 with a typical negative hplate value.
!     Physical range: hplate is a pressure head in cm; -1e6 to 0 covers
!     the typical pF range; positive values up to ~1e3 cover lysimeter
!     setups with elevated water tables.
! -----------------------------------------------------------------------

@test
subroutine test_swbotb8_hplate_valid_passes()
   use funit
   use iso_fortran_env, only: real64
   use error_mod, only: error_collection_t
   use bottom_boundary_config_mod, only: bottom_boundary_config_t
   type(bottom_boundary_config_t) :: c
   type(error_collection_t)       :: errors

   c%swbotb = 8
   c%hplate = -100.0_real64   ! typical suction below ceramic plate
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine
