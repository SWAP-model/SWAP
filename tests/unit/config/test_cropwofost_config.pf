@test
subroutine test_wofost_partitioning_bad_ncols_fails()
   use funit
   use error_mod
   use cropwofost_config_mod
   type(wofost_partitioning_t) :: s
   type(error_collection_t)    :: errors
   allocate(s%frtb(3, 3))   ! wrong ncols
   s%frtb = 0.0d0
   s%frtb(1, 1) = 0.0d0
   s%frtb(2, 1) = 1.0d0
   s%frtb(3, 1) = 2.0d0
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

