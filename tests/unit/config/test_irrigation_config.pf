@test
subroutine test_sched_schedule_zero_sentinel_skips()
   use funit
   use error_mod
   use irrigation_config_mod
   type(irrigation_schedule_t) :: s
   type(error_collection_t)    :: errors
   s%schedule = 0
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_sched_happy_path_tcs1_dcs1()
   use funit
   use error_mod
   use iso_fortran_env, only: real64
   use irrigation_config_mod
   type(irrigation_schedule_t) :: s
   type(error_collection_t)    :: errors
   s%schedule       = 1
   s%startirr_day   = 30
   s%startirr_month = 3
   s%endirr_day     = 31
   s%endirr_month   = 12
   s%cirrs          = 0.0_real64
   s%isuas          = 1
   s%tcs            = 1
   s%dcs            = 1
   s%phfieldcapacity = -100.0_real64
   s%raithreshold   = 10.0_real64
   allocate(s%trel_table(2, 2))
   s%trel_table(1, :) = [0.0_real64, 0.95_real64]
   s%trel_table(2, :) = [2.0_real64, 0.95_real64]
   allocate(s%di_table(2, 2))
   s%di_table(1, :) = [0.0_real64, 10.0_real64]
   s%di_table(2, :) = [2.0_real64, 10.0_real64]
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

