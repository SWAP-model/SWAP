@test
subroutine test_surfacewater_drainage_parity()
   use funit
   use variables, only: dramet, swdivd, swdislay
   use swap_config_mod
   use load_swap_config_mod
   use chdir_helper_mod
   use parity_helpers_mod
   use error_mod
   type(swap_config_t)      :: config
   type(error_collection_t) :: errors
   character(len=1024)      :: orig_cwd

   call get_cwd(orig_cwd)
   call chdir_to('tests/swap-cases/6.surfacewater')
   call stage_swp_template('swap_linux.swp.template', 'swap')
   call reset_for_next_readswap()
   call readswap()
   close(logf)
   call chdir_to(trim(orig_cwd))

   call load_swap_config('tests/swap-cases/toml/6.surfacewater/swap.toml', config, errors)
   call config%validate(errors)
   call config%finalize(errors)

   ! swdra=2: rddre() does NOT read dramet; stays at Fortran default 0.
   @assertEqual(dramet,   config%drain%dramet)
   ! rddre() reads swdivd=1 and swdislay=0 from swap.dra.
   @assertEqual(swdivd,   config%drain%swdivd)
   @assertEqual(swdislay, config%drain%swdislay)
   ! nrlevs DROPPED: variables%nrlevs=2 (nrsrf from rddre/swap.dra) vs
   !   config%drain%nrlevs=1 (finalize clamps dramet=0 /= 3 to 1).
   !   Different semantics across the two read paths for swdra=2.
end subroutine

