! Phase 4c-b Task 2: per-sub-type validator coverage for cropwofost_config_t.

@test
subroutine test_wofost_preparation_defaults_pass()
   use funit
   use error_mod
   use cropwofost_config_mod
   type(wofost_preparation_t) :: s
   type(error_collection_t)   :: errors
   call s%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

@test
subroutine test_wofost_preparation_swprep1_invalid_zprep_fails()
   use funit
   use error_mod
   use cropwofost_config_mod
   type(wofost_preparation_t) :: s
   type(error_collection_t)   :: errors
   s%swprep       = 1
   s%zprep        = 50.0d0
   s%hprep        = -10.0d0
   s%maxprepdelay = 30
   call s%validate(errors)
   @assertTrue(errors%has_errors())
end subroutine

