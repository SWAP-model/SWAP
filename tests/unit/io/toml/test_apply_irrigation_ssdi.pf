@test
subroutine test_irrigation_ssdi_default_init()
   use irrigation_config_mod, only: irrigation_config_t
   use funit
   implicit none
   type(irrigation_config_t) :: cfg

   ! Default-init values for the new ssdi sub-type.
   call assertEqual(0, cfg%ssdi%schedule, 'schedule default')
   @assertEqual(0.0d0, cfg%ssdi%ssdi_z(1), tolerance=1.0d-12)
   @assertEqual(0.0d0, cfg%ssdi%ssdi_z(2), tolerance=1.0d-12)
   @assertFalse(allocated(cfg%ssdi%fixed%events_file), 'events_file not allocated by default')
   call assertEqual(0, cfg%ssdi%scheduled%sched_type, 'sched_type default')
   call assertEqual(1, cfg%ssdi%scheduled%days_interval, 'days_interval default')
end subroutine

! Helper: build a minimal mesh state for ssdi_z resolution tests.
! 4-node grid with zbotcp: -10, -25, -40, -60 cm.
subroutine build_test_mesh(state)
   use swap_state_mod, only: swap_state_t
   use, intrinsic :: iso_fortran_env, only: real64
   type(swap_state_t), intent(inout) :: state
   integer,      parameter :: nn = 4
   real(real64), parameter :: dz_v(nn) = [10.d0, 15.d0, 15.d0, 20.d0]
   real(real64) :: z_v(nn), disnod_v(nn+1), ztopcp_v(nn), zbotcp_v(nn)
   integer :: layer_v(nn), i
   ! Build z from dz
   z_v(1) = -0.5d0 * dz_v(1)
   do i = 2, nn
      z_v(i) = z_v(i-1) - 0.5d0*(dz_v(i-1)+dz_v(i))
   end do
   disnod_v(1) = -z_v(1)
   do i = 2, nn
      disnod_v(i) = z_v(i-1) - z_v(i)
   end do
   disnod_v(nn+1) = 0.5d0*dz_v(nn)
   ztopcp_v(1) = 0.d0
   zbotcp_v(1) = -dz_v(1)
   do i = 2, nn
      ztopcp_v(i) = zbotcp_v(i-1)
      zbotcp_v(i) = zbotcp_v(i-1) - dz_v(i)
   end do
   layer_v = 1
   call state%mesh%init(nn, dz_v, z_v, disnod_v, ztopcp_v, zbotcp_v, layer_v)
end subroutine

@test
subroutine test_apply_mode0_populates_globals_from_csv()
   use irrigation_config_mod, only: irrigation_ssdi_t
   use crop_irrigation_state_mod, only: apply_ssdi_seed
   ! [GR-SEED 2026-05-25 Task 5] apply_irrigation_ssdi moved to crop_irrigation_state_mod
   ! as apply_ssdi_seed (public test seam). State written to self (crop_irrigation_state_t).
   use swap_state_mod, only: swap_state_t
   use, intrinsic :: iso_fortran_env, only: real64
   use funit
   implicit none
   type(irrigation_ssdi_t) :: ssdi
   type(swap_state_t) :: state
   integer :: dy_apr15
   real(real64) :: tstart_val, tend_val

   ! Minimal grid for ssdi_z resolution via state%mesh.
   call build_test_mesh(state)

   ! Simulation window covers the fixture dates (2003-04-15 .. 2003-06-10).
   tstart_val = 37621.0_real64   ! 2003-01-01 (days since 1900)
   tend_val   = 37985.0_real64   ! 2003-12-31

   ssdi%schedule = 0
   ssdi%ssdi_z   = [-25.0d0, -40.0d0]
   allocate(character(len=20) :: ssdi%fixed%events_file)
   ssdi%fixed%events_file = 'ssdi_events_small.csv'

   call apply_ssdi_seed(state%crop%irrigation, ssdi, tstart_val, tend_val, state%mesh, 'tests/unit/io/toml/fixtures/')

   ! nod_ssdi(1) should point to the node whose zbotcp <= -25 (node 2)
   ! nod_ssdi(2) should point to the node whose zbotcp <= -40 (node 3)
   @assertEqual(2, state%crop%irrigation%nod_ssdi(1))
   @assertEqual(3, state%crop%irrigation%nod_ssdi(2))

   ! Three rows in fixture → nirri starts at 1
   @assertEqual(1, state%crop%irrigation%nirri)

   ! 2003-04-15 = 37725 days since 1900-01-01 (1-based: day 1 = 1900-01-01)
   dy_apr15 = 37725
   @assertEqual(real(dy_apr15, real64), state%crop%irrigation%ssdi_date(1), tolerance=1.0d-6)

   ! Unit conversion: rate_f mm/h -> cm/d  (5 * 0.1 * 24 = 12.0)
   @assertEqual(12.0_real64, state%crop%irrigation%ssdi_rate_f(1), tolerance=1.0d-9)

   ! Unit conversion + spread: amount_f mm -> cm, then divided by ncomp
   ! ssdi_z = [-25, -40] -> nod_ssdi(1)=2, nod_ssdi(2)=3 (2 nodes); 10mm -> 1.0cm / 2 = 0.5
   @assertEqual(0.5_real64, state%crop%irrigation%ssdi_amount_f(1), tolerance=1.0d-9)
end subroutine test_apply_mode0_populates_globals_from_csv

@test
subroutine test_apply_mode1_copies_scheduled_block()
   use irrigation_config_mod, only: irrigation_ssdi_t
   use crop_irrigation_state_mod, only: apply_ssdi_seed
   ! [GR-SEED 2026-05-25 Task 5] apply_irrigation_ssdi moved to crop_irrigation_state_mod
   ! as apply_ssdi_seed (public test seam). State written to self (crop_irrigation_state_t).
   use swap_state_mod, only: swap_state_t
   use, intrinsic :: iso_fortran_env, only: real64
   use funit
   implicit none
   type(irrigation_ssdi_t) :: ssdi
   type(swap_state_t) :: state
   real(real64) :: tstart_val, tend_val

   ! Minimal grid for ssdi_z resolution via state%mesh.
   call build_test_mesh(state)

   ! [SS-BMI2 Task 5] tstart, tend passed as arguments (not bare globals)
   tstart_val = 37621.0_real64
   tend_val   = 37985.0_real64

   ssdi%schedule = 1
   ssdi%ssdi_z   = [-25.0d0, -40.0d0]
   ssdi%scheduled%sched_type    = 1
   ssdi%scheduled%threshold     = 0.7d0
   ssdi%scheduled%ssdi_amount   = 10.0d0
   ssdi%scheduled%ssdi_appl_rate = 5.0d0
   ssdi%scheduled%sw_interval   = 0
   ssdi%scheduled%days_interval = 1

   call apply_ssdi_seed(state%crop%irrigation, ssdi, tstart_val, tend_val, state%mesh, 'tests/unit/io/toml/fixtures/')

   @assertEqual(2, state%crop%irrigation%nod_ssdi(1))
   @assertEqual(3, state%crop%irrigation%nod_ssdi(2))

   @assertEqual(1,     state%crop%irrigation%ssdi_sched_type)
   @assertEqual(0.7d0, state%crop%irrigation%ssdi_threshold,  tolerance=1.0d-12)

   ! mm -> cm, then spread over (nod_ssdi(2)-nod_ssdi(1)+1) = 2 compartments
   ! 10mm -> 1.0cm / 2 = 0.5
   @assertEqual(0.5d0, state%crop%irrigation%ssdi_amount,     tolerance=1.0d-9)

   ! mm/h -> cm/d: 5 * 0.1 * 24 = 12.0
   @assertEqual(12.0d0, state%crop%irrigation%ssdi_appl_rate, tolerance=1.0d-9)

   @assertEqual(0,     state%crop%irrigation%sw_interval)

   ! Regression-fix invariant from d8a88d6: dt_SSDI_event default is 1.0
   @assertEqual(1.0d0, state%crop%irrigation%dt_SSDI_event, tolerance=1.0d-12)

   ! nirri entry-point initialised to 1
   @assertEqual(1, state%crop%irrigation%nirri)
end subroutine
