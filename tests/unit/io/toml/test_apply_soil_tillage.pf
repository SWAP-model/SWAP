@test
subroutine test_soil_tillage_default_init()
   use funit
   use soil_config_mod, only: soil_config_t
   type(soil_config_t) :: cfg

   ! Default-init values for the new tillage sub-type.
   call assertEqual(2, cfg%tillage%i_n_model, 'i_n_model default')
   call assertEqual(2, cfg%tillage%iRedist,   'iRedist default')
   @assertFalse(allocated(cfg%tillage%events), 'events not allocated by default')
   @assertFalse(allocated(cfg%tillage%types),  'types not allocated by default')
end subroutine

! Helper: build a minimal 2-node mesh state for tillage z-range checks.
! zbotcp: -50, -100 cm.
subroutine build_tillage_test_mesh(state)
   use swap_state_mod, only: swap_state_t
   use, intrinsic :: iso_fortran_env, only: real64
   type(swap_state_t), intent(inout) :: state
   integer,      parameter :: nn = 2
   real(real64), parameter :: dz_v(nn) = [50.d0, 50.d0]
   real(real64) :: z_v(nn), disnod_v(nn+1), ztopcp_v(nn), zbotcp_v(nn)
   integer :: layer_v(nn), i
   z_v(1) = -0.5d0 * dz_v(1)
   do i = 2, nn
      z_v(i) = z_v(i-1) - 0.5d0*(dz_v(i-1)+dz_v(i))
   end do
   disnod_v(1) = -z_v(1)
   do i = 2, nn
      disnod_v(i) = z_v(i-1) - z_v(i)
   end do
   disnod_v(nn+1) = 0.5d0*dz_v(nn)
   ztopcp_v(1) = 0.d0
   zbotcp_v(1) = -dz_v(1)
   do i = 2, nn
      ztopcp_v(i) = zbotcp_v(i-1)
      zbotcp_v(i) = zbotcp_v(i-1) - dz_v(i)
   end do
   layer_v = 1
   call state%mesh%init(nn, dz_v, z_v, disnod_v, ztopcp_v, zbotcp_v, layer_v)
end subroutine

! [GR-SEED 2026-05-25 Task 9] apply_soil_tillage retired; tests now call
! state%tillage%init(til, tend_val, numlay) directly (type-bound interface).
! numlay=0 is used (Group C arrays unused in these config-seeding tests).

@test
subroutine test_apply_populates_per_event_globals()
   ! [GR-CROP 2026-05-25] till_* legacy globals retired -- read state%tillage.
   ! [GR-SEED 2026-05-25 Task 9] call rewritten to state%tillage%init.
   use soil_config_mod, only: soil_tillage_t, soil_tillage_event_t, soil_tillage_type_t
   use swap_state_mod, only: swap_state_t
   use funit
   use iso_fortran_env, only: real64
   implicit none
   type(soil_tillage_t) :: til
   type(swap_state_t) :: state
   real(real64) :: tend_val

   tend_val = 36898.0d0   ! 2004-12-31

   allocate(til%events(2))
   til%events(1) = soil_tillage_event_t(date='2003-04-15', z=30.0d0, &
                                        intensity=1.0d0, type_id=1)
   til%events(2) = soil_tillage_event_t(date='2004-04-20', z=30.0d0, &
                                        intensity=0.8d0, type_id=1)
   allocate(til%types(1))
   til%types(1) = soil_tillage_type_t(id=1, rho_cons=1500.0d0, &
                                      rho_tillage=1100.0d0, k_R=0.05d0)

   call state%tillage%init(til, tend_val, 0)

   @assertEqual(2, state%tillage%Ntill)
   @assertEqual(30.0d0, state%tillage%Z_tillage(1), tolerance=1.0d-9)
   @assertEqual(1.0d0,  state%tillage%I_tillage(1), tolerance=1.0d-9)
   @assertEqual(1,      state%tillage%Type_Tillage(1))
   ! Sentinel slot: Date_tillage(Ntill+1) = tend_val + 1
   @assertEqual(tend_val + 1.0d0, state%tillage%Date_tillage(state%tillage%Ntill+1), tolerance=1.0d-9)
   @assertEqual(30.0d0, state%tillage%Max_Z_tillage, tolerance=1.0d-9)
end subroutine

@test
subroutine test_apply_populates_per_type_globals()
   ! [GR-CROP 2026-05-25] till_* legacy globals retired -- read state%tillage.
   ! [GR-SEED 2026-05-25 Task 9] call rewritten to state%tillage%init.
   use soil_config_mod, only: soil_tillage_t, soil_tillage_event_t, soil_tillage_type_t
   use swap_state_mod, only: swap_state_t
   use funit
   use iso_fortran_env, only: real64
   implicit none
   type(soil_tillage_t) :: til
   type(swap_state_t) :: state
   real(real64) :: tend_val

   tend_val = 36898.0d0

   allocate(til%events(1))
   til%events(1) = soil_tillage_event_t(date='2003-04-15', z=30.0d0, &
                                        intensity=1.0d0, type_id=1)
   allocate(til%types(1))
   til%types(1) = soil_tillage_type_t(id=1, rho_cons=1500.0d0, &
                                      rho_tillage=1100.0d0, k_R=0.05d0)

   call state%tillage%init(til, tend_val, 0)

   @assertEqual(1, state%tillage%iType_Tillage(1))
   @assertEqual(1500.0d0, state%tillage%TAB_Rho_cons(1),    tolerance=1.0d-9)
   @assertEqual(1100.0d0, state%tillage%TAB_Rho_tillage(1), tolerance=1.0d-9)
   @assertEqual(0.05d0,   state%tillage%TAB_K_R_cons(1),    tolerance=1.0d-9)
end subroutine

@test
subroutine test_apply_iTT1_iTT2_indices_when_two_types()
   ! [GR-CROP 2026-05-25] till_* legacy globals retired -- read state%tillage.
   ! [GR-SEED 2026-05-25 Task 9] call rewritten to state%tillage%init.
   ! Two events: event 1 is type 1, event 2 is type 2.
   ! Two type-table entries: iType_Tillage = [1, 2].
   ! After the iTT1/iTT2 loop: iTT1(1)=1, iTT2(1)=1, iTT1(2)=2, iTT2(2)=2.
   use soil_config_mod, only: soil_tillage_t, soil_tillage_event_t, soil_tillage_type_t
   use swap_state_mod, only: swap_state_t
   use funit
   use iso_fortran_env, only: real64
   implicit none
   type(soil_tillage_t) :: til
   type(swap_state_t) :: state
   real(real64) :: tend_val

   tend_val = 36898.0d0

   allocate(til%events(2))
   til%events(1) = soil_tillage_event_t(date='2003-04-15', z=30.0d0, &
                                        intensity=1.0d0, type_id=1)
   til%events(2) = soil_tillage_event_t(date='2004-04-20', z=30.0d0, &
                                        intensity=0.8d0, type_id=2)
   allocate(til%types(2))
   til%types(1) = soil_tillage_type_t(id=1, rho_cons=1500.0d0, &
                                      rho_tillage=1100.0d0, k_R=0.05d0)
   til%types(2) = soil_tillage_type_t(id=2, rho_cons=1400.0d0, &
                                      rho_tillage=1050.0d0, k_R=0.03d0)

   call state%tillage%init(til, tend_val, 0)

   ! iTT1/iTT2 arrays are size Ntill (=2).
   ! For j=1 (type 1): iType_Tillage(1)=1, so iTT1(1)=1, iTT2(1)=1.
   ! For j=2 (type 2): iType_Tillage(2)=2, so iTT1(2)=2, iTT2(2)=2.
   @assertEqual(1, state%tillage%iTT1(1))
   @assertEqual(1, state%tillage%iTT2(1))
   @assertEqual(2, state%tillage%iTT1(2))
   @assertEqual(2, state%tillage%iTT2(2))
end subroutine

@test
subroutine test_apply_i_n_model_3_allocates_match_arrays()
   ! [GR-CROP 2026-05-25] till_* legacy globals retired -- read state%tillage.
   ! [GR-SEED 2026-05-25 Task 9] call rewritten to state%tillage%init.
   use soil_config_mod, only: soil_tillage_t, soil_tillage_event_t, soil_tillage_type_t
   use swap_state_mod, only: swap_state_t
   use funit
   use iso_fortran_env, only: real64
   implicit none
   type(soil_tillage_t) :: til
   type(swap_state_t) :: state
   real(real64) :: tend_val

   tend_val = 36898.0d0

   til%i_n_model = 3

   allocate(til%events(1))
   til%events(1) = soil_tillage_event_t(date='2003-04-15', z=30.0d0, &
                                        intensity=1.0d0, type_id=1)
   allocate(til%types(1))
   til%types(1) = soil_tillage_type_t(id=1, rho_cons=1500.0d0, &
                                      rho_tillage=1100.0d0, k_R=0.05d0, &
                                      rho_match=1200.0d0, N_match=2.0d0)

   call state%tillage%init(til, tend_val, 0)

   @assertTrue(allocated(state%tillage%TAB_Rho_match), 'TAB_Rho_match allocated for i_n_model=3')
   @assertTrue(allocated(state%tillage%TAB_N_match),   'TAB_N_match allocated for i_n_model=3')
   @assertEqual(1200.0d0, state%tillage%TAB_Rho_match(1), tolerance=1.0d-9)
   @assertEqual(2.0d0,    state%tillage%TAB_N_match(1),   tolerance=1.0d-9)
end subroutine
