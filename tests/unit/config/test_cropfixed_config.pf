@test
subroutine test_cropfixed_default_invalid_idev2_no_lcc_check()
   use funit
   use error_mod
   use cropfixed_config_mod
   type(cropfixed_config_t) :: c
   type(error_collection_t) :: errors
   c%idev = 2
   call c%validate(errors)
   @assertFalse(errors%has_errors())
end subroutine

