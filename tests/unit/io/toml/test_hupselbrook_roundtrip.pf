@test
subroutine test_hupselbrook_roundtrip_scalars()
   use funit
   use swap_config_mod
   use load_swap_config_mod
   use write_swap_config_mod
   use error_mod
   type(swap_config_t)      :: c1, c2
   type(error_collection_t) :: errors
   character(len=*), parameter :: src = 'tests/swap-cases/toml/1.hupselbrook/swap.toml'
   character(len=*), parameter :: tmp = 'builddir/hupselbrook_roundtrip.toml'

   call load_swap_config(src, c1, errors)
   @assertFalse(errors%has_errors(), 'initial load should have no errors')

   call write_swap_config(c1, tmp, errors)
   @assertFalse(errors%has_errors(), 'write should have no errors')

   call load_swap_config(tmp, c2, errors)
   @assertFalse(errors%has_errors(), 'reload should have no errors')

   ! General
   @assertEqual(c1%general%project, c2%general%project)
   @assertEqual(c1%general%swscre,  c2%general%swscre)
   @assertEqual(c1%general%swerror, c2%general%swerror)

   ! Simulation dates (days-since-1900, within 1 day tolerance due to rounding)
   @assertEqual(c1%simulation%tstart, c2%simulation%tstart, 1.0d0)
   @assertEqual(c1%simulation%tend,   c2%simulation%tend,   1.0d0)
   @assertEqual(c1%simulation%nprintday, c2%simulation%nprintday)
   @assertEqual(c1%simulation%swmonth,   c2%simulation%swmonth)

   ! Meteorology
   @assertEqual(c1%meteo%lat,       c2%meteo%lat,       1.0d-12)
   @assertEqual(c1%meteo%alt,       c2%meteo%alt,       1.0d-12)
   @assertEqual(c1%meteo%angstroma, c2%meteo%angstroma, 1.0d-12)
   @assertEqual(c1%meteo%angstromb, c2%meteo%angstromb, 1.0d-12)
   @assertEqual(c1%meteo%swetr,     c2%meteo%swetr)
   @assertEqual(c1%meteo%swdivide,  c2%meteo%swdivide)

   ! Drainage scalars
   @assertEqual(c1%drain%swdra,   c2%drain%swdra)
   @assertEqual(c1%drain%dramet,  c2%drain%dramet)
   @assertEqual(c1%drain%swdivd,  c2%drain%swdivd)
   @assertEqual(c1%drain%basegw,  c2%drain%basegw, 1.0d-12)
   @assertEqual(c1%drain%entres,  c2%drain%entres, 1.0d-12)
   @assertEqual(c1%drain%shape,   c2%drain%shape,  1.0d-12)

   ! Soil
   @assertEqual(c1%soil%swinco,  c2%soil%swinco)
   @assertEqual(c1%soil%swmacro, c2%soil%swmacro)
   @assertEqual(c1%soil%gwli,    c2%soil%gwli,    1.0d-12)
   @assertEqual(c1%soil%pondini, c2%soil%pondini, 1.0d-12)
   @assertEqual(c1%soil%pondmx,  c2%soil%pondmx,  1.0d-12)

   ! Crop scalar only — rotation arrays not emitted (Phase 4b)
   @assertEqual(c1%crop%swcrop, c2%crop%swcrop)

end subroutine
